# ═════════════════════════════════════════════════════════════════════════════
#  HYBRID ASSEMBLY
# ═════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
#  ASSEMBLY  —  UNICYCLER  (hybrid mode)
#
#  Unicycler uses:
#    -1  cleaned + Kraken-filtered short R1
#    -2  cleaned + Kraken-filtered short R2
#    -l  filtered + Kraken-classified long reads
#
#  Mode is set to "normal" by default; change to "bold" if assembly is
#  fragmented or "conservative" if accuracy is critical.
# ─────────────────────────────────────────────────────────────────────────────

rule unicycler:
    """
    Hybrid assembly with Unicycler.
    Short reads anchor accuracy; long reads bridge repeats and close chromosomes.
    Output: assembly.fasta (complete or near-complete circular chromosomes).
    """
    input:
        short_R1   = rules.kraken_extract_short.output.R1,
        short_R2   = rules.kraken_extract_short.output.R2,
        long_reads = rules.kraken_extract_long.output.classified
    output:
        assembly = f"{OUTPUT_DIR}/{{sample}}/unicycler/assembly.fasta",
        gfa      = f"{OUTPUT_DIR}/{{sample}}/unicycler/assembly.gfa"
    params:
        outdir  = f"{OUTPUT_DIR}/{{sample}}/unicycler",
        env_bin = f"{ENVS['unicycler']}/bin",
        mode    = "normal"    # options: conservative | normal | bold
    threads: 16
    log: f"{OUTPUT_DIR}/{{sample}}/logs/unicycler.log"
    shell:
        """
        export PATH={params.env_bin}:$PATH
        mkdir -p {params.outdir} $(dirname {log})

        echo "─────────────────────────────────────────────────" >> {log}
        echo "  Unicycler hybrid assembly — {wildcards.sample}"  >> {log}
        echo "  Mode    : {params.mode}"                         >> {log}
        echo "  Threads : {threads}"                             >> {log}
        echo "─────────────────────────────────────────────────" >> {log}

        unicycler \
            -1 {input.short_R1} \
            -2 {input.short_R2} \
            -l {input.long_reads} \
            --mode   {params.mode} \
            --out    {params.outdir} \
            --threads {threads} &>> {log}

        echo "[unicycler] Contigs: $(grep -c '^>' {output.assembly})" >> {log}
        """


# ═════════════════════════════════════════════════════════════════════════════
#  ASSEMBLY QC
# ═════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
#  QC STEP 1  —  QUAST
# ─────────────────────────────────────────────────────────────────────────────

rule quast:
    """Evaluate Unicycler assembly quality with QUAST."""
    input:
        contigs = rules.unicycler.output.assembly
    output:
        report = f"{OUTPUT_DIR}/{{sample}}/quast/report.html"
    params:
        outdir  = f"{OUTPUT_DIR}/{{sample}}/quast",
        env_bin = f"{ENVS['quast']}/bin"
    threads: 4
    log: f"{OUTPUT_DIR}/{{sample}}/logs/quast.log"
    shell:
        """
        export PATH={params.env_bin}:$PATH
        mkdir -p {params.outdir} $(dirname {log})
        quast \
            --output-dir {params.outdir} \
            --threads    {threads} \
            --circo \
            --min-contig 500 \
            {input.contigs} &> {log}
        """


# ─────────────────────────────────────────────────────────────────────────────
#  QC STEP 2  —  BUSCO
# ─────────────────────────────────────────────────────────────────────────────

rule busco:
    """Assess genome completeness with BUSCO (bacteria_odb12)."""
    input:
        contigs = rules.unicycler.output.assembly
    output:
        summary = f"{OUTPUT_DIR}/{{sample}}/busco/{{sample}}_busco_output/short_summary.txt"
    params:
        outdir  = f"{OUTPUT_DIR}/{{sample}}/busco",
        env_bin = f"{ENVS['busco']}/bin",
        lineage = BUSCO_LINEAGE
    threads: 4
    log: f"{OUTPUT_DIR}/{{sample}}/logs/busco.log"
    shell:
        """
        export PATH={params.env_bin}:$PATH
        mkdir -p {params.outdir} $(dirname {log})
        busco \
            -i {input.contigs} \
            -o {wildcards.sample}_busco_output \
            -m genome \
            -l {params.lineage} \
            --out_path {params.outdir} \
            --offline -f \
            --cpu {threads} &> {log}

        # BUSCO 5+ writes short_summary.specific.<lineage>.<n>.txt
        # NOT short_summary.txt — find and copy to the declared output path
        BUSCO_DIR="{params.outdir}/{wildcards.sample}_busco_output"
        ACTUAL=$(find "$BUSCO_DIR" -maxdepth 1 -name "short_summary*.txt" 2>/dev/null | head -1)
        if [ -n "$ACTUAL" ] && [ "$ACTUAL" != "{output.summary}" ]; then
            cp "$ACTUAL" {output.summary}
        fi
        [ -f {output.summary} ] || touch {output.summary}
        """


# ─────────────────────────────────────────────────────────────────────────────
#  QC STEP 3  —  CHECKM  (v1 — matches short-read pipeline)
# ─────────────────────────────────────────────────────────────────────────────

rule checkm:
    """Estimate completeness and contamination with CheckM (lineage_wf)."""
    input:
        contigs = rules.unicycler.output.assembly
    output:
        summary    = f"{OUTPUT_DIR}/{{sample}}/checkm_output/checkm.txt",
        stats_file = f"{OUTPUT_DIR}/{{sample}}/checkm_output/storage/bin_stats_ext.json"
    params:
        env_path = ENVS["checkm"]
    threads: 4
    log: f"{OUTPUT_DIR}/{{sample}}/logs/checkm.log"
    shell:
        """
        export PATH={params.env_path}/bin:$PATH
        mkdir -p $(dirname {output.summary}) $(dirname {log})
        mkdir -p $(dirname {output.summary})/input
        cp {input.contigs} $(dirname {output.summary})/input/
        checkm lineage_wf -x fasta --threads {threads} \
            $(dirname {output.summary})/input $(dirname {output.summary}) &> {log}
        checkm qa $(dirname {output.summary})/lineage.ms $(dirname {output.summary}) \
            -o 2 -f {output.summary} --tab_table
        """



# ═════════════════════════════════════════════════════════════════════════════
#  ANNOTATION
# ═════════════════════════════════════════════════════════════════════════════

rule prokka:
