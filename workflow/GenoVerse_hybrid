def _find_env_dir(env_names, probe_bin):
    for env_name in env_names:
        p = Path(env_name)
        if (p / "bin" / probe_bin).exists():
            return str(p)

    shared_prefix = Path(os.environ.get("SHARED_CONDA_PREFIX", "/data/genoverse/smk_envs_v4/shared"))
    if shared_prefix.exists():
        for d in sorted(shared_prefix.glob("*")):
            if d.is_dir() and (d / "bin" / probe_bin).exists():
                return str(d)

    return ""

