        mkdir -p {params.outdir} $(dirname {log})
        if [ ! -s {input.fasta_16s} ]; then
            echo "[BLAST 16S] No 16S sequences found — skipping BLAST" | tee {log}
            echo "# No 16S sequences detected by barrnap — BLAST skipped" > {output.blast_out}
        else
            echo "[BLAST 16S] Running BLASTn against SILVA for {wildcards.sample}" | tee {log}
            blastn \
                -query {input.fasta_16s} \
                -db {params.db} \
                -out {output.blast_out} \
                -outfmt "6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore stitle" \
                -num_threads {threads} \
                -max_target_seqs 5 \
                -perc_identity 80 \
                -evalue 1e-10 \
                -task blastn \
                &>> {log}
            if [ ! -s {output.blast_out} ]; then
                echo "# No significant BLAST hits found" > {output.blast_out}
            fi
            echo "[BLAST 16S] Top hits:" | tee -a {log}
            head -5 {output.blast_out} | tee -a {log}
        fi
        """

# ─────────────────────────────────────────────────────────────────────────────
# FASTANI (Fixed escaping)
# ─────────────────────────────────────────────────────────────────────────────
rule fastani:
    input:
        contigs   = rules.unicycler.output.assembly,
        blast_16s = rules.blast_16s.output.blast_out
    output:
        ani_result = f"{OUTPUT_DIR}/{{sample}}/fastani/fastani_results.txt"
    params:
        fastani_env = ENVS["fastani"],
        ncbi_env    = ENVS["ncbi"],
        outdir      = f"{OUTPUT_DIR}/{{sample}}/fastani",
        ref_dir     = f"{OUTPUT_DIR}/{{sample}}/fastani/ref_genomes"
    threads: 4
    log: f"{OUTPUT_DIR}/{{sample}}/logs/fastani.log"
    shell:
        r"""
        mkdir -p {params.outdir} {params.ref_dir} $(dirname {log})

        export PATH={params.fastani_env}/bin:{params.ncbi_env}/bin:$PATH

        echo "[FastANI] Started for sample {wildcards.sample}" > {log}
        echo "[FastANI] fastani_env : {params.fastani_env}"   >> {log}
        echo "[FastANI] ncbi_env    : {params.ncbi_env}"      >> {log}

        FASTANI_BIN="{params.fastani_env}/bin/fastANI"
        [ -x "$FASTANI_BIN" ] || FASTANI_BIN=$(which fastANI 2>/dev/null || true)
        if [ ! -x "$FASTANI_BIN" ]; then
            echo "[FastANI] ERROR: fastANI binary not found in {params.fastani_env}/bin or PATH." >> {log}
            echo "[FastANI] Check: ls {params.fastani_env}/bin/fastANI" >> {log}
            echo "# fastANI not found — skipping" > {output.ani_result}
            exit 0
        fi
        echo "[FastANI] Binary: $FASTANI_BIN" >> {log}

        NGD_BIN="{params.ncbi_env}/bin/ncbi-genome-download"
        [ -x "$NGD_BIN" ] || NGD_BIN=$(which ncbi-genome-download 2>/dev/null || true)
        if [ ! -x "$NGD_BIN" ]; then
            echo "[FastANI] ERROR: ncbi-genome-download not found in {params.ncbi_env}/bin or PATH." >> {log}
            echo "[FastANI] Install: conda install -n ncbi_env -c bioconda ncbi-genome-download" >> {log}
            echo "# ncbi-genome-download not found — FastANI skipped" > {output.ani_result}
            exit 0
        fi
        echo "[FastANI] ncbi-genome-download: $NGD_BIN" >> {log}

        echo "[FastANI] Parsing top BLAST hits from {input.blast_16s}" >> {log}

        # FIX: SILVA stitle (col 13) format is "taxonomy;Genus species strain"
        # Old awk -F';' $NF often returned empty strings or strain info.
        # New approach: sed to strip everything up to last semicolon, then take first two words.
        SPECIES_LIST=$(grep -v '^#' "{input.blast_16s}" | head -5 \
            | awk -F'\t' 'NF>=13 {{print $13}}' \
            | sed 's/.*;//' \
            | sed 's/^ *//; s/ *$//' \
            | awk 'NF>=2 {{print $1" "$2}}' \
            | grep -vE '^ *$|^[Uu]ncultured|^[Uu]nclassified|^[Ee]nvironmental' \
            | sort -u || true)

        echo "[FastANI] Parsed species list:" >> {log}
        echo "$SPECIES_LIST" >> {log}

        if [ -z "$SPECIES_LIST" ]; then
            echo "[FastANI] No species-level BLAST hits — trying genus level." >> {log}
            SPECIES_LIST=$(grep -v '^#' "{input.blast_16s}" | head -5 \
                | awk -F'\t' 'NF>=13 {{print $13}}' \
                | sed 's/.*;//' \
                | sed 's/^ *//; s/ *$//' \
                | awk 'NF>=1 {{print $1}}' \
                | grep -vE '^ *$|^[Uu]ncultured|^[Uu]nclassified|^[Ee]nvironmental' \
                | sort -u || true)
        fi

        if [ -z "$SPECIES_LIST" ]; then
            echo "[FastANI] No BLAST hits — cannot auto-select reference genomes." >> {log}
            echo "# No BLAST hits to drive reference selection — FastANI skipped" > {output.ani_result}
            exit 0
        fi

        echo "[FastANI] Species to download references for:" | tee -a {log}
        echo "$SPECIES_LIST" | tee -a {log}

        while IFS= read -r SPECIES; do
            [ -z "$SPECIES" ] && continue
            SAFE=$(echo "$SPECIES" | tr ' ' '_' | tr -cd 'A-Za-z0-9_-')
            SPECIES_DIR="{params.ref_dir}/$SAFE"

            if [ -d "$SPECIES_DIR" ] && \
               [ "$(find "$SPECIES_DIR" -maxdepth 1 -name '*.fna' 2>/dev/null | wc -l)" -gt 0 ]; then
                echo "[FastANI] Using cached genomes for '$SPECIES'" | tee -a {log}
            else
                mkdir -p "$SPECIES_DIR"
                echo "[FastANI] Downloading genomes for '$SPECIES' ..." | tee -a {log}
                "$NGD_BIN" bacteria \
                    -g "$SPECIES" \
                    -F fasta \
                    -l complete,chromosome,scaffold \
                    -R reference,representative \
                    -o "$SPECIES_DIR" \
                    --flat-output \
                    -r 3 \
                    2>> {log} || \
                    echo "[FastANI] WARNING: download non-zero for '$SPECIES' — continuing" | tee -a {log}
                find "$SPECIES_DIR" -name "*.fna.gz" -exec gunzip -f {{}} \; 2>> {log} || true
                NFNA=$(find "$SPECIES_DIR" -name "*.fna" | wc -l)
                echo "[FastANI] Downloaded $NFNA FASTA file(s) for '$SPECIES'" | tee -a {log}
            fi
        done <<< "$SPECIES_LIST"

        REF_LIST="{params.outdir}/ref_list.txt"
        find {params.ref_dir} -name "*.fna" > "$REF_LIST"

        NREF=$(wc -l < "$REF_LIST")
        if [ "$NREF" -eq 0 ]; then
            echo "[FastANI] No reference FASTAs found after download — FastANI skipped." | tee -a {log}
            echo "# No reference genomes downloaded — FastANI skipped" > {output.ani_result}
            exit 0
        fi
        echo "[FastANI] Total reference genomes for ANI: $NREF" | tee -a {log}

        QUERY_LIST="{params.outdir}/query_list.txt"
        echo "{input.contigs}" > "$QUERY_LIST"

        echo "[FastANI] Running fastANI (query vs $NREF references) ..." | tee -a {log}
        "$FASTANI_BIN" \
            --ql "$QUERY_LIST" \
            --rl "$REF_LIST" \
            -t   {threads} \
            -o   {output.ani_result} >> {log} 2>&1 || true

        if [ -s {output.ani_result} ]; then
            TMP_SORT="{params.outdir}/ani_sorted_tmp.txt"
            echo -e "# FastANI results for {wildcards.sample}" > "$TMP_SORT"
            echo -e "# Columns: query\treference\tANI\tbi-directional_fragments\ttotal_fragments" >> "$TMP_SORT"
            sort -t$'\t' -k3 -nr {output.ani_result} >> "$TMP_SORT"
            mv "$TMP_SORT" {output.ani_result}
            echo "[FastANI] Done. Top 5 results:" | tee -a {log}
            grep -v '^#' {output.ani_result} | head -5 | tee -a {log}
        else
            echo "# No ANI results above threshold" > {output.ani_result}
            echo "[FastANI] No ANI results above threshold." | tee -a {log}
        fi
        """

# ═════════════════════════════════════════════════════════════════════════════
#  FINAL REPORT
# ═════════════════════════════════════════════════════════════════════════════

rule final_report:
    """Compile a human-readable summary report for the sample."""
    input:
        decision    = rules.pipeline_decision.output.log_out,
        nanoplot    = rules.nanoplot.output.stats,
        quast       = rules.quast.output.report,
        busco       = rules.busco.output.summary,
        checkm      = rules.checkm.output.summary,
        fastani     = rules.fastani.output.ani_result,
        prokka      = rules.prokka.output.gff,
        interpro    = rules.interproscan.output.tsv,
        kofamscan   = rules.kofamscan.output.kofamscan_results,
        dbcan       = rules.dbcan.output.overview,
        crispr      = rules.cctyper.output.summary,
        antismash   = rules.antismash.output.antismash_results,
        eggnog      = rules.eggnog_mapper.output.annotations,
        repeatmasker= rules.repeatmasker.output.masked_fasta,
        hadeg       = rules.hadeg.output.done_flag,
        barrnap     = rules.barrnap_16s.output.fasta,
        blast_16s   = rules.blast_16s.output.blast_out
    output:
        report = f"{OUTPUT_DIR}/{{sample}}/final_report.txt"
    log: f"{OUTPUT_DIR}/{{sample}}/logs/final_report.log"
    shell:
        """
        mkdir -p $(dirname {output.report}) $(dirname {log})
        {{
          echo "╔══════════════════════════════════════════════════════════╗"
          echo "║   HYBRID WGS PIPELINE  ·  UNICYCLER  —  FINAL REPORT   ║"
          echo "╠══════════════════════════════════════════════════════════╣"
          echo "  Sample     : {wildcards.sample}"
          echo "  Assembler  : Unicycler (hybrid)"
          echo "  Date       : $(date)"
          echo "╚══════════════════════════════════════════════════════════╝"

          echo ""
          echo "══ LONG-READ DECISION (coverage / read-type / filtering) ══"
          cat {input.decision}

          echo ""
          echo "══ NANOPLOT LONG-READ STATS ══"
          cat {input.nanoplot}

          echo ""
          echo "══ QUAST ASSEMBLY REPORT ══"
          echo "  Full HTML: {input.quast}"

          echo ""
          echo "══ BUSCO COMPLETENESS ══"
          [ -f {input.busco} ]     && cat {input.busco}          || echo "  Not found"

          echo ""
          echo "══ CHECKM QUALITY (first 20 lines) ══"
          [ -f {input.checkm} ]    && head -20 {input.checkm}    || echo "  Not found"

          echo ""
          echo "══ FASTANI SPECIES ID (top 10) ══"
          [ -f {input.fastani} ]   && head -10 {input.fastani}   || echo "  Not found"

          echo ""
          echo "══ CRISPR SUMMARY (top 20 lines) ══"
          [ -f {input.crispr} ]    && head -20 {input.crispr}    || echo "  Not found"

          echo ""
          echo "══ ANTISMASH BGC HITS (top 20 lines) ══"
          [ -f {input.antismash} ] && head -20 {input.antismash} || echo "  Not found"

          echo ""
          echo "══ REPEATMASKER ══"
          [ -f {input.repeatmasker} ] && echo "Masked FASTA created: {input.repeatmasker}" || echo "  Not found"

          echo ""
          echo "══ HADEG (hydrocarbon degradation) ══"
          [ -f {input.hadeg} ] && echo "Completed — see $(dirname {input.hadeg})/" || echo "  Not found"

          echo ""
          echo "══ BARRNAP 16S rRNA ══"
          if [ -s {input.barrnap} ]; then
              echo "Sequences found: $(grep -c '>' {input.barrnap})"
          else
              echo "No 16S rRNA genes detected"
          fi

          echo ""
          echo "══ 16S BLAST identification (SILVA) ══"
          if [ -s {input.blast_16s} ]; then
              echo "qseqid  sseqid  pident  length  evalue  bitscore  taxonomy"
              head -5 {input.blast_16s}
          else
              echo "No BLAST hits or skipped"
          fi

          echo ""
          echo "══ OUTPUT FILE LOCATIONS ══"
          echo "  Unicycler assembly : $(dirname {input.quast})/../unicycler/assembly.fasta"
          echo "  Prokka GFF         : {input.prokka}"
          echo "  InterProScan TSV   : {input.interpro}"
          echo "  KofamScan TSV      : {input.kofamscan}"
          echo "  dbCAN overview     : {input.dbcan}"
          echo "  EggNOG annotations : {input.eggnog}"
          echo "  RepeatMasker       : {input.repeatmasker}"
          echo "  HADEG flag         : {input.hadeg}"
          echo "  Barrnap 16S FASTA  : {input.barrnap}"
          echo "  16S BLAST results  : {input.blast_16s}"
        }} > {output.report} 2> {log}
        """
