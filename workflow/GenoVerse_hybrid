rule eggnog_mapper:
    input:  proteins = rules.prokka.output.faa
    output:
        annotations    = f"{OUTPUT_DIR}/{{sample}}/emapper_results/annotations.emapper.annotations",
        seed_orthologs = f"{OUTPUT_DIR}/{{sample}}/emapper_results/annotations.emapper.seed_orthologs"
    params:
        outdir        = f"{OUTPUT_DIR}/{{sample}}/emapper_results",
        env_path      = ENVS["eggnog"],
        # FIX: eggnog-mapper requires --data_dir pointing to where eggnog.db lives.
        # Without it emapper silently exits finding no database.
        eggnog_data   = f"{ENVS['eggnog']}/lib/python3.10/site-packages/data"
    threads: 8    # FIX: increased from 1
    log: f"{OUTPUT_DIR}/{{sample}}/logs/eggnog_mapper.log"
    shell:
        """
        export PATH={params.env_path}/bin:$PATH
        mkdir -p "{params.outdir}" "$(dirname {log})"

        echo "[EggNOG] Started for {wildcards.sample}" > {log}
        echo "[EggNOG] Input    : {input.proteins}"   >> {log}
        echo "[EggNOG] Outdir   : {params.outdir}"    >> {log}
        echo "[EggNOG] Threads  : {threads}"          >> {log}
        echo "[EggNOG] Data dir : {params.eggnog_data}" >> {log}
        echo "[EggNOG] Sequences: $(grep -c '^>' {input.proteins} 2>/dev/null || echo 0)" >> {log}
        echo "[EggNOG] emapper.py: $(which emapper.py 2>/dev/null || echo NOT FOUND)" >> {log}

        # FIX: Resolve actual eggnog data dir — python version in path may differ.
        EGGNOG_DATA="{params.eggnog_data}"
        if [ ! -f "$EGGNOG_DATA/eggnog.db" ]; then
            echo "[EggNOG] eggnog.db not at $EGGNOG_DATA — searching env..." >> {log}
            FOUND_DB=$(find "{params.env_path}" -name "eggnog.db" 2>/dev/null | head -1 || true)
            if [ -n "$FOUND_DB" ]; then
                EGGNOG_DATA=$(dirname "$FOUND_DB")
                echo "[EggNOG] Found eggnog.db at: $EGGNOG_DATA" >> {log}
            else
                echo "[EggNOG] FATAL: eggnog.db not found under {params.env_path}." >> {log}
                echo "[EggNOG] Run: download_eggnog_data.py --data_dir $EGGNOG_DATA" >> {log}
                exit 1
            fi
        fi
        echo "[EggNOG] Using data dir: $EGGNOG_DATA" >> {log}

        # FIX: removed --dbmem (requires ~40 GB RAM, silently crashes most machines)
        # FIX: added --data_dir so emapper finds eggnog.db
        emapper.py -i {input.proteins} \
            --output_dir {params.outdir} --output annotations \
            --data_dir "$EGGNOG_DATA" \
            --cpu {threads} --query_cover 0.5 -m diamond \
            --seed_ortholog_evalue 0.01 --sensmode fast \
            --tax_scope 2 >> {log} 2>&1

        ESTAT=$?
        echo "[EggNOG] Exit code: $ESTAT" >> {log}

        # Guards: create empty output files if emapper produced nothing
        [ -f {output.annotations}    ] || {{ echo "[EggNOG] No annotations — creating empty" >> {log}; touch {output.annotations};    }}
        [ -f {output.seed_orthologs} ] || {{ echo "[EggNOG] No seed_orthologs — creating empty" >> {log}; touch {output.seed_orthologs}; }}

        echo "[EggNOG] Done." >> {log}
        """


