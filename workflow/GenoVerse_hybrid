rule cctyper:
    """CRISPR-Cas system detection with CRISPRCasTyper (matches short-read pipeline)."""
    input:
        contigs = rules.unicycler.output.assembly
    output:
        summary     = f"{OUTPUT_DIR}/{{sample}}/crispr_output/crispr_summary.txt",
        crispr_cas  = f"{OUTPUT_DIR}/{{sample}}/crispr_output/CRISPR_Cas.tab",
        cas_operons = f"{OUTPUT_DIR}/{{sample}}/crispr_output/cas_operons.tab"
    params:
        outdir   = f"{OUTPUT_DIR}/{{sample}}/crispr_output",
        env_path = ENVS["cctyper"]
    threads: 4
    log: f"{OUTPUT_DIR}/{{sample}}/logs/cctyper.log"
    shell:
        r"""
        # FIX: use export PATH — conda activate is broken in Snakemake shell blocks
        export PATH={params.env_path}/bin:$PATH
        export CCTYPER_DB="{params.env_path}/share/cctyper"

        mkdir -p $(dirname {log})

        echo "[CCTyper] Started for {wildcards.sample}"  > {log}
        echo "[CCTyper] Input   : {input.contigs}"      >> {log}
        echo "[CCTyper] DB      : $CCTYPER_DB"          >> {log}
        echo "[CCTyper] env_path: {params.env_path}"    >> {log}

        # cctyper 1.8.0 refuses to run if outdir already exists — wipe it first
        rm -rf {params.outdir}

        cctyper {input.contigs} {params.outdir} \
            --db "$CCTYPER_DB" \
            --prodigal single \
            --threads {threads} >> {log} 2>&1

        CSTAT=$?
        echo "[CCTyper] Exit code: $CSTAT" >> {log}

        # ── Output fixing ─────────────────────────────────────────────────
        if [ -s "{params.outdir}/CRISPR_Cas.tab" ]; then
            # cp {params.outdir}/CRISPR_Cas.tab {output.crispr_cas}

            if [ -f "{params.outdir}/cas_operons_putative.tab" ]; then
                cp {params.outdir}/cas_operons_putative.tab {output.cas_operons}
            else
                touch {output.cas_operons}
            fi

            echo "CRISPR-Cas systems detected" > {output.summary}
            cat {output.crispr_cas} >> {output.summary}
            echo "[CCTyper] CRISPR-Cas systems found." >> {log}
        else
            echo "No CRISPR-Cas systems detected." > {output.summary}
            touch {output.crispr_cas}
            touch {output.cas_operons}
            echo "[CCTyper] No CRISPR-Cas systems detected." >> {log}
        fi

        echo "[CCTyper] Done." >> {log}
        """


