# ─────────────────────────────────────────────────────────────────────────────
#  SR STEP 0a  —  FASTQC (pre-trimming)
# ─────────────────────────────────────────────────────────────────────────────

rule fastqc_raw:
    """FastQC quality assessment on raw short reads (before trimming)."""
    input:
        R1 = lambda wildcards: get_short_R1(wildcards),
        R2 = lambda wildcards: get_short_R2(wildcards)
    output:
        html_R1 = f"{OUTPUT_DIR}/{{sample}}/fastqc_raw/{{sample}}_R1_fastqc.html",
        html_R2 = f"{OUTPUT_DIR}/{{sample}}/fastqc_raw/{{sample}}_R2_fastqc.html",
        zip_R1  = f"{OUTPUT_DIR}/{{sample}}/fastqc_raw/{{sample}}_R1_fastqc.zip",
        zip_R2  = f"{OUTPUT_DIR}/{{sample}}/fastqc_raw/{{sample}}_R2_fastqc.zip"
    params:
        outdir   = f"{OUTPUT_DIR}/{{sample}}/fastqc_raw",
        env_path = ENVS["fastqc"]
    threads: 2
    log: f"{OUTPUT_DIR}/{{sample}}/logs/fastqc_raw.log"
    shell:
        """
        export PATH={params.env_path}/bin:$PATH
        mkdir -p {params.outdir} $(dirname {log})

        FASTQC_BIN="{params.env_path}/bin/fastqc"
        if [ ! -x "$FASTQC_BIN" ]; then
            FASTQC_BIN=$(which fastqc 2>/dev/null || true)
        fi
        if [ ! -x "$FASTQC_BIN" ]; then
            echo "ERROR: fastqc not found" >&2
            exit 1
        fi

        echo "[FastQC] Using: $FASTQC_BIN" | tee {log}
        "$FASTQC_BIN" -t {threads} -o {params.outdir} {input.R1} {input.R2} &>> {log}
        """


# ─────────────────────────────────────────────────────────────────────────────
#  SR STEP 1  —  TRIMMOMATIC  (adapter + quality trimming)
# ─────────────────────────────────────────────────────────────────────────────

rule trimmomatic:
    """Remove Illumina adapters and low-quality bases with Trimmomatic."""
    input:
        R1 = lambda wildcards: get_short_R1(wildcards),
        R2 = lambda wildcards: get_short_R2(wildcards)
    output:
        paired_R1   = f"{OUTPUT_DIR}/{{sample}}/trimmomatic/{{sample}}_R1_paired.fastq",
        unpaired_R1 = f"{OUTPUT_DIR}/{{sample}}/trimmomatic/{{sample}}_R1_unpaired.fastq",
        paired_R2   = f"{OUTPUT_DIR}/{{sample}}/trimmomatic/{{sample}}_R2_paired.fastq",
        unpaired_R2 = f"{OUTPUT_DIR}/{{sample}}/trimmomatic/{{sample}}_R2_unpaired.fastq"
    params:
        jar         = TRIMMOMATIC_JAR,
        adapters    = ADAPTER_FILE,
        env_bin     = f"{ENVS['marine']}/bin"
    threads: 4
    log: f"{OUTPUT_DIR}/{{sample}}/logs/trimmomatic.log"
    shell:
        """
        export PATH={params.env_bin}:$PATH
        mkdir -p $(dirname {output.paired_R1}) $(dirname {log})
        java -jar {params.jar} PE \
            -phred33 -threads {threads} \
            {input.R1} {input.R2} \
            {output.paired_R1}   {output.unpaired_R1} \
            {output.paired_R2}   {output.unpaired_R2} \
            ILLUMINACLIP:{params.adapters}:2:30:10 \
            LEADING:3 TRAILING:3 SLIDINGWINDOW:4:20 MINLEN:50 &> {log}
        """


# ─────────────────────────────────────────────────────────────────────────────
#  SR STEP 2  —  CUTADAPT  (adapter trimming)
# ─────────────────────────────────────────────────────────────────────────────

rule cutadapt:
    """Further adapter trimming and quality filtering with Cutadapt."""
    input:
        R1 = rules.trimmomatic.output.paired_R1,
        R2 = rules.trimmomatic.output.paired_R2
    output:
        R1 = f"{OUTPUT_DIR}/{{sample}}/cutadapt/{{sample}}_R1_trimmed.fastq",
        R2 = f"{OUTPUT_DIR}/{{sample}}/cutadapt/{{sample}}_R2_trimmed.fastq"
    params:
        env_bin = f"{ENVS['cutadapt']}/bin"
    threads: 4
    log: f"{OUTPUT_DIR}/{{sample}}/logs/cutadapt.log"
    shell:
        """
        export PATH={params.env_bin}:$PATH
        mkdir -p $(dirname {output.R1}) $(dirname {log})
        cutadapt -q 20 \
            -o {output.R1} -p {output.R2} \
            {input.R1} {input.R2} &> {log}
        """


# ─────────────────────────────────────────────────────────────────────────────
#  SR STEP 3  —  SEQTK  (quality trimming)
# ─────────────────────────────────────────────────────────────────────────────

rule seqtk:
    """Quality-trim reads with Seqtk trimfq."""
    input:
        R1 = rules.cutadapt.output.R1,
        R2 = rules.cutadapt.output.R2
    output:
        R1 = f"{OUTPUT_DIR}/{{sample}}/seqtk/{{sample}}_R1_seqtk.fastq",
        R2 = f"{OUTPUT_DIR}/{{sample}}/seqtk/{{sample}}_R2_seqtk.fastq"
    params:
        env_bin = f"{ENVS['marine']}/bin"
    threads: 2
    log: f"{OUTPUT_DIR}/{{sample}}/logs/seqtk.log"
    shell:
        """
        export PATH={params.env_bin}:$PATH
        mkdir -p $(dirname {output.R1}) $(dirname {log})
        seqtk trimfq {input.R1} > {output.R1} 2>  {log}
        seqtk trimfq {input.R2} > {output.R2} 2>> {log}
        """


# ─────────────────────────────────────────────────────────────────────────────
#  SR STEP 4  —  BBDUK  (contaminant / adapter cleaning)
# ─────────────────────────────────────────────────────────────────────────────

rule bbduk:
    """Remove residual adapters and contaminants with BBDuk."""
    input:
        R1 = rules.seqtk.output.R1,
        R2 = rules.seqtk.output.R2
    output:
        R1 = f"{OUTPUT_DIR}/{{sample}}/bbduk/{{sample}}_R1_clean.fastq",
        R2 = f"{OUTPUT_DIR}/{{sample}}/bbduk/{{sample}}_R2_clean.fastq"
    params:
        env_bin = f"{ENVS['marine']}/bin"
    threads: 4
    log: f"{OUTPUT_DIR}/{{sample}}/logs/bbduk.log"
    shell:
        """
        export PATH={params.env_bin}:$PATH
        mkdir -p $(dirname {output.R1}) $(dirname {log})
        bbduk.sh \
            in={input.R1}    in2={input.R2} \
            out={output.R1}  out2={output.R2} \
            ref=adapters ktrim=r k=23 mink=11 hdist=1 tpe tbo &> {log}
        """


# ─────────────────────────────────────────────────────────────────────────────
#  SR STEP 4b  —  FASTQC (post-trimming)
# ─────────────────────────────────────────────────────────────────────────────

rule fastqc_trimmed:
    """FastQC quality assessment on cleaned short reads (after BBDuk)."""
    input:
        R1 = rules.bbduk.output.R1,
        R2 = rules.bbduk.output.R2
    output:
        html_R1 = f"{OUTPUT_DIR}/{{sample}}/fastqc_trimmed/{{sample}}_R1_clean_fastqc.html",
        html_R2 = f"{OUTPUT_DIR}/{{sample}}/fastqc_trimmed/{{sample}}_R2_clean_fastqc.html"
    params:
        outdir   = f"{OUTPUT_DIR}/{{sample}}/fastqc_trimmed",
        env_path = ENVS["fastqc"]
    threads: 2
    log: f"{OUTPUT_DIR}/{{sample}}/logs/fastqc_trimmed.log"
    shell:
        """
        export PATH={params.env_path}/bin:$PATH
        mkdir -p {params.outdir} $(dirname {log})

        FASTQC_BIN="{params.env_path}/bin/fastqc"
        if [ ! -x "$FASTQC_BIN" ]; then
            FASTQC_BIN=$(which fastqc 2>/dev/null || true)
        fi
        if [ ! -x "$FASTQC_BIN" ]; then
            echo "ERROR: fastqc not found" >&2; exit 1
        fi

        "$FASTQC_BIN" -t {threads} -o {params.outdir} {input.R1} {input.R2} &> {log}
        """


# ─────────────────────────────────────────────────────────────────────────────
#  SR STEP 5  —  KRAKEN2  (short-read taxonomic classification)
# ─────────────────────────────────────────────────────────────────────────────

rule kraken_classify_short:
    """Classify short reads with Kraken2 (paired-end mode)."""
    input:
        R1 = rules.bbduk.output.R1,
        R2 = rules.bbduk.output.R2
    output:
        report = f"{OUTPUT_DIR}/{{sample}}/kraken_short/kraken2_report.txt",
        kout   = f"{OUTPUT_DIR}/{{sample}}/kraken_short/kraken2_output.txt"
    params:
        db_path = KRAKEN_DB,
        env_bin = f"{ENVS['kraken2']}/bin"
    threads: 8
    log: f"{OUTPUT_DIR}/{{sample}}/logs/kraken_classify_short.log"
    shell:
        """
        export PATH={params.env_bin}:$PATH
        mkdir -p $(dirname {output.report}) $(dirname {log})
        kraken2 \
            --db      {params.db_path} \
            --threads {threads} \
            --paired  {input.R1} {input.R2} \
            --use-names \
            --report  {output.report} \
            --output  {output.kout} &> {log}
        """


# ─────────────────────────────────────────────────────────────────────────────
#  SR STEP 6  —  EXTRACT BACTERIAL SHORT READS
# ─────────────────────────────────────────────────────────────────────────────

rule kraken_extract_short:
    """Extract bacterial reads from short-read Kraken2 output."""
    input:
        kout = rules.kraken_classify_short.output.kout,
        R1   = rules.bbduk.output.R1,
        R2   = rules.bbduk.output.R2
    output:
        R1 = f"{OUTPUT_DIR}/{{sample}}/kraken_classified/{{sample}}_classified_R1.fastq",
        R2 = f"{OUTPUT_DIR}/{{sample}}/kraken_classified/{{sample}}_classified_R2.fastq"
    params:
        tools_path = KRAKEN_TOOLS,
        env_bin    = f"{ENVS['kraken2']}/bin"
    threads: 4
    log: f"{OUTPUT_DIR}/{{sample}}/logs/kraken_extract_short.log"
    shell:
        """
        export PATH={params.env_bin}:$PATH
        mkdir -p $(dirname {output.R1}) $(dirname {log})
        python {params.tools_path}/extract_kraken_reads.py \
            -k {input.kout} \
            -s  {input.R1} \
            -s2 {input.R2} \
            -o  {output.R1} \
            -o2 {output.R2} \
            --fastq-output -t 0 --exclude &> {log}
        """


# ═════════════════════════════════════════════════════════════════════════════
#  LONG-READ PROCESSING
# ═════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
#  LR STEP 1  —  NANOPLOT  (read QC)
# ─────────────────────────────────────────────────────────────────────────────

rule nanoplot:
    """Run NanoPlot to generate long-read quality statistics and plots."""
    input:
        reads = lambda wildcards: get_long_reads(wildcards)
    output:
        stats = f"{OUTPUT_DIR}/{{sample}}/nanoplot/NanoStats.txt",
        html  = f"{OUTPUT_DIR}/{{sample}}/nanoplot/NanoPlot-report.html"
    params:
        outdir  = f"{OUTPUT_DIR}/{{sample}}/nanoplot",
        env_bin = f"{ENVS['nanoplot']}/bin"
    threads: 4
    log: f"{OUTPUT_DIR}/{{sample}}/logs/nanoplot.log"
    shell:
        """
        export PATH={params.env_bin}:$PATH
        mkdir -p {params.outdir} $(dirname {log})
        NanoPlot \
            --fastq  {input.reads} \
            --outdir {params.outdir} \
            --plots hex dot \
            --N50 --loglength \
            --threads {threads} &> {log}
        """


# ─────────────────────────────────────────────────────────────────────────────
#  LR STEP 2  —  PIPELINE DECISION ENGINE
#
#  Parses NanoStats.txt and computes:
#   A) Read-type auto-detection (ONT vs CLR)
#   B) Coverage  = total_bases / genome_size_bp
#   C) Coverage-tiered Filtlong thresholds
#   D) Optional NanoFilt pre-pass (when mean Q < 7)
#  Writes pipeline_decision.json + decision_summary.txt
# ─────────────────────────────────────────────────────────────────────────────

rule pipeline_decision:
    """Compute all long-read pipeline parameters from NanoStats and write JSON."""
    input:
        stats = rules.nanoplot.output.stats
    output:
        json_out = f"{OUTPUT_DIR}/{{sample}}/decisions/pipeline_decision.json",
        log_out  = f"{OUTPUT_DIR}/{{sample}}/decisions/decision_summary.txt"
    params:
        declared_rt = lambda wildcards: declared_read_type(wildcards),
        genome_size = lambda wildcards: declared_genome_size(wildcards)
    log: f"{OUTPUT_DIR}/{{sample}}/logs/pipeline_decision.log"
    run:
        import json

        # ── Parse NanoStats.txt ──────────────────────────────────────────────
        ns = {}
        with open(input.stats) as fh:
            for line in fh:
                if ":" in line:
                    k, v = line.strip().split(":", 1)
                    k = k.strip().lower().replace(" ", "_")
                    v = v.strip().replace(",", "")
                    try:    ns[k] = float(v)
                    except: ns[k] = v

        mean_q      = float(ns.get("mean_read_quality",  ns.get("mean_quality",   8.0)))
        median_len  = float(ns.get("median_read_length", ns.get("median_length", 5000.0)))
        n50         = float(ns.get("read_n50",           ns.get("n50",          5000.0)))
        total_reads = float(ns.get("number_of_reads",    ns.get("reads",       50000.0)))
        total_bases = float(ns.get("total_bases",        total_reads * median_len))

        gs_str   = params.genome_size
        gs_bp    = genome_size_bp(gs_str)
        coverage = round(total_bases / gs_bp, 1)
        declared = params.declared_rt

        # ── A) Auto-detect read type ─────────────────────────────────────────
        if   mean_q >= 12 and median_len >= 5000: auto_type = "ont_r10"
        elif mean_q >= 10 and median_len >= 4000: auto_type = "ont_r10"
        elif mean_q >= 7  and median_len >= 3000: auto_type = "ont_r9"
        else:                                     auto_type = "pacbio_clr"

        valid_types = {"ont_r9", "ont_r10", "ont_r10_sup", "pacbio_clr"}
        conflict    = ""
        if declared in valid_types:
            if declared == "pacbio_clr" and mean_q > 12:
                conflict   = f"WARNING: Declared 'pacbio_clr' but mean Q={mean_q:.1f} looks like ONT. Auto-overriding to {auto_type}."
                final_type = auto_type
            elif declared in {"ont_r9","ont_r10","ont_r10_sup"} and mean_q < 5:
                conflict   = f"WARNING: Declared ONT but mean Q={mean_q:.1f} is very low. Auto-overriding to pacbio_clr."
                final_type = "pacbio_clr"
            else:
                final_type = declared
        else:
            final_type = auto_type

        is_ont = final_type in {"ont_r9", "ont_r10", "ont_r10_sup"}
        is_clr = final_type == "pacbio_clr"

        # ── B) Coverage tiers → Filtlong parameters ──────────────────────────
        warnings = []
        if coverage < 20:
            filtlong_min_len, filtlong_keep_pct = 500,  99
            coverage_tier = "ultra-light (<20x)"
            warnings.append(f"Very low coverage ({coverage:.1f}x). Ultra-light filtering applied.")
        elif coverage < 50:
            filtlong_min_len, filtlong_keep_pct = 1000, 95
            coverage_tier = "light (<50x)"
        elif coverage <= 150:
            filtlong_min_len, filtlong_keep_pct = 1000, 90
            coverage_tier = "moderate (50–150x)"
        else:
            filtlong_min_len, filtlong_keep_pct = 2000, 80
            coverage_tier = "strict (>150x)"

        if n50 < 2000 and filtlong_min_len > 500:
            filtlong_min_len = 500
            warnings.append(f"Read N50 ({n50:.0f} bp) < 2000. Filtlong min_length relaxed to 500.")
        if total_reads < 5000:
            filtlong_min_len, filtlong_keep_pct = 500, 99
            warnings.append(f"Only {int(total_reads):,} reads. Maximum retention applied.")

        # ── C) NanoFilt pre-pass ─────────────────────────────────────────────
        use_nanofilt = mean_q < 7.0
        if mean_q < 5.5:
            nanofilt_q      = 4
            nanofilt_reason = f"Mean Q ({mean_q:.1f}) < 5.5 — NanoFilt -q 4 applied."
        elif mean_q < 7.0:
            nanofilt_q      = 5
            nanofilt_reason = f"Mean Q ({mean_q:.1f}) < 7.0 — NanoFilt -q 5 applied."
        else:
            nanofilt_q      = 5
            nanofilt_reason = f"Mean Q ({mean_q:.1f}) ≥ 7.0 — NanoFilt not needed."
        nanofilt_len = 500

        # ── Write JSON ───────────────────────────────────────────────────────
        os.makedirs(os.path.dirname(output.json_out), exist_ok=True)
        decision = {
            "sample"            : wildcards.sample,
            "genome_size_str"   : gs_str,
            "genome_size_bp"    : gs_bp,
            "mean_q"            : round(mean_q, 2),
            "median_len"        : int(median_len),
            "n50"               : int(n50),
            "total_reads"       : int(total_reads),
            "total_bases"       : int(total_bases),
            "coverage_x"        : coverage,
            "coverage_tier"     : coverage_tier,
            "declared_type"     : declared,
            "auto_type"         : auto_type,
            "final_type"        : final_type,
            "conflict"          : conflict,
            "is_ont"            : is_ont,
            "is_clr"            : is_clr,
            "use_nanofilt"      : use_nanofilt,
            "nanofilt_q"        : nanofilt_q,
            "nanofilt_len"      : nanofilt_len,
            "nanofilt_reason"   : nanofilt_reason,
            "filtlong_min_len"  : filtlong_min_len,
            "filtlong_keep_pct" : filtlong_keep_pct,
            "warnings"          : warnings,
        }
        with open(output.json_out, "w") as fh:
            json.dump(decision, fh, indent=2)

        # ── Human-readable summary ───────────────────────────────────────────
        sep = "─" * 60
        with open(output.log_out, "w") as fh:
            fh.write(f"{'═'*60}\n  PIPELINE DECISION — {wildcards.sample}\n{'═'*60}\n\n")
            fh.write(f"  Read statistics\n  {sep}\n")
            fh.write(f"    Mean Q        : {mean_q:.2f}\n")
            fh.write(f"    Median length : {int(median_len):,} bp\n")
            fh.write(f"    Read N50      : {int(n50):,} bp\n")
            fh.write(f"    Total reads   : {int(total_reads):,}\n")
            fh.write(f"    Total bases   : {int(total_bases):,}\n\n")
            fh.write(f"  Coverage\n  {sep}\n")
            fh.write(f"    Genome size   : {gs_str}  ({gs_bp:,} bp)\n")
            fh.write(f"    Estimated Cx  : {coverage:.1f}x  [{coverage_tier}]\n\n")
            fh.write(f"  Read type\n  {sep}\n")
            fh.write(f"    Declared      : {declared or '(not specified — auto-detecting)'}\n")
            fh.write(f"    Auto-detected : {auto_type}\n")
            fh.write(f"    FINAL         : {final_type}\n")
            if conflict: fh.write(f"    ⚠  {conflict}\n")
            fh.write(f"\n  Filtering\n  {sep}\n")
            fh.write(f"    NanoFilt      : {'YES — ' if use_nanofilt else 'NO  — '}{nanofilt_reason}\n")
            if use_nanofilt: fh.write(f"      Parameters  : -q {nanofilt_q}  -l {nanofilt_len}\n")
            fh.write(f"    Filtlong      : --min_length {filtlong_min_len}  --keep_percent {filtlong_keep_pct}\n")
            fh.write(f"\n  Assembler\n  {sep}\n")
            fh.write(f"    Unicycler (hybrid): short R1/R2 + long reads\n")
            if warnings:
                fh.write(f"\n  Warnings\n  {sep}\n")
                for w in warnings: fh.write(f"    [WARN] {w}\n")

        with open(log[0], "w") as lf:
            lf.write(f"Decision done. Type: {final_type}  Coverage: {coverage:.1f}x\n")
            if conflict: lf.write(conflict + "\n")
            for w in warnings: lf.write(f"[WARN] {w}\n")


# ─────────────────────────────────────────────────────────────────────────────
#  LR STEP 3  —  ADAPTIVE FILTERING  (NanoFilt + Filtlong)
# ─────────────────────────────────────────────────────────────────────────────

rule adaptive_filter:
    """Filter long reads: optional NanoFilt pre-pass, then Filtlong."""
    input:
        reads    = lambda wildcards: get_long_reads(wildcards),
        dec_json = rules.pipeline_decision.output.json_out
    output:
        filtered = f"{OUTPUT_DIR}/{{sample}}/filtered/{{sample}}_filtered.fastq"
    params:
        nanoplot_bin = f"{ENVS['nanoplot']}/bin",
        filtlong_bin = FILTLONG_BIN
    threads: 2
    log: f"{OUTPUT_DIR}/{{sample}}/logs/adaptive_filter.log"
    shell:
        """
        mkdir -p $(dirname {output.filtered}) $(dirname {log})

        USE_NF=$(python3 -c "import json; d=json.load(open('{input.dec_json}')); print(str(d['use_nanofilt']).lower())")
        NF_Q=$(python3   -c "import json; d=json.load(open('{input.dec_json}')); print(d['nanofilt_q'])")
        NF_L=$(python3   -c "import json; d=json.load(open('{input.dec_json}')); print(d['nanofilt_len'])")
        FL_L=$(python3   -c "import json; d=json.load(open('{input.dec_json}')); print(d['filtlong_min_len'])")
        FL_P=$(python3   -c "import json; d=json.load(open('{input.dec_json}')); print(d['filtlong_keep_pct'])")
        TIER=$(python3   -c "import json; d=json.load(open('{input.dec_json}')); print(d['coverage_tier'])")

        echo "─────────────────────────────────────────────────"  >> {log}
        echo "  Long-read filtering  —  {wildcards.sample}"       >> {log}
        echo "  Coverage tier : $TIER"                            >> {log}
        echo "  NanoFilt      : $USE_NF  (-q $NF_Q  -l $NF_L)"   >> {log}
        echo "  Filtlong      : min_length=$FL_L  keep%=$FL_P"    >> {log}
        echo "─────────────────────────────────────────────────"  >> {log}

        TMP="{output.filtered}.nanofilt_tmp"
        if [ "$USE_NF" = "true" ]; then
            echo "[filter] NanoFilt pre-pass (mean Q < 7)" >> {log}
            export PATH={params.nanoplot_bin}:$PATH
            NanoFilt -q $NF_Q -l $NF_L {input.reads} > "$TMP" 2>> {log}
            echo "[filter] Reads after NanoFilt: $(grep -c '^@' $TMP 2>/dev/null || echo 0)" >> {log}
            FILTER_INPUT="$TMP"
        else
            echo "[filter] NanoFilt skipped (mean Q ≥ 7)" >> {log}
            FILTER_INPUT="{input.reads}"
        fi

        echo "[filter] Running Filtlong" >> {log}
        {params.filtlong_bin} \
            --min_length   $FL_L \
            --keep_percent $FL_P \
            "$FILTER_INPUT" > {output.filtered} 2>> {log}

        rm -f "$TMP"

        FINAL=$(grep -c "^@" {output.filtered} 2>/dev/null || echo 0)
        echo "[filter] Final read count : $FINAL" >> {log}
        if [ "$FINAL" -lt 500 ]; then
            echo "[filter] CRITICAL: only $FINAL reads remain — check coverage and read_type." >> {log}
        elif [ "$FINAL" -lt 5000 ]; then
            echo "[filter] WARNING: only $FINAL reads remain — assembly may be incomplete." >> {log}
        fi
        """


# ─────────────────────────────────────────────────────────────────────────────
#  LR STEP 4  —  KRAKEN2  (long-read taxonomic classification)
# ─────────────────────────────────────────────────────────────────────────────

rule kraken_classify_long:
    """Classify filtered long reads with Kraken2 (--long-reads mode)."""
    input:
        reads = rules.adaptive_filter.output.filtered
    output:
        report = f"{OUTPUT_DIR}/{{sample}}/kraken_long/kraken2_report.txt",
        kout   = f"{OUTPUT_DIR}/{{sample}}/kraken_long/kraken2_output.txt"
