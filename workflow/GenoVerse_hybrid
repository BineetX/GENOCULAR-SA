def get_col(wildcards, col):
    val = samples_df.loc[samples_df["sample"] == wildcards.sample, col].values[0]
    path = f"{BASE_PATH}/{val}"
    if not os.path.exists(path):
        raise FileNotFoundError(f"[ERROR] File not found for sample '{wildcards.sample}' (column '{col}'): {path}")
    return path

def get_long_reads(wildcards): return get_col(wildcards, "R0")
def get_short_R1(wildcards): return get_col(wildcards, "R1")
def get_short_R2(wildcards): return get_col(wildcards, "R2")

def declared_read_type(wildcards):
    if "read_type" in samples_df.columns:
        rt = samples_df.loc[samples_df["sample"] == wildcards.sample, "read_type"].values
        if len(rt) > 0 and pd.notna(rt[0]):
            return str(rt[0]).strip()
    return ""

def declared_genome_size(wildcards):
    if "genome_size" in samples_df.columns:
        gs = samples_df.loc[samples_df["sample"] == wildcards.sample, "genome_size"].values
        if len(gs) > 0 and pd.notna(gs[0]):
            return str(gs[0]).strip()
    return "3m"

def genome_size_bp(gs_str):
    gs = str(gs_str).strip().lower()
    if gs.endswith("m"): return int(float(gs[:-1]) * 1_000_000)
    if gs.endswith("k"): return int(float(gs[:-1]) * 1_000)
    return int(gs)

