rule prodigal:
    """Ab initio gene prediction with Prodigal."""
    input:
        contigs = rules.unicycler.output.assembly
    output:
        coords   = f"{OUTPUT_DIR}/{{sample}}/prodigal/genes.coords",
        proteins = f"{OUTPUT_DIR}/{{sample}}/prodigal/proteins.faa",
        genes    = f"{OUTPUT_DIR}/{{sample}}/prodigal/genes.fna"
    params:
        env_bin = f"{ENVS['marine']}/bin"
    threads: 1
    log: f"{OUTPUT_DIR}/{{sample}}/logs/prodigal.log"
    shell:
        """
        export PATH={params.env_bin}:$PATH
        mkdir -p $(dirname {output.coords}) $(dirname {log})
        prodigal \
            -i {input.contigs} \
            -o {output.coords} \
            -a {output.proteins} \
            -d {output.genes} \
            -p single -q &> {log}
        """

rule interproscan:
    input:  faa = rules.prokka.output.faa
    output:
        tsv  = f"{OUTPUT_DIR}/{{sample}}/interproscan/interproscan_results.tsv",
        xml  = f"{OUTPUT_DIR}/{{sample}}/interproscan/interproscan_results.xml",
        gff3 = f"{OUTPUT_DIR}/{{sample}}/interproscan/interproscan_results.gff3"
    params:
        outdir   = f"{OUTPUT_DIR}/{{sample}}/interproscan",
        env_path = ENVS["interpro"]
    threads: 8
    log: f"{OUTPUT_DIR}/{{sample}}/logs/interproscan.log"
    shell:
        """
        export PATH={params.env_path}/bin:$PATH
        mkdir -p {params.outdir} $(dirname {log})

        # FIX: InterProScan is Java-based. Without adequate heap and a writable
        # temp directory it crashes silently. Set both explicitly.
        export JAVA_OPTS="-Xmx8g -Xms2g"
        export _JAVA_OPTIONS="-Djava.io.tmpdir={params.outdir}/tmp"
        IPRTMP="{params.outdir}/tmp"
        mkdir -p "$IPRTMP"

        echo "[InterProScan] Started for {wildcards.sample}" > {log}
        echo "[InterProScan] Input FAA: {input.faa}" >> {log}
        echo "[InterProScan] Sequences: $(grep -c '^>' {input.faa} 2>/dev/null || echo 0)" >> {log}
        echo "[InterProScan] JAVA_OPTS: $JAVA_OPTS" >> {log}
        echo "[InterProScan] Tmp dir  : $IPRTMP" >> {log}
        echo "[InterProScan] interproscan.sh: $(which interproscan.sh 2>/dev/null || echo NOT FOUND)" >> {log}

        # InterProScan cannot handle stop-codon '*' characters — strip them
        CLEAN_FAA="{params.outdir}/proteins_clean.faa"
        sed 's/*//g' {input.faa} > "$CLEAN_FAA"
        echo "[InterProScan] Cleaned FAA written: $CLEAN_FAA" >> {log}

        interproscan.sh \
            -i "$CLEAN_FAA" \
            -b {params.outdir}/interproscan_results \
            -f TSV,XML,GFF3 \
            -t p \
            -appl Pfam,TIGRFAM,Gene3D,PANTHER,SMART,CDD,ProSiteProfiles,ProSitePatterns \
            --disable-precalc \
            -iprlookup -goterms \
            -T "$IPRTMP" \
            --cpu {threads} >> {log} 2>&1

        ISTAT=$?
        echo "[InterProScan] Exit code: $ISTAT" >> {log}

        # FIX: check output BEFORE deleting clean FAA so we can diagnose failures
        [ -f {output.tsv}  ] || {{ echo "[InterProScan] No TSV — creating empty file"  >> {log}; touch {output.tsv};  }}
        [ -f {output.xml}  ] || {{ echo "[InterProScan] No XML — creating empty file"  >> {log}; touch {output.xml};  }}
        [ -f {output.gff3} ] || {{ echo "[InterProScan] No GFF3 — creating empty file" >> {log}; touch {output.gff3}; }}

        rm -f "$CLEAN_FAA"
        rm -rf "$IPRTMP"

        echo "[InterProScan] Done." >> {log}
        """


rule kofamscan:
    input:
        proteins = rules.prokka.output.faa
    output:
        kofamscan_results = f"{OUTPUT_DIR}/{{sample}}/kofamscan/kofamscan_results.txt",
        kofamscan_tsv     = f"{OUTPUT_DIR}/{{sample}}/kofamscan/kofamscan_results.tsv"
    params:
        profile  = KOFAM_PROFILE,
        ko_list  = KOFAM_KO_LIST,
        env_bin  = f"{ENVS['kofamscan']}/bin"   # FIX: full path
    threads: 30
    log: f"{OUTPUT_DIR}/{{sample}}/logs/kofamscan.log"
    shell:
        """
        # FIX: use export PATH like all other rules — conda activate is broken in Snakemake
        export PATH={params.env_bin}:$PATH

        # FIX: KofamScan exec_annotation is a Ruby script — Ruby gems must be
        # resolvable. Set GEM_PATH to the env's gem directory.
        export GEM_HOME={params.env_bin}/../lib/ruby/gems
        export GEM_PATH=$GEM_HOME

        mkdir -p $(dirname {output.kofamscan_results}) $(dirname {log})

        # FIX: dedicated tmp dir for large HMM intermediate files
        KOFAM_TMP=$(dirname {output.kofamscan_results})/tmp
        mkdir -p "$KOFAM_TMP"

        echo "[KofamScan] Started for {wildcards.sample}" > {log}
        echo "[KofamScan] Binary path : {params.env_bin}" >> {log}
        echo "[KofamScan] Profile     : {params.profile}"  >> {log}
        echo "[KofamScan] KO list     : {params.ko_list}"  >> {log}
        echo "[KofamScan] Input       : {input.proteins}"  >> {log}
        echo "[KofamScan] Sequences   : $(grep -c '^>' {input.proteins} 2>/dev/null || echo 0)" >> {log}
        echo "[KofamScan] exec_annotation: $(which exec_annotation 2>/dev/null || echo NOT FOUND)" >> {log}
        echo "[KofamScan] ruby        : $(which ruby 2>/dev/null || echo NOT FOUND)" >> {log}

        # FIX: fail loudly if exec_annotation is missing — not a silent touch
        if ! command -v exec_annotation &>/dev/null; then
            echo "[KofamScan] FATAL: exec_annotation not found in {params.env_bin}." >> {log}
            exit 1
        fi

        exec_annotation -f detail-tsv \
            -o {output.kofamscan_tsv} \
            --tmp-dir "$KOFAM_TMP" \
            -p {params.profile} -k {params.ko_list} \
            --cpu {threads} {input.proteins} >> {log} 2>&1

        KSTAT=$?
        echo "[KofamScan] Exit code: $KSTAT" >> {log}
        rm -rf "$KOFAM_TMP"

        # Guard: create empty TSV if nothing was produced
        [ -f {output.kofamscan_tsv} ] || {{ echo "[KofamScan] No TSV produced — creating empty" >> {log}; touch {output.kofamscan_tsv}; }}

        cp {output.kofamscan_tsv} {output.kofamscan_results}
        echo "[KofamScan] Done." >> {log}
        """


