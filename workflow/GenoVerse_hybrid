        db_path = KRAKEN_DB,
        env_bin = f"{ENVS['kraken2']}/bin"
    threads: 8
    log: f"{OUTPUT_DIR}/{{sample}}/logs/kraken_classify_long.log"
    shell:
        """
        export PATH={params.env_bin}:$PATH
        mkdir -p $(dirname {output.report}) $(dirname {log})
        kraken2 \
            --db      {params.db_path} \
            --threads {threads} \
            --long-reads \
            --use-names \
            --report  {output.report} \
            --output  {output.kout} \
            {input.reads} &> {log}
        """


# ─────────────────────────────────────────────────────────────────────────────
