rule checkm:
    input:
        contigs=checkm_input
    output:
        summary=checkm_summary
    params:
        PY=PY, STATUS=STATUS, JOB_ID=JOB_ID,
        step="checkm",
        summary="CheckM contamination/completeness"
    threads: 64
    conda: "envs/checkm.yml"
    log:
        f"{logdir}/checkm.log"
    shell:
        r"""
        mkdir -p "$(dirname {output.summary})" "$(dirname {log})"
        {params.PY} {params.STATUS} steps start {params.JOB_ID} {params.step} "{params.summary}" --msg "{params.summary}"
        set +e
        checkm lineage_wf -x fasta --threads {threads} \
          $(dirname {input.contigs}) $(dirname {output.summary}) &> {log}
