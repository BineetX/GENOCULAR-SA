rule crispr:
    input:
        contigs = spades_contigs
    output:
        crispr_output = crispr_summary
    params:
        PY      = PY,
        STATUS  = STATUS,
        JOB_ID  = JOB_ID,
        step    = "crispr",
        summary = "CRISPRCasFinder",
        crispr_dir = CRISPR_DIR.as_posix()
    conda:
        "envs/crisprcasfinder.yml"
    threads: 64
    log:
        f"{logdir}/crispr.log"
    shell:
        r"""
        set -euo pipefail

        mkdir -p "$(dirname {output.crispr_output})" "$(dirname {log})"

        {params.PY} {params.STATUS} steps start {params.JOB_ID} {params.step} "{params.summary}" --msg "{params.summary}"

        set +e


        export CRISPR_DIR="{params.crispr_dir}"
        export PATH="${{CRISPR_DIR}}:$PATH"
        export PERL5LIB="${{CRISPR_DIR}}:${{PERL5LIB:-}}"
        export LD_LIBRARY_PATH="${{CRISPR_DIR}}:${{LD_LIBRARY_PATH:-}}"


        if [ ! -x "${{CRISPR_DIR}}/CRISPRCasFinder.pl" ] || [ ! -f "${{CRISPR_DIR}}/sel392v2.so" ]; then
          echo "[CRISPR] CRISPRCasFinder or sel392v2.so missing in $CRISPR_DIR – skipping CRISPR step." | tee -a {log}
          : > "{output.crispr_output}"
          {params.PY} {params.STATUS} steps done {params.JOB_ID} {params.step} "{params.summary}" --msg "CRISPR skipped (tool/models missing)"
          exit 0
        fi

        # Extra PATH sanity
        if ! command -v CRISPRCasFinder.pl >/dev/null 2>&1; then
          echo "[CRISPR] CRISPRCasFinder.pl not on PATH (but exists). Skipping." | tee -a {log}
          : > "{output.crispr_output}"
          {params.PY} {params.STATUS} steps done {params.JOB_ID} {params.step} "{params.summary}" --msg "CRISPR skipped (not on PATH)"
          exit 0
        fi

        parent_dir="$(dirname {output.crispr_output})"
        run_dir="${{parent_dir}}/run_$(date +%s%N)_$RANDOM"
        mkdir -p "$run_dir"

        # Limit runtime so it can never hang forever (e.g. 6 hours = 21600 s)
        TIMEOUT=21600

        echo "[CRISPR] Running CRISPRCasFinder in $run_dir with timeout ${TIMEOUT}s" >> {log}

        timeout --foreground "$TIMEOUT" \
          CRISPRCasFinder.pl \
            -i {input.contigs} \
            -o "$run_dir" \
            -cas -keep \
            -soFile "${{CRISPR_DIR}}/sel392v2.so" &>> {log}
        rc=$?

        if [ "$rc" -eq 124 ]; then
          echo "[CRISPR] CRISPRCasFinder timed out after ${TIMEOUT}s" >> {log}
        fi

        if [ -f "$run_dir/TSV/Crisprs_REPORT.tsv" ]; then
          mv "$run_dir/TSV/Crisprs_REPORT.tsv" "{output.crispr_output}"
        else
          echo "[CRISPR] No Crisprs_REPORT.tsv found – writing empty summary." >> {log}
          : > "{output.crispr_output}"
        fi

        # Clean up temp directory
        rm -rf "$run_dir"

        set -e

        if [[ $rc -ne 0 ]]; then
          {params.PY} {params.STATUS} steps fail {params.JOB_ID} {params.step} "{params.summary}" --msg "CRISPRCasFinder exit $rc"
          exit $rc
        fi

        {params.PY} {params.STATUS} steps done {params.JOB_ID} {params.step} "{params.summary}"
        """



