rule busco:
    input:
        contigs=spades_contigs
    output:
        summary=busco_summary
    params:
        outdir=busco_outdir,
        PY=PY, STATUS=STATUS, JOB_ID=JOB_ID,
        step="busco",
        summary="BUSCO completeness"
    conda: "envs/busco.yml"
    threads: 64
    log:
        f"{logdir}/busco.log"
    shell:
        r"""
        mkdir -p "{params.outdir}" "$(dirname {log})"
        {params.PY} {params.STATUS} steps start {params.JOB_ID} {params.step} "{params.summary}" --msg "{params.summary}"

        set +e
        busco -i {input.contigs} \
          -o {sample}_busco_output \
          -m genome \
          -l {BUSCO_LINEAGE} \
          --out_path {params.outdir} \
          --offline -f --cpu {threads} &> {log}
        rc=$?
        set -e

        if [[ $rc -ne 0 ]]; then
          {params.PY} {params.STATUS} steps fail {params.JOB_ID} {params.step} "{params.summary}" --msg "Exit $rc"
          exit $rc
        fi

        # --- NEW: normalize BUSCO summary filename for Snakemake ---
        BUSCO_RUN="{params.outdir}/{sample}_busco_output"
        SUM="$(ls -1 "$BUSCO_RUN"/short_summary*.txt 2>/dev/null | head -n 1 || true)"
        if [[ -z "$SUM" ]]; then
          echo "ERROR: BUSCO summary not found in $BUSCO_RUN" >&2
          ls -la "$BUSCO_RUN" >&2 || true
          {params.PY} {params.STATUS} steps fail {params.JOB_ID} {params.step} "{params.summary}" --msg "Missing BUSCO short_summary"
          exit 2
        fi
        cp -f "$SUM" "{output.summary}"

        {params.PY} {params.STATUS} steps done {params.JOB_ID} {params.step} "{params.summary}"
        """


