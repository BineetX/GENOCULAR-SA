# ===========================
# Manifest for UI
# ===========================
def guess_kind(path):
    ext = os.path.splitext(path)[1].lower()
    return {
        ".html": "html", ".htm": "html",
        ".png": "image", ".jpg": "image", ".jpeg": "image", ".svg": "image",
        ".pdf": "pdf",
        ".fa": "fasta", ".fasta": "fasta", ".fq": "fastq", ".fastq": "fastq",
        ".tsv": "table", ".csv": "table", ".txt": "text", ".json": "json",
        ".gff": "gff"
    }.get(ext, "file")


rule manifest:
    message:
        "Writing manifest.json"
    output:
        manifest_path
    run:
        import os as _os, json as _json

        workdir = _os.getcwd()
        arts = []

        for root, _, files in _os.walk(workdir):
            # Skip Snakemake internals
            if ".snakemake" in root:
                continue
            for f in files:
                if f == "manifest.json":
                    continue
                full = _os.path.join(root, f)
                rel = _os.path.relpath(full, workdir)
                arts.append({
                    "name": rel,
                    "kind": guess_kind(rel),
                })

        with open(output[0], "w") as h:
            _json.dump(
                {
                    "job_id": config.get("JOB_ID", ""),
                    "artifacts": sorted(arts, key=lambda a: a["name"]),
                },
                h,
                indent=2,
            )
