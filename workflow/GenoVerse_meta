def P(*parts) -> str:
    "Path helper under job_root"
    return str(job_root.joinpath(*parts))

def get_sample_fastq(read: str) -> str:
    path = R1 if read == "R1" else R2
    if not os.path.exists(path):
        raise FileNotFoundError(f"Missing input file: {path}")
    return path

