rule repeatmasker:
    input:
        contigs=spades_contigs
    output:
        gff=repeatmasker_gff,
        masked_fasta=repeatmasker_mask
    params:
        PY=PY, STATUS=STATUS, JOB_ID=JOB_ID,
        step="repeatmasker",
        summary="RepeatMasker"
    conda: "envs/marine.yml"
    threads: 64
    log:
        f"{logdir}/repeatmasker.log"
    shell:
        r"""
        mkdir -p "$(dirname {output.gff})" "$(dirname {log})"
        {params.PY} {params.STATUS} steps start {params.JOB_ID} {params.step} "{params.summary}" --msg "{params.summary}"
        set +e
        RepeatMasker -species all -gff -dir $(dirname {output.gff}) {input.contigs} &> {log}
        rc=$?
        # normalize filenames
        [ -f $(dirname {output.gff})/$(basename {input.contigs}).out.gff ] && \
          mv $(dirname {output.gff})/$(basename {input.contigs}).out.gff {output.gff} || true
        [ -f $(dirname {output.gff})/$(basename {input.contigs}).masked ] && \
          mv $(dirname {output.gff})/$(basename {input.contigs}).masked {output.masked_fasta} || true
        set -e
        if [[ $rc -ne 0 ]]; then {params.PY} {params.STATUS} steps fail {params.JOB_ID} {params.step} "{params.summary}" --msg "Exit $rc"; exit $rc; fi
        {params.PY} {params.STATUS} steps done {params.JOB_ID} {params.step} "{params.summary}"
