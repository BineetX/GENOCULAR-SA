# ========== RULES (params for status invocations) ==========
rule trimmomatic:
    input:
        R1=lambda wc: get_sample_fastq('R1'),
        R2=lambda wc: get_sample_fastq('R2')
    output:
        paired_R1=paired_R1,
        unpaired_R1=unpaired_R1,
        paired_R2=paired_R2,
        unpaired_R2=unpaired_R2
    params:
        adapter_file=ADAPTER_FILE,
        PY=PY, STATUS=STATUS, JOB_ID=JOB_ID,
        step="trimmomatic",
        summary="Trim/adapters & quality"
    conda: "envs/marine.yml"
    threads: 64
    log:
        f"{logdir}/trimmomatic.log"
    shell:
        r"""
        mkdir -p "$(dirname {output.paired_R1})" "$(dirname {log})"
        {params.PY} {params.STATUS} steps start {params.JOB_ID} {params.step} "{params.summary}" --msg "{params.summary}"
        set +e
        java -jar {TRIMMOMATIC_JAR} PE \
          -phred33 -threads {threads} \
          {input.R1} {input.R2} \
          {output.paired_R1} {output.unpaired_R1} \
          {output.paired_R2} {output.unpaired_R2} \
          ILLUMINACLIP:{params.adapter_file}:2:30:10 \
          LEADING:3 TRAILING:3 SLIDINGWINDOW:4:20 MINLEN:50 &> {log}
        rc=$?
        set -e
        if [[ $rc -ne 0 ]]; then {params.PY} {params.STATUS} steps fail {params.JOB_ID} {params.step} "{params.summary}" --msg "Exit $rc"; exit $rc; fi
        {params.PY} {params.STATUS} steps done {params.JOB_ID} {params.step} "{params.summary}"
        """

rule cutadapt_paired:
    input:
        paired_R1=paired_R1,
        paired_R2=paired_R2
    output:
        trimmed_R1=trimmed_R1,
        trimmed_R2=trimmed_R2
    params:
        PY=PY, STATUS=STATUS, JOB_ID=JOB_ID,
        step="cutadapt_paired",
        summary="Adapter/quality trim (Cutadapt)"
    conda: "envs/cutadapt.yml"
    threads: 64
    log:
        f"{logdir}/cutadapt_paired.log"
    shell:
        r"""
        mkdir -p "$(dirname {output.trimmed_R1})" "$(dirname {log})"
        {params.PY} {params.STATUS} steps start {params.JOB_ID} {params.step} "{params.summary}" --msg "{params.summary}"
        set +e
        cutadapt -q 20 -o {output.trimmed_R1} -p {output.trimmed_R2} \
          {input.paired_R1} {input.paired_R2} &> {log}
        rc=$?
        set -e
        if [[ $rc -ne 0 ]]; then {params.PY} {params.STATUS} steps fail {params.JOB_ID} {params.step} "{params.summary}" --msg "Exit $rc"; exit $rc; fi
        {params.PY} {params.STATUS} steps done {params.JOB_ID} {params.step} "{params.summary}"
        """

rule seqtk_trim:
    input:
        trimmed_R1=trimmed_R1,
        trimmed_R2=trimmed_R2
    output:
        trimmed_R1_seqtk=seqtk_R1,
        trimmed_R2_seqtk=seqtk_R2
    params:
        PY=PY, STATUS=STATUS, JOB_ID=JOB_ID,
        step="seqtk_trim",
        summary="Seqtk soft trimming"
    conda: "envs/marine.yml"
    threads: 64
    log:
        f"{logdir}/seqtk_trim.log"
    shell:
        r"""
        mkdir -p "$(dirname {output.trimmed_R1_seqtk})" "$(dirname {log})"
        {params.PY} {params.STATUS} steps start {params.JOB_ID} {params.step} "{params.summary}" --msg "{params.summary}"
        set +e
        {{ 
            seqtk trimfq {input.trimmed_R1} > {output.trimmed_R1_seqtk}
            seqtk trimfq {input.trimmed_R2} > {output.trimmed_R2_seqtk} 
        }}&> {log}
        rc=$?
        set -e
        if [[ $rc -ne 0 ]]; then {params.PY} {params.STATUS} steps fail {params.JOB_ID} {params.step} "{params.summary}" --msg "Exit $rc"; exit $rc; fi
        {params.PY} {params.STATUS} steps done {params.JOB_ID} {params.step} "{params.summary}"
        """


rule bbduk:
    input:
        trimmed_R1_seqtk=seqtk_R1,
        trimmed_R2_seqtk=seqtk_R2
    output:
        cleaned_R1=bbduk_R1,
        cleaned_R2=bbduk_R2
    conda: "envs/marine.yml"
    threads: 64
    log:
        P("logs", "bbduk.log")
    params:
        PY=PY, STATUS=STATUS, JOB_ID=JOB_ID, step="bbduk", summary="BBDuk decontamination"
    shell:
        r"""
        mkdir -p "$(dirname {output.cleaned_R1})" "$(dirname {log})"
        {params.PY} {params.STATUS} steps start {params.JOB_ID} {params.step} "{params.summary}" --name "BBDuk"
        set +e
        bbduk.sh in={input.trimmed_R1_seqtk} in2={input.trimmed_R2_seqtk} \
          out={output.cleaned_R1} out2={output.cleaned_R2} \
          ref=adapters ktrim=r k=23 mink=11 hdist=1 tpe tbo &> {log}
        rc=$?
        set -e
