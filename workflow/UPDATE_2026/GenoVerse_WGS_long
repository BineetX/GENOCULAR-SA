        """


# ─────────────────────────────────────────────────────────────────────────────
#  STEP 2  —  PIPELINE DECISION ENGINE
# ─────────────────────────────────────────────────────────────────────────────

rule pipeline_decision:
    input:
        stats = rules.nanoplot.output.stats
    output:
        json_out = f"{OUTPUT_DIR}/{{sample}}/decisions/pipeline_decision.json",
        log_out  = f"{OUTPUT_DIR}/{{sample}}/decisions/decision_summary.txt"
    params:
        declared_rt = lambda wildcards: declared_read_type(wildcards),
        genome_size = lambda wildcards: declared_genome_size(wildcards)
    log: f"{OUTPUT_DIR}/{{sample}}/logs/pipeline_decision.log"
    run:
        import json

        ns = {}
        with open(input.stats) as fh:
            for line in fh:
                if ":" in line:
                    k, v = line.strip().split(":", 1)
                    k = k.strip().lower().replace(" ", "_")
                    v = v.strip().replace(",", "")
                    try:    ns[k] = float(v)
                    except: ns[k] = v

        mean_q      = float(ns.get("mean_read_quality",  ns.get("mean_quality",  8.0)))
        median_len  = float(ns.get("median_read_length", ns.get("median_length", 5000.0)))
        n50         = float(ns.get("read_n50",           ns.get("n50",           5000.0)))
        total_reads = float(ns.get("number_of_reads",    ns.get("reads",         50000.0)))
        total_bases = float(ns.get("total_bases",        total_reads * median_len))

        gs_str   = params.genome_size
        gs_bp    = genome_size_bp(gs_str)
        coverage = round(total_bases / gs_bp, 1)
        declared = params.declared_rt

        if mean_q >= 12 and median_len >= 5000:
            auto_type = "ont_r10"
        elif mean_q >= 10 and median_len >= 4000:
            auto_type = "ont_r10"
        elif mean_q >= 7 and median_len >= 3000:
            auto_type = "ont_r9"
        else:
            auto_type = "pacbio_clr"

        valid_types = {"ont_r9", "ont_r10", "ont_r10_sup", "pacbio_clr"}
        conflict    = ""
        if declared in valid_types:
            if declared == "pacbio_clr" and mean_q > 12:
                conflict   = (f"WARNING: Declared 'pacbio_clr' but mean Q={mean_q:.1f} "
                              f"looks like ONT. Auto-overriding to {auto_type}.")
                final_type = auto_type
            elif declared in {"ont_r9", "ont_r10", "ont_r10_sup"} and mean_q < 5:
                conflict   = (f"WARNING: Declared ONT but mean Q={mean_q:.1f} is very low. "
                              f"Auto-overriding to pacbio_clr.")
                final_type = "pacbio_clr"
            else:
                final_type = declared
        else:
            final_type = auto_type

        is_ont = final_type in {"ont_r9", "ont_r10", "ont_r10_sup"}
        is_clr = final_type == "pacbio_clr"

        warnings = []
        if coverage < 20:
            filtlong_min_len  = 500
            filtlong_keep_pct = 99
            coverage_tier     = "ultra-light (<20x)"
            warnings.append(f"Very low coverage ({coverage:.1f}x). Filtlong ultra-light to preserve reads.")
        elif coverage < 50:
            filtlong_min_len  = 1000
            filtlong_keep_pct = 95
            coverage_tier     = "light (<50x)"
        elif coverage <= 150:
            filtlong_min_len  = 1000
            filtlong_keep_pct = 90
            coverage_tier     = "moderate (50-150x)"
        else:
            filtlong_min_len  = 2000
            filtlong_keep_pct = 80
            coverage_tier     = "strict (>150x)"

        if n50 < 2000 and filtlong_min_len > 500:
            filtlong_min_len = 500
            warnings.append(f"Read N50 ({n50:.0f} bp) < 2000 bp. Filtlong min_length relaxed to 500.")

        if total_reads < 5000:
            filtlong_min_len  = 500
            filtlong_keep_pct = 99
            warnings.append(f"Only {int(total_reads):,} reads total. Maximum read-retention applied.")

        use_nanofilt    = False
        nanofilt_q      = 5
        nanofilt_len    = 500
        nanofilt_reason = "Not applied"
        if mean_q < 7.0:
            use_nanofilt = True
            if mean_q < 5.5:
                nanofilt_q      = 4
                nanofilt_reason = f"Mean Q ({mean_q:.1f}) < 5.5 — NanoFilt -q 4 applied (minimal threshold)."
            else:
                nanofilt_q      = 5
                nanofilt_reason = f"Mean Q ({mean_q:.1f}) < 7.0 — NanoFilt -q 5 applied before Filtlong."
        else:
            nanofilt_reason = f"Mean Q ({mean_q:.1f}) >= 7.0 — NanoFilt not needed; Filtlong only."

        flye_mode   = "--nano-hq" if final_type in {"ont_r10", "ont_r10_sup"} else "--nano-raw"
        if is_clr:
            flye_mode = "--pacbio-raw"
        min_overlap = min(10000, max(500, int(n50 / 2)))
        iterations  = 1 if is_clr else 2

        racon_rounds = 2
        do_medaka    = False
        medaka_model = MEDAKA_MODELS.get(final_type, None)

        os.makedirs(os.path.dirname(output.json_out), exist_ok=True)
        decision = {
            "sample"            : wildcards.sample,
            "genome_size_str"   : gs_str,
            "genome_size_bp"    : gs_bp,
            "mean_q"            : round(mean_q, 2),
            "median_len"        : int(median_len),
            "n50"               : int(n50),
            "total_reads"       : int(total_reads),
            "total_bases"       : int(total_bases),
            "coverage_x"        : coverage,
            "coverage_tier"     : coverage_tier,
            "declared_type"     : declared,
            "auto_type"         : auto_type,
            "final_type"        : final_type,
            "conflict"          : conflict,
            "is_ont"            : is_ont,
            "is_clr"            : is_clr,
            "use_nanofilt"      : use_nanofilt,
            "nanofilt_q"        : nanofilt_q,
            "nanofilt_len"      : nanofilt_len,
            "nanofilt_reason"   : nanofilt_reason,
            "filtlong_min_len"  : filtlong_min_len,
            "filtlong_keep_pct" : filtlong_keep_pct,
            "flye_mode"         : flye_mode,
            "flye_min_overlap"  : min_overlap,
            "flye_iterations"   : iterations,
            "racon_rounds"      : racon_rounds,
            "do_medaka"         : do_medaka,
            "medaka_model"      : medaka_model,
            "warnings"          : warnings,
        }
        with open(output.json_out, "w") as fh:
            json.dump(decision, fh, indent=2)

        sep = "-" * 60
        with open(output.log_out, "w") as fh:
            fh.write(f"{'='*60}\n")
            fh.write(f"  PIPELINE DECISION SUMMARY  --  {wildcards.sample}\n")
            fh.write(f"{'='*60}\n\n")
            fh.write(f"  Read statistics\n  {sep}\n")
            fh.write(f"    Mean Q        : {mean_q:.2f}\n")
            fh.write(f"    Median length : {int(median_len):,} bp\n")
            fh.write(f"    Read N50      : {int(n50):,} bp\n")
            fh.write(f"    Total reads   : {int(total_reads):,}\n")
            fh.write(f"    Total bases   : {int(total_bases):,}\n\n")
            fh.write(f"  Coverage\n  {sep}\n")
            fh.write(f"    Genome size   : {gs_str}  ({gs_bp:,} bp)\n")
            fh.write(f"    Estimated Cx  : {coverage:.1f}x  [{coverage_tier}]\n\n")
            fh.write(f"  Read type\n  {sep}\n")
            fh.write(f"    Declared      : {declared or '(not specified -- auto-detecting)'}\n")
            fh.write(f"    Auto-detected : {auto_type}\n")
            fh.write(f"    FINAL         : {final_type}\n")
            if conflict:
                fh.write(f"    [!] {conflict}\n")
            fh.write(f"\n  Filtering strategy (QC-driven, mirrors short-read adaptive logic)\n  {sep}\n")
            fh.write(f"    NanoFilt      : {'YES -- ' if use_nanofilt else 'NO  -- '}{nanofilt_reason}\n")
            if use_nanofilt:
                fh.write(f"      Parameters  : -q {nanofilt_q}  -l {nanofilt_len}\n")
            fh.write(f"    Filtlong      : --min_length {filtlong_min_len}  --keep_percent {filtlong_keep_pct}\n")
            fh.write(f"\n  Assembly (Flye)\n  {sep}\n")
            fh.write(f"    Mode          : {flye_mode}\n")
            fh.write(f"    Min overlap   : {min_overlap} bp  (= max(500, N50/2))\n")
            fh.write(f"    Iterations    : {iterations}\n")
            fh.write(f"\n  Polishing\n  {sep}\n")
            fh.write(f"    Racon         : {racon_rounds} rounds\n")
            fh.write(f"    Medaka        : {'ENABLED -- model: ' + str(medaka_model) if do_medaka else 'SKIPPED (not installed)'}\n")
            fh.write(f"    Circlator     : SKIPPED (not installed)\n")
            if warnings:
                fh.write(f"\n  Adaptive warnings\n  {sep}\n")
                for w in warnings:
                    fh.write(f"    [WARN] {w}\n")

        with open(log[0], "w") as lf:
            lf.write(f"Decision complete. Final type: {final_type}  Coverage: {coverage:.1f}x\n")
            if conflict:
                lf.write(conflict + "\n")
            for w in warnings:
                lf.write(f"[WARN] {w}\n")


# ─────────────────────────────────────────────────────────────────────────────
#  STEP 3  —  ADAPTIVE FILTERING
# ─────────────────────────────────────────────────────────────────────────────

rule adaptive_filter:
    input:
        reads    = lambda wildcards: get_reads(wildcards),
        dec_json = rules.pipeline_decision.output.json_out
    output:
        filtered = f"{OUTPUT_DIR}/{{sample}}/filtered/{{sample}}_filtered.fastq"
    params:
        nanoplot_bin = f"{ENVS['nanoplot']}/bin",
        filtlong_bin = FILTLONG_BIN
    threads: 2
    log: f"{OUTPUT_DIR}/{{sample}}/logs/adaptive_filter.log"
    shell:
        """
        mkdir -p $(dirname {output.filtered}) $(dirname {log})

        USE_NF=$(python3 -c "import json; d=json.load(open('{input.dec_json}')); print(str(d['use_nanofilt']).lower())")
        NF_Q=$(python3   -c "import json; d=json.load(open('{input.dec_json}')); print(d['nanofilt_q'])")
        NF_L=$(python3   -c "import json; d=json.load(open('{input.dec_json}')); print(d['nanofilt_len'])")
        FL_L=$(python3   -c "import json; d=json.load(open('{input.dec_json}')); print(d['filtlong_min_len'])")
        FL_P=$(python3   -c "import json; d=json.load(open('{input.dec_json}')); print(d['filtlong_keep_pct'])")
        COV=$(python3    -c "import json; d=json.load(open('{input.dec_json}')); print(d['coverage_x'])")
        TIER=$(python3   -c "import json; d=json.load(open('{input.dec_json}')); print(d['coverage_tier'])")
        MEAN_Q=$(python3 -c "import json; d=json.load(open('{input.dec_json}')); print(d['mean_q'])")

        echo "─────────────────────────────────────────────────"  >> {log}
        echo "  Adaptive Filtering  --  {wildcards.sample}"       >> {log}
        echo "  Mean Q     : $MEAN_Q"                             >> {log}
        echo "  Coverage   : ${{COV}}x  ($TIER)"                  >> {log}
        echo "  NanoFilt   : $USE_NF  (q=$NF_Q, l=$NF_L)"        >> {log}
        echo "  Filtlong   : min_length=$FL_L  keep_percent=$FL_P" >> {log}
        echo "─────────────────────────────────────────────────"  >> {log}

        TMP_READS="{output.filtered}.nanofilt_tmp"
        if [ "$USE_NF" = "true" ]; then
            echo "[filter] NanoFilt pre-pass enabled (mean Q < 7)" >> {log}
            export PATH={params.nanoplot_bin}:$PATH
            NanoFilt -q $NF_Q -l $NF_L {input.reads} > "$TMP_READS" 2>> {log}
            PRE_COUNT=$(grep -c "^@" "$TMP_READS" 2>/dev/null || echo 0)
            echo "[filter] Reads after NanoFilt : $PRE_COUNT" >> {log}
            FILTER_INPUT="$TMP_READS"
        else
            echo "[filter] NanoFilt skipped (mean Q >= 7 — reads are good quality)" >> {log}
            FILTER_INPUT="{input.reads}"
        fi

        echo "[filter] Running Filtlong: min_length=$FL_L  keep_percent=$FL_P" >> {log}
        {params.filtlong_bin} \
            --min_length   $FL_L \
            --keep_percent $FL_P \
            "$FILTER_INPUT" > {output.filtered} 2>> {log}

        rm -f "$TMP_READS"

        FINAL=$(grep -c "^@" {output.filtered} 2>/dev/null || echo 0)
        echo "[filter] Final read count : $FINAL" >> {log}
        if [ "$FINAL" -lt 500 ]; then
            echo "[filter] CRITICAL: only $FINAL reads remain — check coverage and read_type." >> {log}
        elif [ "$FINAL" -lt 5000 ]; then
            echo "[filter] WARNING: only $FINAL reads remain — assembly may be incomplete." >> {log}
        fi
        """


# ─────────────────────────────────────────────────────────────────────────────
#  STEP 4  —  KRAKEN2
# ─────────────────────────────────────────────────────────────────────────────

rule kraken_classify:
    input:
        reads = rules.adaptive_filter.output.filtered
    output:
