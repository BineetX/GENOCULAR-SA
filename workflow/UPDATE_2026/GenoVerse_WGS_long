# ─────────────────────────────────────────────────────────────────────────────
#  STEP 6  —  FLYE ASSEMBLY
# ─────────────────────────────────────────────────────────────────────────────

rule flye:
    input:
        reads    = rules.kraken_extract.output.classified,
        dec_json = rules.pipeline_decision.output.json_out
    output:
        assembly = f"{OUTPUT_DIR}/{{sample}}/flye_output/assembly.fasta",
        info     = f"{OUTPUT_DIR}/{{sample}}/flye_output/assembly_info.txt"
    params:
        outdir      = f"{OUTPUT_DIR}/{{sample}}/flye_output",
        env_bin     = f"{ENVS['flye']}/bin",
        genome_size = lambda wildcards: declared_genome_size(wildcards)
    threads: 16
    log: f"{OUTPUT_DIR}/{{sample}}/logs/flye.log"
    shell:
        """
        export PATH={params.env_bin}:$PATH
        mkdir -p {params.outdir} $(dirname {log})

        FLYE_MODE=$(python3 -c "import json; d=json.load(open('{input.dec_json}')); print(d['flye_mode'])")
        MIN_OL=$(python3    -c "import json; d=json.load(open('{input.dec_json}')); print(d['flye_min_overlap'])")
        ITER=$(python3      -c "import json; d=json.load(open('{input.dec_json}')); print(d['flye_iterations'])")

        echo "─────────────────────────────────────────────────" >> {log}
        echo "  Flye  --  {wildcards.sample}"                   >> {log}
        echo "  mode=$FLYE_MODE  min_overlap=$MIN_OL  iter=$ITER" >> {log}
        echo "  genome_size={params.genome_size}"               >> {log}
        echo "─────────────────────────────────────────────────" >> {log}

        flye \
            $FLYE_MODE       {input.reads} \
            --out-dir        {params.outdir} \
            --genome-size    {params.genome_size} \
            --min-overlap    $MIN_OL \
            --iterations     $ITER \
            --threads        {threads} \
            &>> {log}
        """


# ─────────────────────────────────────────────────────────────────────────────
#  STEP 7a  —  RACON ROUND 1
# ─────────────────────────────────────────────────────────────────────────────

rule racon_round1:
    input:
        assembly = rules.flye.output.assembly,
        reads    = rules.kraken_extract.output.classified,
        dec_json = rules.pipeline_decision.output.json_out
    output:
        paf       = f"{OUTPUT_DIR}/{{sample}}/racon/round1/reads_vs_assembly.paf",
        polished1 = f"{OUTPUT_DIR}/{{sample}}/racon/round1/racon_r1.fasta"
    params:
        env_bin = f"{ENVS['racon']}/bin"
    threads: 16
    log: f"{OUTPUT_DIR}/{{sample}}/logs/racon_round1.log"
    shell:
        """
        export PATH={params.env_bin}:$PATH
        mkdir -p $(dirname {output.paf}) $(dirname {log})

        IS_CLR=$(python3 -c "import json; d=json.load(open('{input.dec_json}')); print(str(d['is_clr']).lower())")
        [ "$IS_CLR" = "true" ] && PRESET="map-pb" || PRESET="map-ont"
        echo "[racon R1] minimap2 preset : $PRESET" >> {log}

        minimap2 -x $PRESET -t {threads} \
            {input.assembly} {input.reads} \
            > {output.paf} 2>> {log}

        racon -t {threads} \
            {input.reads} {output.paf} {input.assembly} \
            > {output.polished1} 2>> {log}

        echo "[racon R1] Contigs: $(grep -c '^>' {output.polished1})" >> {log}
        """


