# ─────────────────────────────────────────────────────────────────────────────
#  STEP 15  —  INTERPROSCAN
#  FIX v1: removed "|| true" — failures now propagate and produce real log output.
#  FIX v1: added guard to create empty output files if interproscan produces nothing.
#  FIX v2: added JAVA_OPTS (-Xmx8g) and -T tmpdir — InterProScan silently
#           crashes without adequate Java heap or a writable temp directory.
#  FIX v2: moved rm -f "$CLEAN_FAA" to AFTER output-file guards, so the input
#           is preserved for diagnosis if something goes wrong.
#  FIX v2: added interproscan.sh location to log for environment debugging.
# ─────────────────────────────────────────────────────────────────────────────

rule interproscan:
    input:
        faa = rules.prokka.output.faa
    output:
        tsv  = f"{OUTPUT_DIR}/{{sample}}/interproscan/interproscan_results.tsv",
        xml  = f"{OUTPUT_DIR}/{{sample}}/interproscan/interproscan_results.xml",
        gff3 = f"{OUTPUT_DIR}/{{sample}}/interproscan/interproscan_results.gff3"
    params:
        outdir   = f"{OUTPUT_DIR}/{{sample}}/interproscan",
        env_path = ENVS["interpro"]
    threads: 8
    log: f"{OUTPUT_DIR}/{{sample}}/logs/interproscan.log"
    shell:
        """
        export PATH={params.env_path}/bin:$PATH
        mkdir -p {params.outdir} $(dirname {log})

        # FIX: InterProScan is Java-based. Without adequate heap and a writable
        # temp directory it crashes silently. Set both explicitly.
        export JAVA_OPTS="-Xmx8g -Xms2g"
        export _JAVA_OPTIONS="-Djava.io.tmpdir={params.outdir}/tmp"
        IPRTMP="{params.outdir}/tmp"
        mkdir -p "$IPRTMP"

        echo "[InterProScan] Started for {wildcards.sample}" > {log}
        echo "[InterProScan] Input FAA: {input.faa}" >> {log}
        echo "[InterProScan] Sequences: $(grep -c '^>' {input.faa} 2>/dev/null || echo 0)" >> {log}
        echo "[InterProScan] JAVA_OPTS: $JAVA_OPTS" >> {log}
        echo "[InterProScan] Tmp dir  : $IPRTMP" >> {log}
        echo "[InterProScan] interproscan.sh: $(which interproscan.sh 2>/dev/null || echo NOT FOUND)" >> {log}

        # InterProScan cannot handle stop-codon '*' characters — strip them
        CLEAN_FAA="{params.outdir}/proteins_clean.faa"
        sed 's/*//g' {input.faa} > "$CLEAN_FAA"
        echo "[InterProScan] Cleaned FAA written: $CLEAN_FAA" >> {log}

        # FIX: removed || true so any real failure is visible in the log
        interproscan.sh \
            -i "$CLEAN_FAA" \
            -b {params.outdir}/interproscan_results \
            -f TSV,XML,GFF3 \
            -t p \
            -appl Pfam,TIGRFAM,Gene3D,PANTHER,SMART,CDD,ProSiteProfiles,ProSitePatterns \
            --disable-precalc \
            -iprlookup -goterms \
            -T "$IPRTMP" \
            --cpu {threads} >> {log} 2>&1

        ISTAT=$?
        echo "[InterProScan] Exit code: $ISTAT" >> {log}

        # FIX: check for output files BEFORE deleting the clean FAA, so we can
        # diagnose failures against the input that was actually used.
        # Create empty output files if interproscan produced nothing
        # (e.g. no domain hits found — this is valid, not an error)
        [ -f {output.tsv}  ] || {{ echo "[InterProScan] No TSV produced — creating empty file"  >> {log}; touch {output.tsv};  }}
        [ -f {output.xml}  ] || {{ echo "[InterProScan] No XML produced — creating empty file"  >> {log}; touch {output.xml};  }}
        [ -f {output.gff3} ] || {{ echo "[InterProScan] No GFF3 produced — creating empty file" >> {log}; touch {output.gff3}; }}

        # Clean up tmp and clean FAA only after outputs are confirmed
        rm -f "$CLEAN_FAA"
        rm -rf "$IPRTMP"

        echo "[InterProScan] Done." >> {log}
        """


# ─────────────────────────────────────────────────────────────────────────────
#  STEP 16  —  KOFAMSCAN
#  FIX v1: removed "conda activate" — now uses export PATH like every other rule.
#  FIX v1: fixed env path — was bare name "kofamscan_env", now full path.
#  FIX v1: added guard to create empty output if exec_annotation produces nothing.
#  FIX v2: added GEM_HOME/GEM_PATH — exec_annotation is a Ruby script and
#           requires Ruby gems to be resolvable in the conda env.
#  FIX v2: added explicit exec_annotation binary check — exits with error (not
#           silent touch) when the tool is missing from PATH.
#  FIX v2: added --tmp-dir for KofamScan's large HMM intermediate files.
# ─────────────────────────────────────────────────────────────────────────────

rule kofamscan:
    input:
        proteins = rules.prokka.output.faa
    output:
        kofamscan_results = f"{OUTPUT_DIR}/{{sample}}/kofamscan/kofamscan_results.txt",
        kofamscan_tsv     = f"{OUTPUT_DIR}/{{sample}}/kofamscan/kofamscan_results.tsv"
    params:
        profile  = KOFAM_PROFILE,
        ko_list  = KOFAM_KO_LIST,
        env_bin  = f"{ENVS['kofamscan']}/bin"   # FIX: full path, not bare env name
    threads: 30
    log: f"{OUTPUT_DIR}/{{sample}}/logs/kofamscan.log"
    shell:
        """
        # FIX: use export PATH like all other rules — no conda activate needed
        export PATH={params.env_bin}:$PATH

        # FIX: KofamScan exec_annotation is a Ruby script — Ruby gems must be
        # resolvable. Set GEM_PATH to the env's gem directory so Ruby finds them.
        export GEM_HOME={params.env_bin}/../lib/ruby/gems
        export GEM_PATH=$GEM_HOME
        export RUBY_VERSION=$(ruby --version 2>/dev/null | awk '{{print $2}}' | cut -d. -f1,2 || echo "")
        if [ -d "{params.env_bin}/../lib/ruby/gems" ]; then
            export GEM_HOME="{params.env_bin}/../lib/ruby/gems"
        fi

        mkdir -p $(dirname {output.kofamscan_results}) $(dirname {log})

        # FIX: KofamScan writes large intermediate HMM files — give it a dedicated
        # tmp dir with enough space, and clean up afterwards.
        KOFAM_TMP=$(dirname {output.kofamscan_results})/tmp
        mkdir -p "$KOFAM_TMP"

        echo "[KofamScan] Started for {wildcards.sample}" > {log}
        echo "[KofamScan] Binary path : {params.env_bin}" >> {log}
        echo "[KofamScan] Profile     : {params.profile}"  >> {log}
        echo "[KofamScan] KO list     : {params.ko_list}"  >> {log}
        echo "[KofamScan] Input       : {input.proteins}"  >> {log}
        echo "[KofamScan] Tmp dir     : $KOFAM_TMP"        >> {log}
        echo "[KofamScan] Sequences   : $(grep -c '^>' {input.proteins} 2>/dev/null || echo 0)" >> {log}
        echo "[KofamScan] exec_annotation location: $(which exec_annotation 2>/dev/null || echo NOT FOUND)" >> {log}
        echo "[KofamScan] ruby location           : $(which ruby 2>/dev/null || echo NOT FOUND)" >> {log}

        # FIX: Fail loudly if exec_annotation is missing — do not silently touch output
        if ! command -v exec_annotation &>/dev/null; then
            echo "[KofamScan] FATAL: exec_annotation not found in PATH ({params.env_bin})." >> {log}
            echo "[KofamScan] Check: ls {params.env_bin}/exec_annotation" >> {log}
            echo "[KofamScan] The kofamscan conda env may need reinstalling." >> {log}
            exit 1
        fi

        exec_annotation -f detail-tsv \
            -o {output.kofamscan_tsv} \
            --tmp-dir "$KOFAM_TMP" \
            -p {params.profile} -k {params.ko_list} \
            --cpu {threads} {input.proteins} >> {log} 2>&1

        KSTAT=$?
        echo "[KofamScan] Exit code: $KSTAT" >> {log}
        rm -rf "$KOFAM_TMP"

        # Guard: create empty TSV if nothing was produced
        [ -f {output.kofamscan_tsv} ] || {{ echo "[KofamScan] No TSV produced — creating empty file" >> {log}; touch {output.kofamscan_tsv}; }}

        cp {output.kofamscan_tsv} {output.kofamscan_results}
        echo "[KofamScan] Done." >> {log}
        """


# ─────────────────────────────────────────────────────────────────────────────
