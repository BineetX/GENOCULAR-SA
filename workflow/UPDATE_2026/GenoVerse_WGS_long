def _find_env_dir(env_names, probe_bin):
    for env_name in env_names:
        p = Path(env_name)
        if (p / "bin" / probe_bin).exists():
            return str(p)

    mode_shared = Path(os.environ.get("SHARED_CONDA_PREFIX", "/data/genoverse/smk_envs_v4/shared"))
    global_shared = Path(os.environ.get("GENOVERSE_GLOBAL_CONDA_PREFIX", "/data/genoverse/smk_envs_v4/shared"))
    for shared_prefix in (mode_shared, global_shared):
        if shared_prefix.exists():
            for d in sorted(shared_prefix.glob("*")):
                if d.is_dir() and (d / "bin" / probe_bin).exists():
                    return str(d)

    return ""

