    output:
        antismash_results = f"{OUTPUT_DIR}/{{sample}}/antismash_results/knownclusterblast.txt",
        index_html        = f"{OUTPUT_DIR}/{{sample}}/antismash_results/index.html"
    params:
        antismash_db = ANTISMASH_DB,
        output_dir   = f"{OUTPUT_DIR}/{{sample}}/antismash_results",
        env_path     = ENVS["antismash"]
    threads: 8
    log: f"{OUTPUT_DIR}/{{sample}}/logs/antismash.log"
    shell:
        """
        export PATH={params.env_path}/bin:$PATH
        export ANTISMASH_DATABASES="{params.antismash_db}"
        mkdir -p "{params.output_dir}" "$(dirname {log})"
        PYTHONWARNINGS="ignore::BiopythonWarning" antismash {input.contigs} \
            --output-dir {params.output_dir} \
            --genefinding-tool prodigal --taxon bacteria \
            --cb-knownclusters --cb-subclusters --cb-general \
            --cc-mibig --fullhmmer --clusterhmmer \
            --asf --pfam2go --enable-genefunctions --tigrfam --tfbs --rre --smcog-trees \
            --enable-nrps-pks --enable-lanthipeptides --enable-lassopeptides \
            --enable-thiopeptides --enable-terpene --enable-html \
            --cpus {threads} &> {log}
        [ -f {params.output_dir}/knownclusterblast.txt ] \
            || touch {params.output_dir}/knownclusterblast.txt
        [ -f {params.output_dir}/index.html ] \
            || touch {params.output_dir}/index.html
        """


# ─────────────────────────────────────────────────────────────────────────────
#  STEP 22  —  REPEATMASKER
# ─────────────────────────────────────────────────────────────────────────────

rule repeatmasker:
    input:
        contigs = rules.finalize_assembly.output.final_polished
    output:
        masked_fasta = f"{OUTPUT_DIR}/{{sample}}/repeatmasker/contigs.masked.fasta"
    params:
        env_path = ENVS["marine"]
    threads: 1
    log: f"{OUTPUT_DIR}/{{sample}}/logs/repeatmasker.log"
    shell:
        """
        export PATH={params.env_path}/bin:$PATH
        mkdir -p $(dirname {output.masked_fasta}) $(dirname {log})
        if [ -n "${{LIBNSL_DIR:-}}" ] && [ -d "${{LIBNSL_DIR}}" ]; then
            export LD_LIBRARY_PATH="${{LIBNSL_DIR}}:$LD_LIBRARY_PATH"
        fi
        RepeatMasker -species all -gff \
            -dir $(dirname {output.masked_fasta}) {input.contigs} &> {log}
        MASKED_SRC="$(dirname {output.masked_fasta})/$(basename {input.contigs}).masked"
        if [ -f "$MASKED_SRC" ] && [ "$MASKED_SRC" != "{output.masked_fasta}" ]; then
            mv "$MASKED_SRC" {output.masked_fasta}
        elif [ ! -f "{output.masked_fasta}" ]; then
            cp {input.contigs} {output.masked_fasta}
        fi
        """


# ─────────────────────────────────────────────────────────────────────────────
#  STEP 23  —  HADEG
#  FIX v2: added proteinortho and Rscript binary existence checks — rule now
#           exits with error (exit 1) if either tool is missing, rather than
#           silently running nothing and touching the done flag.
#  FIX v2: added HADEG DB and Rscript file existence checks before run.
#  FIX v2: done_flag is now only touched after confirming proteinortho produced
#           Results_HADEG.* output files — no more blind unconditional touch.
#  FIX v2: added -cpus flag to proteinortho for multi-threading.
#  FIX v2: Rscript failure is logged as WARNING (not fatal) — proteinortho
#           results are still valid even if R plots fail due to missing packages.
#  FIX v3: Rscript is NOT installed inside the hadeg conda env — it lives in a
#           separate R env or in base. The shell block now auto-discovers Rscript
#           by searching all conda envs under ~/.conda/envs, then falls back to
#           the system PATH. This avoids the hard exit 1 on missing Rscript.
# ─────────────────────────────────────────────────────────────────────────────

rule hadeg:
    #  FIX v4 — three bugs corrected from the log:
    #
    #  1. CRITICAL: '-evalue=1e-5' is not a valid proteinortho flag.
    #     The correct flag is '-e=1e-5'.  The log showed:
    #       [Error] Invalid command line option: '-evalue=1e-5'!
    #     proteinortho printed its full usage and exited — producing zero output.
    #
    #  2. Flags must come BEFORE file arguments.  proteinortho silently ignores
    #     options that appear after the positional FASTA arguments in some
    #     versions, so -identity=30 / -conn=0.1 were being ignored, causing
    #     the run to use defaults (identity 25%, e=1e-5 default, etc.).
    #
    #  3. LOG_ABS stored before 'cd' so >> {log} never silently misdirects
    #     after the working-directory changes.  FAA path captured via realpath
    #     before cd so 'cp' always finds the file.
    #
    #  4. Output guard checks Results_HADEG.proteinortho specifically (the
    #     primary output file) rather than a glob, which is safer inside a
    #     subshell after cd.
    input:
        faa = rules.prokka.output.faa
    output:
        done_flag = f"{OUTPUT_DIR}/{{sample}}/hadeg/hadeg_done.flag"
    params:
        hadeg_db      = HADEG_DB,
        hadeg_rscript = HADEG_RSCRIPT,
        outdir        = f"{OUTPUT_DIR}/{{sample}}/hadeg",
        env_path      = ENVS["hadeg"],
        conda_envs    = os.path.expanduser("~/.conda/envs")
    threads: 4
    log: f"{OUTPUT_DIR}/{{sample}}/logs/hadeg.log"
    shell:
        """
        export PATH={params.env_path}/bin:$PATH
        mkdir -p {params.outdir} $(dirname {log})

        # FIX: capture absolute paths BEFORE cd changes working directory
        LOG_ABS=$(realpath {log})
        FAA_ABS=$(realpath {input.faa})

        echo "[HADEG] Started for {wildcards.sample}"         > "$LOG_ABS"
        echo "[HADEG] Input FAA    : $FAA_ABS"               >> "$LOG_ABS"
        echo "[HADEG] HADEG DB     : {params.hadeg_db}"      >> "$LOG_ABS"
        echo "[HADEG] Outdir       : {params.outdir}"        >> "$LOG_ABS"
        echo "[HADEG] Sequences    : $(grep -c '^>' "$FAA_ABS" 2>/dev/null || echo 0)" >> "$LOG_ABS"

        # ── Check proteinortho ─────────────────────────────
        if ! command -v proteinortho &>/dev/null; then
            echo "[HADEG] WARNING: proteinortho not found in {params.env_path}/bin. Marking HADEG done." >> "$LOG_ABS"
            touch {output.done_flag}
            exit 0
        fi
        echo "[HADEG] proteinortho: $(which proteinortho)" >> "$LOG_ABS"
        if ! command -v diamond &>/dev/null; then
            echo "[HADEG] WARNING: DIAMOND not found in {params.env_path}/bin. Marking HADEG done." >> "$LOG_ABS"
            touch {output.done_flag}
            exit 0
        fi
        echo "[HADEG] diamond: $(which diamond)" >> "$LOG_ABS"

        # ── Locate Rscript (not always in hadeg env) ───────
        RSCRIPT_BIN=""
        if command -v Rscript &>/dev/null; then
            RSCRIPT_BIN=$(which Rscript)
            echo "[HADEG] Rscript in PATH: $RSCRIPT_BIN" >> "$LOG_ABS"
        else
            echo "[HADEG] Rscript not in PATH — searching conda envs..." >> "$LOG_ABS"
            RSCRIPT_BIN=$(find {params.conda_envs} -maxdepth 3 -name "Rscript" -type f 2>/dev/null | head -1 || true)
            if [ -n "$RSCRIPT_BIN" ]; then
                echo "[HADEG] Rscript found: $RSCRIPT_BIN" >> "$LOG_ABS"
            else
                echo "[HADEG] WARNING: Rscript not found — plots will be skipped" >> "$LOG_ABS"
            fi
        fi

        # ── Check DB exists ────────────────────────────────
        if [ ! -f "{params.hadeg_db}" ]; then
            echo "[HADEG] WARNING: HADEG DB not found: {params.hadeg_db}. Marking done." >> "$LOG_ABS"
            touch {output.done_flag}
            exit 0
        fi
        if [ ! -f "{params.hadeg_rscript}" ]; then
            echo "[HADEG] WARNING: HADEG.R not found: {params.hadeg_rscript}. Continuing without R post-processing." >> "$LOG_ABS"
        fi

        # ── cd into outdir so proteinortho and HADEG.R write files here ───
        cd {params.outdir}
        cp "$FAA_ABS" annotated_genome.faa

        echo "[HADEG] CWD: $(pwd)" >> "$LOG_ABS"
        echo "[HADEG] Running proteinortho..." >> "$LOG_ABS"

        # FIX 1: '-evalue=' is not a valid flag — correct flag is '-e='
        # FIX 2: all flags BEFORE the FASTA file arguments
        proteinortho \
            -project=Results_HADEG \
            -identity=30 \
            -conn=0.1 \
            -e=1e-5 \
            -p=diamond \
            -cpus={threads} \
            annotated_genome.faa {params.hadeg_db} \
            >> "$LOG_ABS" 2>&1 || true

        POSTAT=$?
        echo "[HADEG] proteinortho exit code: $POSTAT" >> "$LOG_ABS"

        # FIX 4: check for the primary output file specifically
        if [ ! -f "Results_HADEG.proteinortho" ]; then
            echo "[HADEG] WARNING: Results_HADEG.proteinortho not produced. Continuing without HADEG hits." >> "$LOG_ABS"
            echo "[HADEG] Files present: $(ls -1 {params.outdir}/ 2>/dev/null || echo none)" >> "$LOG_ABS"
            touch {output.done_flag}
            exit 0
        fi

        NHITS=$(tail -n +2 Results_HADEG.proteinortho | grep -vc '^\*' 2>/dev/null || echo 0)
        echo "[HADEG] Orthogroups with hits: $NHITS" >> "$LOG_ABS"

        # ── Run R script (optional) ───────────────────────
        if [ -n "$RSCRIPT_BIN" ] && [ -f "{params.hadeg_rscript}" ]; then
            echo "[HADEG] Running HADEG.R..." >> "$LOG_ABS"
            "$RSCRIPT_BIN" {params.hadeg_rscript} >> "$LOG_ABS" 2>&1
            RSTAT=$?
            if [ "$RSTAT" -ne 0 ]; then
                echo "[HADEG] WARNING: Rscript failed (exit $RSTAT) — check R packages:" >> "$LOG_ABS"
                echo "[HADEG]   ggplot2, dplyr, reshape2, pheatmap, RColorBrewer" >> "$LOG_ABS"
            else
                echo "[HADEG] Rscript completed successfully." >> "$LOG_ABS"
            fi
        else
            echo "[HADEG] WARNING: Rscript not found — skipping plots." >> "$LOG_ABS"
        fi

        touch {output.done_flag}
        echo "[HADEG] Done." >> "$LOG_ABS"
        """
        
# ─────────────────────────────────────────────────────────────────────────────
#  STEP 24  —  FINAL REPORT
# ─────────────────────────────────────────────────────────────────────────────

rule final_report:
    input:
        decision     = rules.pipeline_decision.output.log_out,
        nanoplot     = rules.nanoplot.output.stats,
        quast        = rules.quast.output.report,
        busco        = rules.busco.output.summary,
        checkm       = rules.checkm.output.summary,
        fastani      = rules.fastani.output.ani_result,
        prokka       = rules.prokka.output.gff,
        interpro     = rules.interproscan.output.tsv,
        kofamscan    = rules.kofamscan.output.kofamscan_results,
        dbcan        = rules.dbcan.output.overview,
        crispr       = rules.cctyper.output.summary,
        antismash    = rules.antismash.output.antismash_results,
        eggnog       = rules.eggnog_mapper.output.annotations,
        repeatmasker = rules.repeatmasker.output.masked_fasta,
        hadeg        = rules.hadeg.output.done_flag,
        barrnap      = rules.barrnap_16s.output.fasta,
        blast_16s    = rules.blast_16s.output.blast_out
    output:
        report = f"{OUTPUT_DIR}/{{sample}}/final_report.txt"
    log: f"{OUTPUT_DIR}/{{sample}}/logs/final_report.log"
    shell:
        """
        mkdir -p $(dirname {output.report}) $(dirname {log})
        {{
          echo "============================================================"
          echo "     ADAPTIVE LONG-READ WGS PIPELINE  --  FINAL REPORT"
          echo "============================================================"
          echo "  Sample  : {wildcards.sample}"
          echo "  Date    : $(date)"
          echo "============================================================"

          echo ""
          echo "== PIPELINE DECISION (coverage / read-type / trimming) =="
          cat {input.decision}

          echo ""
          echo "== NANOPLOT READ STATISTICS =="
          cat {input.nanoplot}

          echo ""
          echo "== QUAST ASSEMBLY REPORT =="
          echo "  Full HTML report: {input.quast}"

          echo ""
          echo "== BUSCO COMPLETENESS =="
          [ -f {input.busco} ]    && cat {input.busco}         || echo "  Not found"

          echo ""
          echo "== CHECKM QUALITY (first 20 lines) =="
          [ -f {input.checkm} ]  && head -20 {input.checkm}  || echo "  Not found"

          echo ""
          echo "== FASTANI SPECIES ID (top 10) =="
          [ -f {input.fastani} ]  && head -10 {input.fastani} || echo "  Not found"

          echo ""
          echo "== CRISPR SUMMARY (top 20 lines) =="
          [ -f {input.crispr} ]   && head -20 {input.crispr}  || echo "  Not found"

          echo ""
          echo "== ANTISMASH BGC HITS (top 20 lines) =="
          [ -f {input.antismash} ] && head -20 {input.antismash} || echo "  Not found"

          echo ""
          echo "== REPEATMASKER =="
          [ -f {input.repeatmasker} ] && echo "  Masked FASTA created: {input.repeatmasker}" || echo "  Not found"

          echo ""
          echo "== HADEG HYDROCARBON DEGRADATION =="
          [ -f {input.hadeg} ] \
              && echo "  Completed -- see $(dirname {input.hadeg})/" \
              || echo "  Not found"

          echo ""
          echo "== BARRNAP 16S rRNA =="
          if [ -s {input.barrnap} ]; then
              echo "  Sequences found: $(grep -c '>' {input.barrnap})"
          else
              echo "  No 16S rRNA genes detected"
          fi

          echo ""
          echo "== 16S BLAST IDENTIFICATION (SILVA) =="
          if [ -s {input.blast_16s} ]; then
              echo "  qseqid  sseqid  pident  length  evalue  bitscore  taxonomy"
              head -5 {input.blast_16s}
          else
              echo "  No BLAST hits or skipped"
          fi

          echo ""
          echo "== OUTPUT FILE LOCATIONS =="
          echo "  Prokka GFF       : {input.prokka}"
          echo "  InterProScan TSV : {input.interpro}"
          echo "  KofamScan TSV    : {input.kofamscan}"
          echo "  dbCAN overview   : {input.dbcan}"
          echo "  EggNOG annots    : {input.eggnog}"
          echo "  RepeatMasker     : {input.repeatmasker}"
          echo "  HADEG flag       : {input.hadeg}"
          echo "  Barrnap 16S FASTA: {input.barrnap}"
          echo "  16S BLAST results: {input.blast_16s}"
        }} > {output.report} 2> {log}
        """


