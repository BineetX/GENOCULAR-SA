def get_reads(wildcards):
    """Return the full path to raw reads for a sample (from R0 column)."""
    row      = samples_df.loc[samples_df["sample"] == wildcards.sample]
    filename = row["R0"].values[0]

    candidates = [filename]
    if not any(filename.endswith(ext) for ext in (".fastq", ".fq")):
        candidates.append(filename + ".fastq")
        candidates.append(filename + ".fq")

    for candidate in candidates:
        path = f"{BASE_PATH}/{candidate}"
        if os.path.exists(path):
            return path
        path2 = f"{BASE_PATH}/{wildcards.sample}/{candidate}"
        if os.path.exists(path2):
            return path2

    tried = "\n  ".join(f"{BASE_PATH}/{c}" for c in candidates)
    raise FileNotFoundError(
        f"[ERROR] Reads not found for sample '{wildcards.sample}'.\n"
        f"Tried:\n  {tried}\n"
        f"Check that the R0 column in samples_long.csv matches an actual file under {BASE_PATH}"
    )


def declared_read_type(wildcards):
    """Return user-declared read_type from CSV, or empty string if absent."""
    if "read_type" in samples_df.columns:
        rt = samples_df.loc[samples_df["sample"] == wildcards.sample, "read_type"].values
        if len(rt) > 0 and pd.notna(rt[0]):
            return str(rt[0]).strip()
    return ""


def declared_genome_size(wildcards):
    """Return genome_size from CSV (e.g. '3m'), default '3m'."""
    if "genome_size" in samples_df.columns:
        gs = samples_df.loc[samples_df["sample"] == wildcards.sample, "genome_size"].values
        if len(gs) > 0 and pd.notna(gs[0]):
            return str(gs[0]).strip()
    return "3m"


def genome_size_bp(gs_str):
    """Convert '3m' / '2.5m' / '4500k' → integer base-pairs."""
    gs = str(gs_str).strip().lower()
    if gs.endswith("m"):
        return int(float(gs[:-1]) * 1_000_000)
    if gs.endswith("k"):
        return int(float(gs[:-1]) * 1_000)
    return int(gs)


