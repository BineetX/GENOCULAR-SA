        """


# ─────────────────────────────────────────────────────────────────────────────
#  STEP 12a  —  BARRNAP
# ─────────────────────────────────────────────────────────────────────────────

rule barrnap_16s:
    input:
        contigs = rules.finalize_assembly.output.final_polished
    output:
        gff   = f"{OUTPUT_DIR}/{{sample}}/barrnap/contigs_16s.gff",
        fasta = f"{OUTPUT_DIR}/{{sample}}/barrnap/contigs_16s.fasta"
    params:
        env_path = ENVS["barrnap"]
    threads: 2
    log: f"{OUTPUT_DIR}/{{sample}}/logs/barrnap.log"
    shell:
        """
        export PATH={params.env_path}/bin:$PATH
        mkdir -p $(dirname {output.gff}) $(dirname {log})

        barrnap --kingdom bac --threads {threads} {input.contigs} \
            2>> {log} | grep "16S_rRNA" > {output.gff} || true

        if [ ! -s {output.gff} ]; then
            echo "[Barrnap] No 16S rRNA genes detected in {wildcards.sample}" | tee -a {log}
            touch {output.fasta}
        else
            bedtools getfasta \
                -fi {input.contigs} \
                -bed {output.gff} \
                -fo {output.fasta} 2>> {log}
            echo "[Barrnap] 16S sequences extracted: $(grep -c '>' {output.fasta})" | tee -a {log}
        fi
        """


# ─────────────────────────────────────────────────────────────────────────────
#  STEP 12b  —  16S BLAST
# ─────────────────────────────────────────────────────────────────────────────

rule blast_16s:
    input:
        fasta_16s = rules.barrnap_16s.output.fasta
    output:
        blast_out = f"{OUTPUT_DIR}/{{sample}}/blast_16s/blast_16s_results.txt"
    params:
        db       = SILVA_BLAST_DB,
        outdir   = f"{OUTPUT_DIR}/{{sample}}/blast_16s",
        env_path = ENVS["marine"]
    threads: 4
    log: f"{OUTPUT_DIR}/{{sample}}/logs/blast_16s.log"
    shell:
        """
        export PATH={params.env_path}/bin:$PATH
        mkdir -p {params.outdir} $(dirname {log})

        if [ ! -s {input.fasta_16s} ]; then
            echo "[BLAST 16S] No 16S sequences found in {wildcards.sample} — skipping BLAST" | tee {log}
            echo "# No 16S sequences detected by barrnap — BLAST skipped" > {output.blast_out}
        else
            echo "[BLAST 16S] Running BLASTn against SILVA for {wildcards.sample}" | tee {log}
            blastn \
                -query {input.fasta_16s} \
                -db {params.db} \
                -out {output.blast_out} \
                -outfmt "6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore stitle" \
                -num_threads {threads} \
                -max_target_seqs 5 \
                -perc_identity 80 \
                -evalue 1e-10 \
                -task blastn \
                &>> {log}

            if [ ! -s {output.blast_out} ]; then
                echo "# No significant BLAST hits found" > {output.blast_out}
            fi

            echo "[BLAST 16S] Top hits for {wildcards.sample}:" | tee -a {log}
            head -5 {output.blast_out} | tee -a {log}
        fi
        """


# ─────────────────────────────────────────────────────────────────────────────
#  STEP 12c  —  FASTANI
#  FIX v2: fixed SILVA stitle (col 13) species parsing — previous awk split on
#           ';' and took $NF which included strain info or returned empty strings.
#           Now extracts text after the last semicolon and takes first two words
#           (Genus species), filtering uncultured/unclassified entries.
#  FIX v2: added genus-level fallback when no species-level hits are parseable.
#  FIX v2: improved fastANI binary and ncbi-genome-download not-found messages
#           to include diagnostic hints (path checked, install command).
# ─────────────────────────────────────────────────────────────────────────────

rule fastani:
    input:
        contigs   = rules.finalize_assembly.output.final_polished,
        blast_16s = rules.blast_16s.output.blast_out
    output:
        ani_result = f"{OUTPUT_DIR}/{{sample}}/fastani/fastani_results.txt"
    params:
        fastani_env = ENVS["fastani"],
        ncbi_env    = ENVS["ncbi"],
        outdir      = f"{OUTPUT_DIR}/{{sample}}/fastani",
        ref_dir     = f"{OUTPUT_DIR}/{{sample}}/fastani/ref_genomes"
    threads: 4
    log: f"{OUTPUT_DIR}/{{sample}}/logs/fastani.log"
    shell:
        r"""
        mkdir -p {params.outdir} {params.ref_dir} $(dirname {log})

        export PATH={params.fastani_env}/bin:{params.ncbi_env}/bin:$PATH

        # ── Log start ────────────────────────────────────────────────────────
        echo "[FastANI] Started for sample {wildcards.sample}" > {log}
        echo "[FastANI] fastani_env : {params.fastani_env}"   >> {log}
        echo "[FastANI] ncbi_env    : {params.ncbi_env}"      >> {log}

        FASTANI_BIN="{params.fastani_env}/bin/fastANI"
        [ -x "$FASTANI_BIN" ] || FASTANI_BIN=$(which fastANI 2>/dev/null || true)
        if [ ! -x "$FASTANI_BIN" ]; then
            echo "[FastANI] ERROR: fastANI binary not found in {params.fastani_env}/bin or PATH." >> {log}
            echo "[FastANI] Check: ls {params.fastani_env}/bin/fastANI" >> {log}
            echo "# fastANI not found — skipping" > {output.ani_result}
            exit 0
        fi
        echo "[FastANI] Binary: $FASTANI_BIN" >> {log}

        NGD_BIN="{params.ncbi_env}/bin/ncbi-genome-download"
        [ -x "$NGD_BIN" ] || NGD_BIN=$(which ncbi-genome-download 2>/dev/null || true)
        if [ ! -x "$NGD_BIN" ]; then
            echo "[FastANI] ERROR: ncbi-genome-download not found in {params.ncbi_env}/bin or PATH." >> {log}
            echo "[FastANI] Install with: conda install -n ncbi_env -c bioconda ncbi-genome-download" >> {log}
            echo "# ncbi-genome-download not found — FastANI skipped" > {output.ani_result}
            exit 0
        fi
        echo "[FastANI] ncbi-genome-download: $NGD_BIN" >> {log}

        echo "[FastANI] Parsing top BLAST hits from {input.blast_16s}" >> {log}

        # FIX: SILVA stitle (col 13) format is "taxonomy;Genus species strain"
        # Previous awk split on ';' and took $NF which often included strain info
        # or produced empty strings. Now we extract the first two words after the
        # last semicolon, which reliably gives "Genus species".
        SPECIES_LIST=$(grep -v '^#' "{input.blast_16s}" | head -5 \
            | awk -F'\t' 'NF>=13 {{print $13}}' \
            | sed 's/.*;//' \
            | sed 's/^ *//; s/ *$//' \
            | awk 'NF>=2 {{print $1" "$2}}' \
            | grep -vE '^ *$|^[Uu]ncultured|^[Uu]nclassified|^[Ee]nvironmental' \
            | sort -u || true)

        echo "[FastANI] Parsed species list:" >> {log}
        echo "$SPECIES_LIST" >> {log}

        if [ -z "$SPECIES_LIST" ]; then
            echo "[FastANI] No species-level BLAST hits — trying genus level." >> {log}
            # Fallback: take just the genus name from stitle
            SPECIES_LIST=$(grep -v '^#' "{input.blast_16s}" | head -5 \
                | awk -F'\t' 'NF>=13 {{print $13}}' \
                | sed 's/.*;//' \
                | sed 's/^ *//; s/ *$//' \
                | awk 'NF>=1 {{print $1}}' \
                | grep -vE '^ *$|^[Uu]ncultured|^[Uu]nclassified|^[Ee]nvironmental' \
                | sort -u || true)
        fi

        if [ -z "$SPECIES_LIST" ]; then
            echo "[FastANI] No BLAST hits — cannot auto-select reference genomes." >> {log}
            echo "# No BLAST hits to drive reference selection — FastANI skipped" > {output.ani_result}
            exit 0
        fi

        echo "[FastANI] Species to download references for:" >> {log}
        echo "$SPECIES_LIST" >> {log}

        while IFS= read -r SPECIES; do
            [ -z "$SPECIES" ] && continue
            SAFE=$(echo "$SPECIES" | tr ' ' '_' | tr -cd 'A-Za-z0-9_-')
            SPECIES_DIR="{params.ref_dir}/$SAFE"

            if [ -d "$SPECIES_DIR" ] && \
               [ "$(find "$SPECIES_DIR" -maxdepth 1 -name '*.fna' 2>/dev/null | wc -l)" -gt 0 ]; then
                echo "[FastANI] Using cached genomes for '$SPECIES'" >> {log}
            else
                mkdir -p "$SPECIES_DIR"
                echo "[FastANI] Downloading genomes for '$SPECIES' ..." >> {log}
                "$NGD_BIN" bacteria \
                    -g "$SPECIES" \
                    -F fasta \
                    -l complete,chromosome,scaffold \
                    -R reference,representative \
                    -o "$SPECIES_DIR" \
                    --flat-output \
                    -r 3 \
                    2>> {log} || \
                    echo "[FastANI] WARNING: download non-zero for '$SPECIES' — continuing" >> {log}
                find "$SPECIES_DIR" -name "*.fna.gz" -exec gunzip -f {{}} \; 2>> {log} || true
                NFNA=$(find "$SPECIES_DIR" -name "*.fna" | wc -l)
                echo "[FastANI] Downloaded $NFNA FASTA file(s) for '$SPECIES'" >> {log}
            fi
        done <<< "$SPECIES_LIST"

        REF_LIST="{params.outdir}/ref_list.txt"
        find {params.ref_dir} -name "*.fna" > "$REF_LIST"

        NREF=$(wc -l < "$REF_LIST")
        if [ "$NREF" -eq 0 ]; then
            echo "[FastANI] No reference FASTAs found — FastANI skipped." >> {log}
            echo "# No reference genomes downloaded — FastANI skipped" > {output.ani_result}
            exit 0
        fi
        echo "[FastANI] Total reference genomes: $NREF" >> {log}

        QUERY_LIST="{params.outdir}/query_list.txt"
        echo "{input.contigs}" > "$QUERY_LIST"

        echo "[FastANI] Running fastANI ..." >> {log}
        "$FASTANI_BIN" \
            --ql "$QUERY_LIST" \
            --rl "$REF_LIST" \
            -t   {threads} \
            -o   {output.ani_result} >> {log} 2>&1 || true

        if [ -s {output.ani_result} ]; then
            TMP_SORT="{params.outdir}/ani_sorted_tmp.txt"
            echo -e "# FastANI results for {wildcards.sample}" > "$TMP_SORT"
            echo -e "# Columns: query\treference\tANI\tbi-directional_fragments\ttotal_fragments" >> "$TMP_SORT"
            sort -t$'\t' -k3 -nr {output.ani_result} >> "$TMP_SORT"
            mv "$TMP_SORT" {output.ani_result}
            echo "[FastANI] Done. Top 5 results:" >> {log}
            grep -v '^#' {output.ani_result} | head -5 >> {log}
        else
            echo "# No ANI results above threshold" > {output.ani_result}
            echo "[FastANI] No ANI results above threshold." >> {log}
        fi
        """


