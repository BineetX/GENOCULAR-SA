        mkdir -p $(dirname {output.report}) $(dirname {log})
        kraken2 \
            --db        {params.db_path} \
            --threads   {threads} \
            --long-reads \
            --use-names \
            --report    {output.report} \
            --output    {output.kout} \
            {input.reads} &> {log}
        """


# ─────────────────────────────────────────────────────────────────────────────
#  STEP 5  —  EXTRACT BACTERIAL READS
# ─────────────────────────────────────────────────────────────────────────────

rule kraken_extract:
    input:
        kout  = rules.kraken_classify.output.kout,
