            exit 1
        fi

        echo "[FastQC] Using: $FASTQC_BIN" | tee {log}
        fastqc -t {threads} -o {params.outdir} {input.R1} {input.R2} &>> {log}
        """

# ─────────────────────────────────────────────────────────────
# STEP 1: Adaptive Trimmomatic
# ─────────────────────────────────────────────────────────────
rule trimmomatic:
    input:
        R1 = lambda wildcards: get_sample_fastq(wildcards, 'R1'),
        R2 = lambda wildcards: get_sample_fastq(wildcards, 'R2'),
        qc_zip = rules.fastqc_raw.output.zip_R1
    output:
        paired_R1 = f"{base_path}/Combine/{{sample}}/{{sample}}_R1_paired.fastq",
        unpaired_R1 = f"{base_path}/Combine/{{sample}}/{{sample}}_R1_unpaired.fastq",
        paired_R2 = f"{base_path}/Combine/{{sample}}/{{sample}}_R2_paired.fastq",
        unpaired_R2 = f"{base_path}/Combine/{{sample}}/{{sample}}_R2_unpaired.fastq"
    params:
        adapter_file = adapter_file,
        env_path = CONDA_ENVS["marine"]
    threads: 4
    log:
        f"{base_path}/Combine/{{sample}}/logs/trimmomatic.log"
    shell:
        """
        set -euo pipefail
        export PATH={params.env_path}/bin:$PATH
        mkdir -p $(dirname {output.paired_R1}) $(dirname {log})

        TMPDIR_QC=$(mktemp -d)
        unzip -q {input.qc_zip} -d "$TMPDIR_QC"
        QC_DATA=$(find "$TMPDIR_QC" -name "fastqc_data.txt" | head -1)

        MEAN_Q=$(awk '/>>Per base sequence quality/,/>>END_MODULE/' "$QC_DATA" \
                 | grep -v '^#' | grep -v '>>' \
                 | awk '{{sum+=$2; n++}} END{{if(n>0) printf "%d", sum/n; else print 20}}')

        ADAPT_PCT=$(awk '/>>Adapter Content/,/>>END_MODULE/' "$QC_DATA" \
                    | grep -v '^#' | grep -v '>>' \
                    | awk 'NR==1{{max=$2; for(i=3;i<=NF;i++) if($i>max) max=$i}} END{{printf "%d", max+0}}')

        GC=$(awk '/>>Basic Statistics/,/>>END_MODULE/' "$QC_DATA" \
             | awk -F'\t' '$1=="%GC"{{print $2}}')
        GC=${{GC:-50}}

        rm -rf "$TMPDIR_QC"

        if [ "$MEAN_Q" -lt 20 ]; then
            SW="SLIDINGWINDOW:4:15"
            LEADING="LEADING:5"
            TRAILING="TRAILING:5"
        elif [ "$MEAN_Q" -lt 28 ]; then
            SW="SLIDINGWINDOW:4:20"
            LEADING="LEADING:3"
            TRAILING="TRAILING:3"
        else
            SW="SLIDINGWINDOW:4:25"
            LEADING="LEADING:3"
            TRAILING="TRAILING:3"
        fi

        if [ "$GC" -gt 60 ]; then
            MINLEN="MINLEN:36"
        else
            MINLEN="MINLEN:50"
        fi

        if [ "$ADAPT_PCT" -gt 1 ]; then
            CLIP="ILLUMINACLIP:{params.adapter_file}:2:30:10"
        else
            CLIP=""
        fi

        echo "[Trimmomatic] MeanQ=$MEAN_Q AdapterPct=$ADAPT_PCT GC=$GC" | tee -a {log}
        echo "[Trimmomatic] SW=$SW LEADING=$LEADING TRAILING=$TRAILING MINLEN=$MINLEN CLIP=$CLIP" | tee -a {log}

        java -jar {trimmomatic_jar} PE -phred33 -threads {threads} \
            {input.R1} {input.R2} \
            {output.paired_R1} {output.unpaired_R1} \
            {output.paired_R2} {output.unpaired_R2} \
            $CLIP $LEADING $TRAILING $SW $MINLEN &>> {log}
        """

# ─────────────────────────────────────────────────────────────
# STEP 2: Adaptive Cutadapt
# ─────────────────────────────────────────────────────────────
rule cutadapt_paired:
    input:
        paired_R1 = rules.trimmomatic.output.paired_R1,
        paired_R2 = rules.trimmomatic.output.paired_R2,
        qc_zip = rules.fastqc_raw.output.zip_R1
    output:
        trimmed_R1 = f"{base_path}/Combine/{{sample}}/{{sample}}_R1_trimmed.fastq",
        trimmed_R2 = f"{base_path}/Combine/{{sample}}/{{sample}}_R2_trimmed.fastq"
    params:
        env_path = CONDA_ENVS["cutadapt"]
    threads: 4
    log:
        f"{base_path}/Combine/{{sample}}/logs/cutadapt_paired.log"
    shell:
        """
        set -euo pipefail
        export PATH={params.env_path}/bin:$PATH
        mkdir -p $(dirname {output.trimmed_R1}) $(dirname {log})

        TMPDIR_QC=$(mktemp -d)
        unzip -q {input.qc_zip} -d "$TMPDIR_QC"
        QC_DATA=$(find "$TMPDIR_QC" -name "fastqc_data.txt" | head -1)

        MEAN_Q=$(awk '/>>Per base sequence quality/,/>>END_MODULE/' "$QC_DATA" \
                 | grep -v '^#' | grep -v '>>' \
                 | awk '{{sum+=$2; n++}} END{{if(n>0) printf "%d", sum/n; else print 20}}')

        ADAPT_PCT=$(awk '/>>Adapter Content/,/>>END_MODULE/' "$QC_DATA" \
                    | grep -v '^#' | grep -v '>>' \
                    | awk 'NR==1{{max=$2; for(i=3;i<=NF;i++) if($i>max) max=$i}} END{{printf "%d", max+0}}')

        rm -rf "$TMPDIR_QC"

        if [ "$ADAPT_PCT" -le 1 ]; then
            echo "[Cutadapt] Adapter content $ADAPT_PCT% <= 1% — skipping" | tee -a {log}
            ln -sf $(realpath {input.paired_R1}) {output.trimmed_R1}
            ln -sf $(realpath {input.paired_R2}) {output.trimmed_R2}
        else
            if [ "$MEAN_Q" -lt 20 ]; then Q_CUT=15
            elif [ "$MEAN_Q" -lt 28 ]; then Q_CUT=20
            else Q_CUT=25; fi

            echo "[Cutadapt] Adapter content $ADAPT_PCT% QualityCutoff=$Q_CUT" | tee -a {log}
            cutadapt -q $Q_CUT -j {threads} \
                -o {output.trimmed_R1} -p {output.trimmed_R2} \
                {input.paired_R1} {input.paired_R2} &>> {log}
        fi
        """


# ─────────────────────────────────────────────────────────────
# STEP 3: Adaptive Seqtk
# ─────────────────────────────────────────────────────────────
rule seqtk_trim:
    input:
        trimmed_R1 = rules.cutadapt_paired.output.trimmed_R1,
        trimmed_R2 = rules.cutadapt_paired.output.trimmed_R2,
        qc_zip     = f"{base_path}/Combine/{{sample}}/fastqc_raw/{{sample}}_R1_fastqc.zip"
    output:
        trimmed_R1_seqtk = f"{base_path}/Combine/{{sample}}/{{sample}}_R1_seqtk_trimmed.fastq",
        trimmed_R2_seqtk = f"{base_path}/Combine/{{sample}}/{{sample}}_R2_seqtk_trimmed.fastq"
    params:
        env_path = CONDA_ENVS["marine"]
    threads: 2
    log:
        f"{base_path}/Combine/{{sample}}/logs/seqtk_trim.log"
    shell:
        """
        export PATH={params.env_path}/bin:$PATH
        mkdir -p $(dirname {output.trimmed_R1_seqtk}) $(dirname {log})

        TMPDIR_QC=$(mktemp -d)
        unzip -q {input.qc_zip} -d "$TMPDIR_QC"
        QC_DATA=$(find "$TMPDIR_QC" -name "fastqc_data.txt" | head -1)
        MEAN_Q=$(awk '/>>Per base sequence quality/,/>>END_MODULE/' "$QC_DATA" \
                 | grep -v '^#' | grep -v '>>' \
                 | awk '{{sum+=$2; n++}} END{{if(n>0) printf "%d", sum/n; else print 20}}')
        rm -rf "$TMPDIR_QC"

        if [ "$MEAN_Q" -ge 28 ]; then
            echo "[Seqtk] High-quality (Q=$MEAN_Q) — skipping, symlinking" | tee -a {log}
            ln -sf $(realpath {input.trimmed_R1}) {output.trimmed_R1_seqtk}
            ln -sf $(realpath {input.trimmed_R2}) {output.trimmed_R2_seqtk}
        else
            Q_TRIM=$(( MEAN_Q < 20 ? 15 : 20 ))
            echo "[Seqtk] Trimming with quality threshold $Q_TRIM" | tee -a {log}
            seqtk trimfq -q 0.$(( 100 - Q_TRIM )) {input.trimmed_R1} > {output.trimmed_R1_seqtk} 2>> {log}
            seqtk trimfq -q 0.$(( 100 - Q_TRIM )) {input.trimmed_R2} > {output.trimmed_R2_seqtk} 2>> {log}
        fi
        """


# ─────────────────────────────────────────────────────────────
# STEP 4: Adaptive BBDuk
# ─────────────────────────────────────────────────────────────
rule bbduk:
    input:
        trimmed_R1_seqtk = rules.seqtk_trim.output.trimmed_R1_seqtk,
        trimmed_R2_seqtk = rules.seqtk_trim.output.trimmed_R2_seqtk,
        qc_zip           = f"{base_path}/Combine/{{sample}}/fastqc_raw/{{sample}}_R1_fastqc.zip"
    output:
        cleaned_R1 = f"{base_path}/Combine/{{sample}}/{{sample}}_R1_bbduk_cleaned.fastq",
        cleaned_R2 = f"{base_path}/Combine/{{sample}}/{{sample}}_R2_bbduk_cleaned.fastq"
    params:
        env_path = CONDA_ENVS["marine"]
    threads: 4
    log:
        f"{base_path}/Combine/{{sample}}/logs/bbduk.log"
    shell:
        """
        export PATH={params.env_path}/bin:$PATH
        mkdir -p $(dirname {output.cleaned_R1}) $(dirname {log})

        TMPDIR_QC=$(mktemp -d)
        unzip -q {input.qc_zip} -d "$TMPDIR_QC"
        QC_DATA=$(find "$TMPDIR_QC" -name "fastqc_data.txt" | head -1)
        MEAN_Q=$(awk '/>>Per base sequence quality/,/>>END_MODULE/' "$QC_DATA" \
                 | grep -v '^#' | grep -v '>>' \
                 | awk '{{sum+=$2; n++}} END{{if(n>0) printf "%d", sum/n; else print 20}}')
        rm -rf "$TMPDIR_QC"

        if [ "$MEAN_Q" -ge 28 ]; then
            echo "[BBDuk] High-quality (Q=$MEAN_Q) — skipping, symlinking" | tee -a {log}
            ln -sf $(realpath {input.trimmed_R1_seqtk}) {output.cleaned_R1}
            ln -sf $(realpath {input.trimmed_R2_seqtk}) {output.cleaned_R2}
        elif [ "$MEAN_Q" -lt 20 ]; then
            echo "[BBDuk] Low-quality (Q=$MEAN_Q) — full cleaning with entropy filter" | tee -a {log}
            bbduk.sh \
                in={input.trimmed_R1_seqtk} in2={input.trimmed_R2_seqtk} \
                out={output.cleaned_R1} out2={output.cleaned_R2} \
                ref=adapters ktrim=r k=23 mink=11 hdist=1 tpe tbo \
                entropy=0.5 entropywindow=50 entropyk=5 \
                qtrim=rl trimq=15 &>> {log}
        else
            echo "[BBDuk] Standard quality (Q=$MEAN_Q) — k-mer adapter removal only" | tee -a {log}
            bbduk.sh \
                in={input.trimmed_R1_seqtk} in2={input.trimmed_R2_seqtk} \
                out={output.cleaned_R1} out2={output.cleaned_R2} \
                ref=adapters ktrim=r k=23 mink=11 hdist=1 tpe tbo &>> {log}
        fi
        """


