# ─────────────────────────────────────────────────────────────
# STEP 12: BUSCO
# ─────────────────────────────────────────────────────────────
rule busco:
    input:  contigs = rules.spades.output.contigs
    output: summary = f"{base_path}/Combine_revised/{{sample}}/busco/{{sample}}_busco_output/short_summary.txt"
    params:
        outdir   = f"{base_path}/Combine_revised/{{sample}}/busco",
        env_path = CONDA_ENVS["busco"],
        lineage  = BUSCO_LINEAGE
    threads: 4
    log: f"{base_path}/Combine_revised/{{sample}}/logs/busco.log"
    shell:
        """
        export PATH={params.env_path}/bin:$PATH
        mkdir -p {params.outdir} $(dirname {log})
        busco -i {input.contigs} \
              -o {wildcards.sample}_busco_output \
              -m genome -l {params.lineage} \
              --out_path {params.outdir} \
              --offline -f --cpu {threads} &> {log}

        # BUSCO 5+ writes short_summary.specific.<lineage>.<name>.txt.
        # Normalize to the declared Snakemake output.
        BUSCO_DIR="{params.outdir}/{wildcards.sample}_busco_output"
        ACTUAL=$(find "$BUSCO_DIR" -maxdepth 1 -name "short_summary*.txt" 2>/dev/null | head -1)
        if [ -n "$ACTUAL" ] && [ "$ACTUAL" != "{output.summary}" ]; then
            cp "$ACTUAL" {output.summary}
        fi
        [ -f {output.summary} ] || touch {output.summary}
        """


