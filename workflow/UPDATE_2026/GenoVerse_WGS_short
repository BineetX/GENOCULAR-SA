# ─────────────────────────────────────────────────────────────
# STEP 19: Cctyper
# ─────────────────────────────────────────────────────────────
rule cctyper:
    input:
        contigs = rules.spades.output.contigs

    output:
        summary     = f"{base_path}/Combine_revised/{{sample}}/crispr_output/crispr_summary.txt",
        crispr_cas  = f"{base_path}/Combine_revised/{{sample}}/crispr_output/CRISPR_Cas.tab",
        cas_operons = f"{base_path}/Combine_revised/{{sample}}/crispr_output/cas_operons.tab",

    params:
        outdir = f"{base_path}/Combine_revised/{{sample}}/crispr_output",
        env_path = CONDA_ENVS["cctyper"],
        db     = os.environ.get("CCTYPER_DB", "/dbs/cctyper")

    threads: 4

    log:
        f"{base_path}/Combine_revised/{{sample}}/logs/cctyper.log"

    shell:
        r"""
        set -euo pipefail

        mkdir -p $(dirname {log})

        echo "[CCTyper] Starting..." > {log}
        echo "Input: {input.contigs}" >> {log}
        echo "DB: {params.db}" >> {log}

        # CRITICAL: cctyper 1.8.0 refuses to run if outdir exists — wipe it first
        rm -rf {params.outdir}

        export PATH={params.env_path}/bin:$PATH
        export CCTYPER_DB="{params.db}"

        cctyper {input.contigs} {params.outdir} \
            --db "$CCTYPER_DB" \
            --prodigal single \
            --threads {threads} >> {log} 2>&1

        # -----------------------------
        # OUTPUT FIXING
        # -----------------------------

        if [ -s "{params.outdir}/CRISPR_Cas.tab" ]; then

            # cp {params.outdir}/CRISPR_Cas.tab {output.crispr_cas}

            if [ -f "{params.outdir}/cas_operons_putative.tab" ]; then
                cp {params.outdir}/cas_operons_putative.tab {output.cas_operons}
            else
                touch {output.cas_operons}
            fi

            echo "CRISPR-Cas systems detected" > {output.summary}
            cat {output.crispr_cas} >> {output.summary}

        else
            echo "No CRISPR-Cas systems detected." > {output.summary}

            touch {output.crispr_cas}
            touch {output.cas_operons}
