            FASTQC_BIN=$(which fastqc 2>/dev/null || true)
        fi
        if [ ! -x "$FASTQC_BIN" ]; then
            echo "ERROR: fastqc not found" >&2; exit 1
        fi

        "$FASTQC_BIN" -t {threads} -o {params.outdir} {input.R1} {input.R2} &> {log}
        """


# ─────────────────────────────────────────────────────────────
# STEP 5: Kraken2 classification
# ─────────────────────────────────────────────────────────────
rule kraken_classify:
    input:
        R1 = rules.bbduk.output.cleaned_R1,
        R2 = rules.bbduk.output.cleaned_R2
    output:
        report             = f"{base_path}/Combine_revised/{{sample}}/kraken2_report.txt",
        kraken_output_file = f"{base_path}/Combine_revised/{{sample}}/kraken2_output.txt"
    params:
        db_path  = kraken_db_path,
        env_path = CONDA_ENVS["kraken2_env"]
    threads: 8
    log:
        f"{base_path}/Combine_revised/{{sample}}/logs/kraken_classify.log"
    shell:
        """
        export PATH={params.env_path}/bin:$PATH
        mkdir -p $(dirname {output.report}) $(dirname {log})
        kraken2 --db {params.db_path} --threads {threads} \
            --paired {input.R1} {input.R2} \
            --use-names \
            --report {output.report} \
            --output {output.kraken_output_file} &> {log}
        """


# ─────────────────────────────────────────────────────────────
# STEP 6: Extract classified reads
# ─────────────────────────────────────────────────────────────
rule kraken_extract_reads:
    input:
        kraken_output = rules.kraken_classify.output.kraken_output_file,
        R1            = rules.bbduk.output.cleaned_R1,
        R2            = rules.bbduk.output.cleaned_R2
    output:
        classified_R1 = f"{base_path}/Combine_revised/{{sample}}/kraken_classified/{{sample}}_classified_R1.fastq",
        classified_R2 = f"{base_path}/Combine_revised/{{sample}}/kraken_classified/{{sample}}_classified_R2.fastq"
    params:
        tools_path = kraken_tools_path,
        env_path   = CONDA_ENVS["kraken2_env"]
    threads: 4
    log:
        f"{base_path}/Combine_revised/{{sample}}/logs/kraken_extract.log"
    shell:
        """
        export PATH={params.env_path}/bin:$PATH
        mkdir -p $(dirname {output.classified_R1}) $(dirname {log})
        python {params.tools_path}/extract_kraken_reads.py \
            -k {input.kraken_output} \
            -s {input.R1} -s2 {input.R2} \
            -o {output.classified_R1} -o2 {output.classified_R2} \
            --fastq-output -t 0 --exclude &> {log}
        """


# ─────────────────────────────────────────────────────────────
# STEP 7: Adaptive SPAdes assembly
# ─────────────────────────────────────────────────────────────
rule spades:
    input:
        classified_R1 = rules.kraken_extract_reads.output.classified_R1,
        classified_R2 = rules.kraken_extract_reads.output.classified_R2,
        qc_zip        = f"{base_path}/Combine_revised/{{sample}}/fastqc_raw/{{sample}}_R1_fastqc.zip"
    output:
        contigs = f"{base_path}/Combine_revised/{{sample}}/spades_output/contigs.fasta"
    params:
        env_path = CONDA_ENVS["marine"]
    threads: 8
    log:
        f"{base_path}/Combine_revised/{{sample}}/logs/spades.log"
    shell:
        """
        export PATH={params.env_path}/bin:$PATH
        mkdir -p $(dirname {output.contigs}) $(dirname {log})

        TMPDIR_QC=$(mktemp -d)
        unzip -q {input.qc_zip} -d "$TMPDIR_QC"
        QC_DATA=$(find "$TMPDIR_QC" -name "fastqc_data.txt" | head -1)

        MEAN_Q=$(awk '/>>Per base sequence quality/,/>>END_MODULE/' "$QC_DATA" \
                 | grep -v '^#' | grep -v '>>' \
                 | awk '{{sum+=$2; n++}} END{{if(n>0) printf "%d", sum/n; else print 20}}')
        READ_COUNT=$(awk '/Total Sequences/{{print $NF}}' "$QC_DATA")
        READ_COUNT=${{READ_COUNT:-1000000}}
        rm -rf "$TMPDIR_QC"

        EXTRA_FLAGS=""
        MEM=50

        if [ "$MEAN_Q" -lt 20 ]; then
            EXTRA_FLAGS="$EXTRA_FLAGS --only-assembler"
            echo "[SPAdes] Low quality (Q=$MEAN_Q): adding --only-assembler" | tee -a {log}
        fi

        if [ "$READ_COUNT" -le 5000000 ]; then
            MEM=30
            echo "[SPAdes] Low read count ($READ_COUNT): memory cap ${{MEM}}G" | tee -a {log}
        fi

        echo "[SPAdes] MeanQ=$MEAN_Q  ReadCount=$READ_COUNT  ExtraFlags=$EXTRA_FLAGS" | tee -a {log}

        spades.py --careful --cov-cutoff auto \
            -t {threads} -m $MEM \
            $EXTRA_FLAGS \
            -1 {input.classified_R1} -2 {input.classified_R2} \
            -o $(dirname {output.contigs}) &>> {log}
        """


# ─────────────────────────────────────────────────────────────
# STEP 8: Prokka
# ─────────────────────────────────────────────────────────────
rule prokka:
    input:  contigs = rules.spades.output.contigs
    output:
        gff = f"{base_path}/Combine_revised/{{sample}}/prokka/annotated_genome.gff",
        faa = f"{base_path}/Combine_revised/{{sample}}/prokka/annotated_genome.faa"
    params: env_path = CONDA_ENVS["prokka"]
    threads: 4
    log: f"{base_path}/Combine_revised/{{sample}}/logs/prokka.log"
    shell:
        """
        export PATH={params.env_path}/bin:$PATH
        mkdir -p $(dirname {output.gff}) $(dirname {log})
        prokka --outdir $(dirname {output.gff}) --force \
            --prefix annotated_genome --cpus {threads} \
            {input.contigs} &> {log}
        """


# ─────────────────────────────────────────────────────────────
# STEP 9: RepeatMasker
# ─────────────────────────────────────────────────────────────
rule repeatmasker:
    input:  contigs = rules.spades.output.contigs
    output: masked_fasta = f"{base_path}/Combine_revised/{{sample}}/repeatmasker/contigs.masked.fasta"
    params: env_path = CONDA_ENVS["marine"]
    threads: 1
    log: f"{base_path}/Combine_revised/{{sample}}/logs/repeatmasker.log"
    shell:
        """
        export PATH={params.env_path}/bin:$PATH
        mkdir -p $(dirname {output.masked_fasta}) $(dirname {log})
        if [ -n "${{LIBNSL_DIR:-}}" ] && [ -d "${{LIBNSL_DIR}}" ]; then
            export LD_LIBRARY_PATH="${{LIBNSL_DIR}}:$LD_LIBRARY_PATH"
        fi
        RepeatMasker -species all -gff \
            -dir $(dirname {output.masked_fasta}) {input.contigs} &> {log}
        # RepeatMasker names output as <input>.masked — rename to expected path
        MASKED_SRC="$(dirname {output.masked_fasta})/$(basename {input.contigs}).masked"
        if [ -f "$MASKED_SRC" ] && [ "$MASKED_SRC" != "{output.masked_fasta}" ]; then
            mv "$MASKED_SRC" {output.masked_fasta}
        elif [ ! -f "{output.masked_fasta}" ]; then
            # No repeats found — RepeatMasker does not create .masked; copy original
            cp {input.contigs} {output.masked_fasta}
        fi
        """

# ─────────────────────────────────────────────────────────────
# STEP 10: InterProScan  (Fixed escape sequence)
# ─────────────────────────────────────────────────────────────
rule interproscan:
    input:  faa = rules.prokka.output.faa
    output:
        tsv  = f"{base_path}/Combine_revised/{{sample}}/interproscan/interproscan_results.tsv",
        xml  = f"{base_path}/Combine_revised/{{sample}}/interproscan/interproscan_results.xml",
        gff3 = f"{base_path}/Combine_revised/{{sample}}/interproscan/interproscan_results.gff3"
    params:
        outdir   = f"{base_path}/Combine_revised/{{sample}}/interproscan",
        env_path = CONDA_ENVS["interproscan"]
    threads: 8
    log: f"{base_path}/Combine_revised/{{sample}}/logs/interproscan.log"
    shell:
        """
        export PATH={params.env_path}/bin:$PATH
        mkdir -p {params.outdir} $(dirname {log})

        # InterProScan cannot handle stop-codon '*' characters — strip them
        CLEAN_FAA="{params.outdir}/proteins_clean.faa"
        sed 's/*//g' {input.faa} > "$CLEAN_FAA"

        # Run InterProScan
        interproscan.sh \
            -i "$CLEAN_FAA" \
            -b {params.outdir}/interproscan_results \
            -f TSV,XML,GFF3 \
            -t p \
            -appl Pfam,TIGRFAM,Gene3D,PANTHER,SMART,CDD,ProSiteProfiles,ProSitePatterns \
            --disable-precalc \
            -iprlookup -goterms \
            --cpu {threads} &> {log}

        rm -f "$CLEAN_FAA"
        """


