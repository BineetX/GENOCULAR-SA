rule fastqc_raw:
    input:
        R1 = lambda wildcards: get_sample_fastq(wildcards, 'R1'),
        R2 = lambda wildcards: get_sample_fastq(wildcards, 'R2')
    output:
        html_R1 = f"{base_path}/Combine_revised/{{sample}}/fastqc_raw/{{sample}}_R1_fastqc.html",
        html_R2 = f"{base_path}/Combine_revised/{{sample}}/fastqc_raw/{{sample}}_R2_fastqc.html",
        zip_R1  = f"{base_path}/Combine_revised/{{sample}}/fastqc_raw/{{sample}}_R1_fastqc.zip",
        zip_R2  = f"{base_path}/Combine_revised/{{sample}}/fastqc_raw/{{sample}}_R2_fastqc.zip"
    params:
        outdir = f"{base_path}/Combine_revised/{{sample}}/fastqc_raw",
        env_path = CONDA_ENVS["fastqc_env"]
    threads: 2
    log:
        f"{base_path}/Combine_revised/{{sample}}/logs/fastqc_raw.log"
    shell:
        """
        set -euo pipefail
        export PATH={params.env_path}/bin:$PATH
        mkdir -p {params.outdir} $(dirname {log})

        FASTQC_BIN="{params.env_path}/bin/fastqc"
        if [ ! -x "$FASTQC_BIN" ]; then
            FASTQC_BIN=$(which fastqc 2>/dev/null || true)
        fi
