# ─────────────────────────────────────────────────────────────
# STEP 21: HADEG
# ─────────────────────────────────────────────────────────────
rule hadeg:
    input:
        faa = rules.prokka.output.faa
    output:
        done_flag = f"{base_path}/Combine_revised/{{sample}}/hadeg/hadeg_done.flag"
    params:
        hadeg_db      = HADEG_DB,
        hadeg_rscript = HADEG_RSCRIPT,
        outdir        = f"{base_path}/Combine_revised/{{sample}}/hadeg",
        env_path      = CONDA_ENVS["hadeg"]
    threads: 4
    log:
        f"{base_path}/Combine_revised/{{sample}}/logs/hadeg.log"
    shell:
        """
        export PATH={params.env_path}/bin:$PATH
        mkdir -p {params.outdir} $(dirname {log})
        LOG_ABS=$(realpath {log})
        FAA_ABS=$(realpath {input.faa})

        echo "[HADEG] Started for {wildcards.sample}" > "$LOG_ABS"
        echo "[HADEG] Input FAA: $FAA_ABS" >> "$LOG_ABS"
        echo "[HADEG] DB: {params.hadeg_db}" >> "$LOG_ABS"

        cd {params.outdir}
        cp "$FAA_ABS" annotated_genome.faa

        # HADEG is treated as non-fatal; continue pipeline even if it yields no hits.
        if ! command -v proteinortho >/dev/null 2>&1; then
            echo "[HADEG] WARNING: proteinortho not found. Marking HADEG step done." >> "$LOG_ABS"
            touch {output.done_flag}
            exit 0
        fi
        if ! command -v diamond >/dev/null 2>&1; then
            echo "[HADEG] WARNING: DIAMOND not found. Marking HADEG step done." >> "$LOG_ABS"
            touch {output.done_flag}
            exit 0
        fi

        if [ ! -f "{params.hadeg_db}" ]; then
            echo "[HADEG] WARNING: HADEG DB missing at {params.hadeg_db}. Marking done." >> "$LOG_ABS"
            touch {output.done_flag}
            exit 0
        fi

        proteinortho \
            -project=Results_HADEG \
            -identity=30 \
            -conn=0.1 \
            -e=1e-5 \
            -p=diamond \
            -cpus={threads} \
            annotated_genome.faa {params.hadeg_db} >> "$LOG_ABS" 2>&1 || true

        if command -v Rscript >/dev/null 2>&1 && [ -f "{params.hadeg_rscript}" ]; then
            Rscript {params.hadeg_rscript} >> "$LOG_ABS" 2>&1 || \
              echo "[HADEG] WARNING: Rscript post-processing failed; continuing." >> "$LOG_ABS"
        else
            echo "[HADEG] WARNING: Rscript not available. Skipping HADEG plotting." >> "$LOG_ABS"
        fi

        touch {output.done_flag}
        """


# ─────────────────────────────────────────────────────────────
# STEP 22: Barrnap — 16S rRNA extraction
# ─────────────────────────────────────────────────────────────
rule barrnap_16s:
    input:
        contigs = rules.spades.output.contigs
    output:
        gff   = f"{base_path}/Combine_revised/{{sample}}/barrnap/contigs_16s.gff",
        fasta = f"{base_path}/Combine_revised/{{sample}}/barrnap/contigs_16s.fasta"
    params:
        env_path = CONDA_ENVS["barrnap"]
    threads: 2
    log:
        f"{base_path}/Combine_revised/{{sample}}/logs/barrnap.log"
    shell:
        """
        export PATH={params.env_path}/bin:$PATH
        mkdir -p $(dirname {output.gff}) $(dirname {log})

        barrnap --kingdom bac --threads {threads} {input.contigs} \
            2>> {log} | grep "16S_rRNA" > {output.gff} || true

        if [ ! -s {output.gff} ]; then
            echo "[Barrnap] No 16S rRNA genes detected in {wildcards.sample}" | tee -a {log}
            touch {output.fasta}
        else
            bedtools getfasta \
                -fi {input.contigs} \
                -bed {output.gff} \
                -fo {output.fasta} 2>> {log}
            echo "[Barrnap] 16S sequences extracted: $(grep -c '>' {output.fasta})" | tee -a {log}
        fi
        """


# ─────────────────────────────────────────────────────────────
# STEP 23a: 16S BLAST identification against SILVA
# Uses barrnap-extracted 16S sequences + existing SILVA BLAST db
# ─────────────────────────────────────────────────────────────
SILVA_BLAST_DB = os.environ.get("SILVA_BLAST_DB", "/dbs/silva_16s_db")

rule blast_16s:
    input:
        fasta_16s = rules.barrnap_16s.output.fasta
    output:
        blast_out = f"{base_path}/Combine_revised/{{sample}}/blast_16s/blast_16s_results.txt"
    params:
        db        = SILVA_BLAST_DB,
        outdir    = f"{base_path}/Combine_revised/{{sample}}/blast_16s",
        env_path  = CONDA_ENVS["marine"]
    threads: 4
    log:
        f"{base_path}/Combine_revised/{{sample}}/logs/blast_16s.log"
    shell:
        """
        set -euo pipefail
        export PATH={params.env_path}/bin:$PATH
        mkdir -p {params.outdir} $(dirname {log})

        if [ ! -s {input.fasta_16s} ]; then
            echo "[BLAST 16S] No 16S sequences found in {wildcards.sample} — skipping BLAST" | tee {log}
            echo "# No 16S sequences detected by barrnap — BLAST skipped" > {output.blast_out}
        else
            echo "[BLAST 16S] Running BLASTn against SILVA for {wildcards.sample}" | tee {log}
            blastn \
                -query {input.fasta_16s} \
                -db {params.db} \
                -out {output.blast_out} \
                -outfmt "6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore stitle" \
                -num_threads {threads} \
                -max_target_seqs 5 \
                -perc_identity 80 \
                -evalue 1e-10 \
                -task blastn \
                &>> {log}

            if [ ! -s {output.blast_out} ]; then
                echo "# No significant BLAST hits found" > {output.blast_out}
            fi

            echo "[BLAST 16S] Top hits for {wildcards.sample}:" | tee -a {log}
            head -5 {output.blast_out} | tee -a {log}
        fi
        """


# ─────────────────────────────────────────────────────────────
# STEP 23b: FastANI — Average Nucleotide Identity
#
# AUTO-DOWNLOAD STRATEGY (no reference_genomes.txt needed):
#   1. Parse top 5 BLAST hits from blast_16s_results.txt
#      → extract unique species names from stitle (col 13)
#   2. For each species, download up to 5 reference genomes
#      using ncbi-genome-download (ncbi_env)
#      → assembly levels: complete,chromosome,scaffold,draft
#   3. Build a reference list from all downloaded FASTAs
#   4. Run fastANI against all references simultaneously
#   5. Sort output by ANI descending — best match on top
#
# Downloaded genomes are cached under fastani/ref_genomes/
# so re-runs are instant (no repeated downloads).
# ─────────────────────────────────────────────────────────────
rule fastani:
    input:
        contigs   = rules.spades.output.contigs,
        blast_16s = rules.blast_16s.output.blast_out   # ensures 16S step runs first
    output:
        ani_result = f"{base_path}/Combine_revised/{{sample}}/fastani/fastani_results.txt"
    params:
        fastani_env = CONDA_ENVS["fastani"],
        ncbi_env    = CONDA_ENVS["ncbi"],
        outdir      = f"{base_path}/Combine_revised/{{sample}}/fastani",
        ref_dir     = f"{base_path}/Combine_revised/{{sample}}/fastani/ref_genomes"
    threads: 4
    log:
        f"{base_path}/Combine_revised/{{sample}}/logs/fastani.log"
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.outdir} {params.ref_dir} $(dirname {log})

        # ── Tool paths ────────────────────────────────────────────────────
        export PATH={params.fastani_env}/bin:{params.ncbi_env}/bin:$PATH

        FASTANI_BIN="{params.fastani_env}/bin/fastANI"
        [ -x "$FASTANI_BIN" ] || FASTANI_BIN=$(which fastANI 2>/dev/null || true)
        if [ ! -x "$FASTANI_BIN" ]; then
            echo "[FastANI] ERROR: fastANI binary not found" | tee -a {log}
            echo "# fastANI not found — skipping" > {output.ani_result}
            exit 0
        fi

        NGD_BIN="{params.ncbi_env}/bin/ncbi-genome-download"
        [ -x "$NGD_BIN" ] || NGD_BIN=$(which ncbi-genome-download 2>/dev/null || true)
        if [ ! -x "$NGD_BIN" ]; then
            echo "[FastANI] ERROR: ncbi-genome-download not found in ncbi_env." | tee -a {log}
            echo "[FastANI] Install: conda install -n ncbi_env -c bioconda ncbi-genome-download" | tee -a {log}
            echo "# ncbi-genome-download not found — FastANI skipped" > {output.ani_result}
            exit 0
        fi

        # ── Step 1: Parse top 5 BLAST hits → unique species names ────────
        # blast_16s outfmt6: qseqid sseqid pident length mismatch gapopen
        #                    qstart qend sstart send evalue bitscore stitle
        # stitle (col 13) is the SILVA taxonomy string:
        #   "Bacteria;Proteobacteria;...;Pseudomonas aeruginosa"
        # We take the last semicolon-delimited field → first two words
        # (genus + species epithet) as the binomial name.

        echo "[FastANI] Parsing top BLAST hits from {input.blast_16s}" | tee -a {log}

        SPECIES_LIST=$(grep -v '^#' "{input.blast_16s}" | head -5 \
            | awk -F'\t' '{{print $13}}' \
            | awk -F';'   '{{print $NF}}' \
            | sed 's/^ *//; s/ *$//' \
            | awk '{{print $1" "$2}}' \
            | grep -v '^ *$' \
            | sort -u)

        if [ -z "$SPECIES_LIST" ]; then
            echo "[FastANI] No BLAST hits — cannot auto-select reference genomes." | tee -a {log}
            echo "# No BLAST hits to drive reference selection — FastANI skipped" > {output.ani_result}
            exit 0
        fi

        echo "[FastANI] Species to download references for:" | tee -a {log}
        echo "$SPECIES_LIST" | tee -a {log}

        # ── Step 2: Download reference genomes per species ────────────────
        # ncbi-genome-download writes into:
        #   <outdir>/refseq/bacteria/<accession>/
        # --formats fasta gives *.fna.gz files
        # --limit 5  → max 5 genomes per species (your "top 5" requirement)

        while IFS= read -r SPECIES; do
            [ -z "$SPECIES" ] && continue

            # Sanitise species name for use as a directory name
            SAFE=$(echo "$SPECIES" | tr ' ' '_' | tr -cd 'A-Za-z0-9_-')
            SPECIES_DIR="{params.ref_dir}/$SAFE"

            if [ -d "$SPECIES_DIR" ] && \
               [ "$(find "$SPECIES_DIR" -maxdepth 1 -name '*.fna' 2>/dev/null | wc -l)" -gt 0 ]; then
                echo "[FastANI] Using cached genomes for '$SPECIES' in $SPECIES_DIR" | tee -a {log}
            else
                mkdir -p "$SPECIES_DIR"
                echo "[FastANI] Downloading genomes for '$SPECIES' ..." | tee -a {log}

                "$NGD_BIN" bacteria \
                    -g "$SPECIES" \
                    -F fasta \
                    -l complete,chromosome,scaffold \
                    -R reference,representative \
                    -o "$SPECIES_DIR" \
                    --flat-output \
                    -r 3 \
                    2>> {log} || {{
                        echo "[FastANI] WARNING: download returned non-zero for '$SPECIES' — continuing" | tee -a {log}
                    }}

                # Decompress downloaded .fna.gz files in place
                find "$SPECIES_DIR" -name "*.fna.gz" -exec gunzip -f {{}} \; 2>> {log} || true

                NFNA=$(find "$SPECIES_DIR" -name "*.fna" | wc -l)
                echo "[FastANI] Downloaded $NFNA FASTA file(s) for '$SPECIES'" | tee -a {log}
            fi
        done <<< "$SPECIES_LIST"

        # ── Step 3: Build reference list from all downloaded FASTAs ───────
        REF_LIST="{params.outdir}/ref_list.txt"
        find {params.ref_dir} -name "*.fna" > "$REF_LIST"

        NREF=$(wc -l < "$REF_LIST")
        if [ "$NREF" -eq 0 ]; then
            echo "[FastANI] No reference FASTAs found after download — FastANI skipped." | tee -a {log}
            echo "# No reference genomes downloaded — FastANI skipped" > {output.ani_result}
            exit 0
        fi
        echo "[FastANI] Total reference genomes for ANI: $NREF" | tee -a {log}

        # ── Step 4: Run FastANI ───────────────────────────────────────────
        QUERY_LIST="{params.outdir}/query_list.txt"
        echo "{input.contigs}" > "$QUERY_LIST"

        echo "[FastANI] Running fastANI (query vs $NREF references) ..." | tee -a {log}
        "$FASTANI_BIN" \
            --ql "$QUERY_LIST" \
            --rl "$REF_LIST" \
            -t   {threads} \
            -o   {output.ani_result} >> {log} 2>&1 || true

        # ── Step 5: Sort output by ANI descending + add header ────────────
        if [ -s {output.ani_result} ]; then
            TMP_SORT="{params.outdir}/ani_sorted_tmp.txt"
            echo -e "# FastANI results for {wildcards.sample}" > "$TMP_SORT"
            echo -e "# Columns: query	reference	ANI	bi-directional_fragments	total_fragments" >> "$TMP_SORT"
            sort -t$'	' -k3 -nr {output.ani_result} >> "$TMP_SORT"
            mv "$TMP_SORT" {output.ani_result}
            echo "[FastANI] Done. Top 5 results:" | tee -a {log}
            grep -v '^#' {output.ani_result} | head -5 | tee -a {log}
        else
            echo "# No ANI results above threshold" > {output.ani_result}
            echo "[FastANI] No ANI results above threshold." | tee -a {log}
        fi
        """

# ─────────────────────────────────────────────────────────────
# STEP 24: Final report
# ─────────────────────────────────────────────────────────────
rule final_report:
    input:
        busco        = rules.busco.output.summary,
        checkm       = rules.checkm.output.summary,
        quast        = rules.quast.output.report,
        prokka       = rules.prokka.output.gff,
        interproscan = rules.interproscan.output.tsv,
        kofamscan    = rules.kofamscan.output.kofamscan_results,
        dbcan        = rules.dbcan.output.overview,
        crispr       = rules.cctyper.output.summary,   
        antismash    = rules.antismash.output.antismash_results,
        eggnog       = rules.eggnog_mapper.output.annotations,
        repeatmasker = rules.repeatmasker.output.masked_fasta,
        hadeg        = rules.hadeg.output.done_flag,
        barrnap_16s  = rules.barrnap_16s.output.fasta,
        blast_16s    = rules.blast_16s.output.blast_out,
        fastani      = rules.fastani.output.ani_result
    output:
        report = f"{base_path}/Combine_revised/{{sample}}/final_report.txt"
    log:
        f"{base_path}/Combine_revised/{{sample}}/logs/final_report.log"
    shell:
        """
        mkdir -p $(dirname {output.report}) $(dirname {log})
        {{
          echo "Final Report for {wildcards.sample}";
          echo "Generated on: $(date)";
          echo "==========================================";
          echo "";
          echo "BUSCO Summary:";
          [ -f {input.busco} ] && cat {input.busco} || echo "missing";
          echo "";
          echo "CheckM Summary:";
          [ -f {input.checkm} ] && head -n 20 {input.checkm} || echo "missing";
          echo "";
          echo "QUAST Report: {input.quast}";
          echo "";
          echo "CRISPR Summary:";
          [ -f {input.crispr} ] && head -n 30 {input.crispr} || echo "missing";
          echo "";
          echo "AntiSMASH (knownclusterblast):";
          [ -f {input.antismash} ] && head -n 20 {input.antismash} || echo "missing";
          echo "";
          echo "RepeatMasker output created:";
          [ -f {input.repeatmasker} ] && echo "Yes" || echo "No";
          echo "";
          echo "HADEG analysis:";
          [ -f {input.hadeg} ] && echo "Completed — see $(dirname {input.hadeg})/" || echo "missing";
          echo "";
          echo "Barrnap 16S rRNA:";
          if [ -s {input.barrnap_16s} ]; then
              echo "Sequences found: $(grep -c '>' {input.barrnap_16s})";
          else
              echo "No 16S rRNA genes detected";
          fi
          echo "";
          echo "16S BLAST identification (SILVA):";
          if [ -s {input.blast_16s} ]; then
              echo "qseqid  sseqid  pident  length  evalue  bitscore  taxonomy";
              head -5 {input.blast_16s};
          else
              echo "No BLAST hits or skipped";
          fi
          echo "";
          echo "FastANI results:";
          [ -s {input.fastani} ] && cat {input.fastani} || echo "No ANI hits or skipped";
        }} > {output.report} 2> {log}
        """


ANALYSIS_TYPE = "wgs"
ANALYSIS_MODE = "short"
ANALYSIS_ROOT_PATTERN = base_path
ANALYSIS_SAMPLE = str(config.get("sample") or samples[0])
ANALYSIS_PREREQUISITES = expand(
    f"{base_path}/Combine_revised/{{sample}}/final_report.txt",
    sample=samples,
)
