# =============================================================================
# PHASE 1 — PREPROCESSING  (sequential: fastp → kneaddata)
# =============================================================================

rule fastp:
    input:
        r1 = config["reads"]["r1"],
        r2 = config["reads"]["r2"]
    output:
        r1   = f"{FASTP_DIR}/{SAMPLE}_1.clean.fastq",
        r2   = f"{FASTP_DIR}/{SAMPLE}_2.clean.fastq",
        json = f"{FASTP_DIR}/{SAMPLE}_fastp.json",
        html = f"{FASTP_DIR}/{SAMPLE}_fastp.html"
    threads: THREADS
    shell:
        """
        mkdir -p {FASTP_DIR}
        {FASTP} \
          -i {input.r1} -I {input.r2} \
          -o {output.r1} -O {output.r2} \
          -j {output.json} -h {output.html} \
          --qualified_quality_phred {FASTP_QUALIFIED_Q} \
          --length_required {FASTP_MIN_LENGTH} \
          {FASTP_LOW_COMPLEXITY_FLAG} \
          {FASTP_CUT_FRONT_FLAG} \
          {FASTP_CUT_TAIL_FLAG} \
          -w {threads}
        """

rule kneaddata:
    input:
        r1 = f"{FASTP_DIR}/{SAMPLE}_1.clean.fastq",
        r2 = f"{FASTP_DIR}/{SAMPLE}_2.clean.fastq"
    output:
        r1 = f"{KNEAD_DIR}/{SAMPLE}_paired_1.fastq",
        r2 = f"{KNEAD_DIR}/{SAMPLE}_paired_2.fastq"
    threads: THREADS
    shell:
        """
        export PATH={KNEADDATA_ENV}:$PATH
        mkdir -p {KNEAD_DIR}
        kneaddata \
          --input1 {input.r1} \
          --input2 {input.r2} \
          --output {KNEAD_DIR} \
          --reference-db {config[kneaddata_db]} \
          --threads {threads} \
          --bypass-trim \
          --bypass-trf \
          --output-prefix {SAMPLE}
        """


# =============================================================================
# PHASE 2 — COMMUNITY PROFILING
# PARALLEL with Phase 3: both start as soon as kneaddata finishes.
# =============================================================================

rule metaphlan:
    input:
        r1 = f"{KNEAD_DIR}/{SAMPLE}_paired_1.fastq",
        r2 = f"{KNEAD_DIR}/{SAMPLE}_paired_2.fastq"
    output:
        profile = f"{META_DIR}/{SAMPLE}_profile.txt",
        bowtie2 = f"{META_DIR}/{SAMPLE}.bowtie2.bz2"
    # PARALLEL OPTIMISATION: MetaPhlAn gets half the cores so MEGAHIT can
    # start simultaneously on the other half.  Adjust the split to suit
    # your server (e.g. 16+16 on a 32-core machine).
    threads: max(1, THREADS // 2)
    shell:
        """
        mkdir -p {META_DIR}
        export PATH={METAPHLAN_ENV}:$PATH
        {METAPHLAN} {input.r1},{input.r2} \
          --input_type fastq \
          --bowtie2db {METAPHLAN_DB} \
          -x mpa_vJan25_CHOCOPhlAnSGB_202503 \
          --bowtie2_exe {BOWTIE2_META} \
          --bowtie2out {output.bowtie2} \
          --nproc {threads} \
          -o {output.profile}
        """


# =============================================================================
# PHASE 3 — ASSEMBLY AND ASSEMBLY QC
# PARALLEL with Phase 2: starts as soon as kneaddata finishes.
# =============================================================================

rule megahit:
    input:
        r1 = f"{KNEAD_DIR}/{SAMPLE}_paired_1.fastq",
        r2 = f"{KNEAD_DIR}/{SAMPLE}_paired_2.fastq"
    output:
        contigs = f"{ASSEMBLY_DIR}/{SAMPLE}_final.contigs.fa"
    # PARALLEL OPTIMISATION: MEGAHIT gets the other half of cores while
    # MetaPhlAn runs simultaneously.
    threads: max(1, THREADS // 2)
    shell:
        """
        mkdir -p {ASSEMBLY_DIR}
        WORKDIR={ASSEMBLY_DIR}/megahit_{SAMPLE}
        rm -rf $WORKDIR
        {MEGAHIT} \
          -1 {input.r1} -2 {input.r2} \
          -o $WORKDIR \
          -t {threads} \
          --min-contig-len {MEGAHIT_MIN_CONTIG_LEN} \
          --k-list 21,29,39,59,79,99,119,141 \
          --memory 0.8
        cp $WORKDIR/final.contigs.fa {output.contigs}
        """

rule quast:
    input:
        contigs = f"{ASSEMBLY_DIR}/{SAMPLE}_final.contigs.fa",
        r1      = f"{KNEAD_DIR}/{SAMPLE}_paired_1.fastq",
        r2      = f"{KNEAD_DIR}/{SAMPLE}_paired_2.fastq"
    output:
        html = f"{QUAST_DIR}/{SAMPLE}/report.html"
    threads: THREADS
    shell:
        """
        mkdir -p {QUAST_DIR}/{SAMPLE}
        {QUAST} {input.contigs} \
          --pe1 {input.r1} --pe2 {input.r2} \
          -o {QUAST_DIR}/{SAMPLE} \
          -t {threads}
        """


# =============================================================================
# PHASE 4 — READ MAPPING AND BINNING  (sequential within phase)
# Starts as soon as MEGAHIT finishes; MetaPhlAn may still be running — OK.
# =============================================================================

rule bowtie2_index:
    input:
        contigs = f"{ASSEMBLY_DIR}/{SAMPLE}_final.contigs.fa"
    output:
        f"{MAP_DIR}/{SAMPLE}_index.1.bt2",
        f"{MAP_DIR}/{SAMPLE}_index.2.bt2",
        f"{MAP_DIR}/{SAMPLE}_index.3.bt2",
        f"{MAP_DIR}/{SAMPLE}_index.4.bt2",
        f"{MAP_DIR}/{SAMPLE}_index.rev.1.bt2",
        f"{MAP_DIR}/{SAMPLE}_index.rev.2.bt2"
    threads: THREADS
    shell:
        """
        mkdir -p {MAP_DIR}
        {BOWTIE2_BUILD} --threads {threads} {input.contigs} {MAP_DIR}/{SAMPLE}_index
        """

rule bowtie2_map:
    input:
        r1  = f"{KNEAD_DIR}/{SAMPLE}_paired_1.fastq",
        r2  = f"{KNEAD_DIR}/{SAMPLE}_paired_2.fastq",
        idx = f"{MAP_DIR}/{SAMPLE}_index.1.bt2"
    output:
        bam = f"{MAP_DIR}/{SAMPLE}.sorted.bam",
        bai = f"{MAP_DIR}/{SAMPLE}.sorted.bam.bai"
    threads: THREADS
    shell:
        """
        {BOWTIE2} \
          -x {MAP_DIR}/{SAMPLE}_index \
          -1 {input.r1} -2 {input.r2} \
          -p {threads} \
          --no-unal \
        | {SAMTOOLS} sort -@ {threads} -o {output.bam}
        {SAMTOOLS} index {output.bam}
        """

rule depth:
    input:
        bam   = f"{MAP_DIR}/{SAMPLE}.sorted.bam",
        bai   = f"{MAP_DIR}/{SAMPLE}.sorted.bam.bai"
    output:
        depth = f"{MAP_DIR}/{SAMPLE}_depth.txt"
    threads: THREADS
    shell:
        """
        export PATH={BINNING_ENV}:{MAPPING_ENV}:$PATH
        {JGI} --outputDepth {output.depth} {input.bam}
        """

# PARALLEL OPTIMISATION: metabat2 and maxbin2 both depend on (contigs, depth)
# and are independent of each other → Snakemake runs them simultaneously.
rule metabat2:
    input:
        contigs = f"{ASSEMBLY_DIR}/{SAMPLE}_final.contigs.fa",
        depth   = f"{MAP_DIR}/{SAMPLE}_depth.txt"
    output:
        bins = directory(f"{BIN_DIR}/{SAMPLE}/metabat2"),
        done = f"{BIN_DIR}/{SAMPLE}/metabat2.done"
    threads: THREADS
    shell:
        """
        mkdir -p {output.bins}
        export PATH={BINNING_ENV}:$PATH
        {METABAT2} \
          -i {input.contigs} \
          -a {input.depth} \
          -o {output.bins}/{SAMPLE}_bin \
          -t {threads}
        touch {output.done}
        """

rule maxbin2:
    input:
        contigs = f"{ASSEMBLY_DIR}/{SAMPLE}_final.contigs.fa",
        depth   = f"{MAP_DIR}/{SAMPLE}_depth.txt"
    output:
        directory(f"{BIN_DIR}/{SAMPLE}/maxbin2")
    threads: THREADS
    shell:
        r"""
        set -euo pipefail
        export PATH={BINNING_ENV}:$PATH
        export PERL5LIB="$(dirname {BINNING_ENV})/lib/perl5${{PERL5LIB:+:$PERL5LIB}}"
        mkdir -p {output}

        awk 'NR>1 {{print $1"\t"$3}}' {input.depth} \
            > {output}/{SAMPLE}_maxbin_abund.txt

        perl {MAXBIN} \
          -contig {input.contigs} \
          -abund  {output}/{SAMPLE}_maxbin_abund.txt \
          -out    {output}/{SAMPLE} \
          -thread {threads}
        """

rule contig2bin_tables:
    input:
        metabat = f"{BIN_DIR}/{SAMPLE}/metabat2",
        maxbin  = f"{BIN_DIR}/{SAMPLE}/maxbin2"
    output:
        metabat_tsv = f"{BIN_DIR}/{SAMPLE}/metabat2_contig2bin.tsv",
        maxbin_tsv  = f"{BIN_DIR}/{SAMPLE}/maxbin2_contig2bin.tsv"
    shell:
        r"""
        > {output.metabat_tsv}
        for f in {input.metabat}/*.fa; do
          [ -f "$f" ] || continue
          bin=$(basename "$f" .fa)
          awk '/^>/{{split($1,a,">");print a[2]"\t"bin}}' bin="$bin" "$f" \
            >> {output.metabat_tsv}
        done

        > {output.maxbin_tsv}
        for f in {input.maxbin}/*.fasta; do
          [ -f "$f" ] || continue
          bin=$(basename "$f" .fasta)
          awk '/^>/{{split($1,a,">");print a[2]"\t"bin}}' bin="$bin" "$f" \
            >> {output.maxbin_tsv}
        done
        """

rule dastool:
    input:
        metabat = f"{BIN_DIR}/{SAMPLE}/metabat2_contig2bin.tsv",
        maxbin  = f"{BIN_DIR}/{SAMPLE}/maxbin2_contig2bin.tsv",
        semibin = f"{BIN_DIR}/{SAMPLE}/semibin2_contig2bin.tsv",
        contigs = f"{ASSEMBLY_DIR}/{SAMPLE}_final.contigs.fa"
    output:
        bins = directory(f"{DAS_DIR}/{SAMPLE}_DASTool_bins"),
        done = f"{DAS_DIR}/{SAMPLE}.dastool.done"
    threads: THREADS
    shell:
        """
        export PATH={BINNING_ENV}:$PATH
        mkdir -p {DAS_DIR}
        {DASTOOL} \
          -i {input.metabat},{input.maxbin},{input.semibin} \
          -l metabat2,maxbin2,semibin2 \
          -c {input.contigs} \
          -o {DAS_DIR}/{SAMPLE} \
          -t {threads} \
          --write_bins
        mkdir -p {output.bins}
        touch {output.done}
        """

checkpoint select_dastool_bins:
    input:
        bins_dir = f"{DAS_DIR}/{{sample}}_DASTool_bins",
        done     = f"{DAS_DIR}/{{sample}}.dastool.done"
    output:
        bins = directory(f"{DAS_DIR}/{{sample}}_DASTool_bins_clean"),
        done = f"{DAS_DIR}/{{sample}}_DASTool_bins_clean.done"
    shell:
        """
        mkdir -p {output.bins}
        for f in {input.bins_dir}/*.fa; do
          [ -f "$f" ] || continue
          fname=$(basename "$f" .fa)
          case "$fname" in
            *_sub) continue ;;
          esac
          cp "$f" {output.bins}/
        done
        if [ -z "$(ls -A {output.bins})" ]; then
          echo "[select_dastool_bins] No valid MAG bins; continuing with empty MAG reports." >&2
        fi
        touch {output.done}
        """


# =============================================================================
# PHASE 5 — MAG QUALITY ASSESSMENT
# PARALLEL OPTIMISATION: checkm2, busco, and quast_per_mag all start
# simultaneously as soon as select_dastool_bins checkpoint resolves.
# merge_mag_qc waits for all three → triggers mag_filter.
# =============================================================================

# ── 5a: CheckM2 ──────────────────────────────────────────────────────────────
rule checkm2:
    input:
        bins = f"{DAS_DIR}/{{sample}}_DASTool_bins_clean"
    output:
        report = f"{CHECKM_DIR}/{{sample}}/quality_report.tsv"
    threads: THREADS
    params:
        diamond_db = CHECKM2_DB
    shell:
        """
        set -euo pipefail
        mkdir -p {CHECKM_DIR}/{wildcards.sample}
        bin_count=$(find {input.bins} -maxdepth 1 -name "*.fa" | wc -l | tr -d '[:space:]')
        bin_count="${{bin_count:-0}}"
        if [ "$bin_count" -eq 0 ]; then
          printf "Name\tCompleteness\tContamination\n" > {output.report}
          echo "[checkm2] No final bins — writing an empty quality report." >&2
          exit 0
        fi
        export PATH={CHECKM2_ENV}:{PROKKA_ENV}:$PATH
        {CHECKM2} predict \
          --input {input.bins} \
          --output-directory {CHECKM_DIR}/{wildcards.sample} \
          --threads {threads} \
          -x fa \
          --force \
          --database_path {params.diamond_db}
        """

# ── 5b: BUSCO on raw DAS_Tool bins (pre-filter QC only) ──────────────────────
# NOTE: A second BUSCO run on *filtered* MAGs is performed in Phase 6A
#       (rules busco_filtered_per_mag / busco_filtered_all).  This rule
#       provides completeness evidence used by merge_mag_qc → mag_filter.
# PARALLEL OPTIMISATION: replaced the sequential for-loop with GNU parallel
# so all MAGs are assessed simultaneously.  Requires `parallel` in PATH
# (typically: conda install -n busco -c conda-forge parallel).
rule busco:
    input:
        bins = f"{DAS_DIR}/{{sample}}_DASTool_bins_clean"
    output:
        done = f"{BUSCO_DIR}/{{sample}}/busco.done"
    threads: THREADS
    params:
        parallel_jobs = max(1, THREADS // 4),
        lineage = BUSCO_LINEAGE
    shell:
        r"""
        set -euo pipefail
        mkdir -p {BUSCO_DIR}/{wildcards.sample}
        export PATH={BUSCO_ENV}:$PATH

        OUTDIR="{BUSCO_DIR}/{wildcards.sample}"
        LINEAGE="{params.lineage}"
        MAX_JOBS={params.parallel_jobs}
        FAIL_FILE="$OUTDIR/.busco_failed"
        rm -f "$FAIL_FILE"
        active=0

        for fa in {input.bins}/*.fa; do
            [ -f "$fa" ] || continue
            mag=$(basename "$fa" .fa)
            echo "[BUSCO] Launching $mag"
            (
                {BUSCO_BIN} \
                  -i "$fa" \
                  -o "$mag" \
                  --out_path "$OUTDIR" \
                  -m genome \
                  -l "$LINEAGE" \
                  --offline \
                  -c 4 \
                  --force 2>&1 || {{ echo "[BUSCO] ERROR: $mag failed" >&2; touch "$FAIL_FILE"; }}
            ) &
            active=$(( active + 1 ))
            if [ "$active" -ge "$MAX_JOBS" ]; then
                wait
                active=0
            fi
        done
        wait

        if [ -f "$FAIL_FILE" ]; then
            rm -f "$FAIL_FILE"
            echo "[BUSCO] One or more MAG analyses failed." >&2
            exit 1
        fi

        touch {output.done}
        """


# ── 5c: QUAST per MAG (scatter — runs per-MAG in parallel) ───────────────────
rule quast_per_mag:
    input:
        fasta = f"{DAS_DIR}/{{sample}}_DASTool_bins_clean/{{mag}}.fa"
    output:
        tsv   = f"{MAGQC_DIR}/{{sample}}/{{mag}}/report.tsv"
    threads: 1   # tiny job; parallelism comes from many instances running at once
    shell:
        """
        set -euo pipefail
        mkdir -p {MAGQC_DIR}/{wildcards.sample}/{wildcards.mag}
        export PATH={QUAST_ENV}:$PATH
        {QUAST_BIN} {input.fasta} \
          -o {MAGQC_DIR}/{wildcards.sample}/{wildcards.mag} \
          --no-html --no-plots
        """

rule quast_per_mag_all:
    input:
        lambda wildcards: expand(
            f"{MAGQC_DIR}/{{sample}}/{{mag}}/report.tsv",
            sample=wildcards.sample,
            mag=get_mags(wildcards)
        )
    output:
        done = f"{MAGQC_DIR}/{{sample}}/mag_quast.done"
    shell:
        "touch {output.done}"

# ── 5d: Merge all QC results ──────────────────────────────────────────────────
rule merge_mag_qc:
    input:
        checkm2 = f"{CHECKM_DIR}/{{sample}}/quality_report.tsv",
        busco   = f"{BUSCO_DIR}/{{sample}}/busco.done",
        mag_qc  = f"{MAGQC_DIR}/{{sample}}/mag_quast.done",
    output:
        summary = f"{MERGED_QC}/{{sample}}/combined_quality_summary.tsv"
    params:
        busco_dir = f"{BUSCO_DIR}/{{sample}}",
        magqc_dir = f"{MAGQC_DIR}/{{sample}}",
    run:
        import pandas as pd
        import os, re, glob as _glob

        ckm = pd.read_csv(input.checkm2, sep="\t")
        ckm = ckm.rename(columns={
            "Name": "MAG",
            "Completeness": "checkm2_completeness",
            "Contamination": "checkm2_contamination"
        })[["MAG", "checkm2_completeness", "checkm2_contamination"]]

        busco_by_mag = {}
        for summary_file in _glob.glob(
            os.path.join(params.busco_dir, "**", "short_summary*.txt"),
            recursive=True
        ):
            relative = os.path.relpath(summary_file, params.busco_dir)
            mag = relative.split(os.sep, 1)[0]
            with open(summary_file) as fh:
                content = fh.read()
            c_pct = s_pct = d_pct = None
            compact = re.search(
                r"C:([\d.]+)%\[S:([\d.]+)%,D:([\d.]+)%\]",
                content,
            )
            if compact:
                c_pct, s_pct, d_pct = map(float, compact.groups())
            busco_by_mag[mag] = {
                "MAG": mag,
                "busco_complete":   c_pct,
                "busco_single":     s_pct,
                "busco_duplicated": d_pct
            }
        busco_rows = list(busco_by_mag.values())
        bus = pd.DataFrame(busco_rows) if busco_rows else pd.DataFrame(
            columns=["MAG", "busco_complete", "busco_single", "busco_duplicated"])

        qst_rows = []
        for tsv in _glob.glob(os.path.join(params.magqc_dir, "*/report.tsv")):
            mag = os.path.basename(os.path.dirname(tsv))
            df  = pd.read_csv(tsv, sep="\t", header=None, names=["metric", "value"])
            row = {"MAG": mag}
            for _, r in df.iterrows():
                if "N50" in r["metric"]:
                    row["quast_N50"] = r["value"]
                elif "Total length" in r["metric"] and ">" not in r["metric"]:
                    row["quast_total_length"] = r["value"]
                elif "# contigs" in r["metric"] and ">" not in r["metric"]:
                    row["quast_num_contigs"] = r["value"]
                elif "GC (%)" in r["metric"]:
                    row["quast_GC_pct"] = r["value"]
            qst_rows.append(row)
        qst = pd.DataFrame(qst_rows) if qst_rows else pd.DataFrame(
            columns=["MAG", "quast_N50", "quast_total_length",
                     "quast_num_contigs", "quast_GC_pct"])

        merged = ckm.merge(bus, on="MAG", how="left") \
                    .merge(qst, on="MAG", how="left") \

        def mimag_tier(row):
            c_raw = row.get("checkm2_completeness")
            ct_raw = row.get("checkm2_contamination")
            c = float(c_raw) if pd.notna(c_raw) else 0.0
            ct = float(ct_raw) if pd.notna(ct_raw) else 100.0
            if c >= 90 and ct < 5:
                return "High Quality"
            elif c >= 50 and ct < 10:
                return "Medium Quality"
            else:
                return "Low Quality"

        merged["MIMAG_tier"] = merged.apply(mimag_tier, axis=1)
        os.makedirs(os.path.dirname(output.summary), exist_ok=True)
        merged.to_csv(output.summary, sep="\t", index=False)
        print(f"[merge_mag_qc] Written {len(merged)} MAGs → {output.summary}")

checkpoint mag_filter:
    input:
        summary  = f"{MERGED_QC}/{{sample}}/combined_quality_summary.tsv",
        bins_dir = f"{DAS_DIR}/{{sample}}_DASTool_bins_clean"
    output:
        filtered = directory(f"{FILTERED_DIR}/{{sample}}"),
        rejected = directory(f"{REJECTED_DIR}/{{sample}}"),
        done     = f"{FILTERED_DIR}/{{sample}}.filter.done"
    run:
        import pandas as pd, shutil, os

        os.makedirs(output.filtered, exist_ok=True)
        os.makedirs(output.rejected, exist_ok=True)

        df = pd.read_csv(input.summary, sep="\t")
        log_lines = ["MAG\tAction\tReason"]

        for _, row in df.iterrows():
            mag = row["MAG"]
            src = os.path.join(input.bins_dir, f"{mag}.fa")
            if not os.path.exists(src):
                continue
            reasons = []
            comp_raw = row.get("checkm2_completeness")
            cont_raw = row.get("checkm2_contamination")
            comp = float(comp_raw) if pd.notna(comp_raw) else 0.0
            cont = float(cont_raw) if pd.notna(cont_raw) else 100.0
            if comp < MIN_COMPLETENESS:
                reasons.append(f"completeness={comp:.1f}%<{MIN_COMPLETENESS:g}%")
            if cont >= MAX_CONTAMINATION:
                reasons.append(f"contamination={cont:.1f}%>={MAX_CONTAMINATION:g}%")

            if reasons:
                shutil.copy(src, os.path.join(output.rejected, f"{mag}.fa"))
                log_lines.append(f"{mag}\tREJECTED\t{'; '.join(reasons)}")
            else:
                shutil.copy(src, os.path.join(output.filtered, f"{mag}.fa"))
                log_lines.append(f"{mag}\tPASSED\t{row['MIMAG_tier']}")

        with open(os.path.join(output.filtered, "filter_log.tsv"), "w") as fh:
            fh.write("\n".join(log_lines))
        open(output.done, "w").close()
        print(f"[mag_filter] Filter complete. Log: {output.filtered}/filter_log.tsv")


# =============================================================================
# PHASE 6A — MAG-LEVEL ANALYSIS
# PARALLEL OPTIMISATION:
#   • gtdbtk, drep, coverm, and the prokka→annotation chain all start
#     simultaneously as soon as mag_filter resolves.
#   • barrnap_per_mag and prokka_per_mag are scatter/gather: Snakemake
#     launches all MAG jobs concurrently (limited only by --cores).
#   • cctyper and dbcan start per-MAG as soon as that MAG's prokka finishes.
# =============================================================================

# ── 6A-i: GTDB-Tk ────────────────────────────────────────────────────────────
rule gtdbtk:
    input:
        bins = f"{FILTERED_DIR}/{{sample}}",
        done = f"{FILTERED_DIR}/{{sample}}.filter.done"
    output:
        bac  = f"{GTDB_DIR}/{{sample}}/gtdbtk.bac120.summary.tsv",
        ar   = f"{GTDB_DIR}/{{sample}}/gtdbtk.ar53.summary.tsv"
    threads: THREADS
    shell:
        """
        set -euo pipefail
        mkdir -p {GTDB_DIR}/{wildcards.sample}
        export PATH={GTDBTK_ENV}:$PATH
        export GTDBTK_DATA_PATH={GTDBTK_DB}
        bin_count=$(find {input.bins} -maxdepth 1 -name "*.fa" | wc -l | tr -d '[:space:]')
        bin_count="${{bin_count:-0}}"
        if [ "$bin_count" -eq 0 ]; then
          printf "user_genome\tclassification\n" > {output.bac}
          printf "user_genome\tclassification\n" > {output.ar}
          echo "[gtdbtk] No filtered MAGs — writing empty summaries." >&2
          exit 0
        fi
        {GTDBTK} classify_wf \
          --genome_dir {input.bins} \
          --out_dir {GTDB_DIR}/{wildcards.sample} \
          --extension fa \
          --cpus {threads} \
          --pplacer_cpus 1
        [ -f {output.bac} ] || printf "user_genome\tclassification\n" > {output.bac}
        [ -f {output.ar}  ] || printf "user_genome\tclassification\n" > {output.ar}
        """

# ── 6A-ii: dRep (PARALLEL with GTDB-Tk) ──────────────────────────────────────
rule drep:
    input:
        bins      = f"{FILTERED_DIR}/{{sample}}",
        done      = f"{FILTERED_DIR}/{{sample}}.filter.done",
        checkm2   = f"{CHECKM_DIR}/{{sample}}/quality_report.tsv"
    output:
        derep = directory(f"{DREP_DIR}/{{sample}}/dereplicated_genomes")
    threads: THREADS
    run:
        import os, shutil, subprocess, csv as _csv

        drep_env = {**os.environ,
                    "PATH": f"{DREP_ENV}:{os.environ.get('PATH', '')}"}
        out_base = f"{DREP_DIR}/{wildcards.sample}"
        os.makedirs(out_base, exist_ok=True)

        fa_files = sorted(
            os.path.join(input.bins, f)
            for f in os.listdir(input.bins)
            if f.endswith(".fa")
        )

        if len(fa_files) == 0:
            os.makedirs(output.derep, exist_ok=True)
            print("[drep] No filtered MAGs — skipping dereplication.", flush=True)
            return

        if len(fa_files) == 1:
            print("[drep] Only 1 MAG — copying directly.", flush=True)
            os.makedirs(output.derep, exist_ok=True)
            shutil.copy(fa_files[0], os.path.join(output.derep, os.path.basename(fa_files[0])))
            return

        if os.path.isdir(os.path.join(out_base, "log")):
            shutil.rmtree(out_base)
            print(f"[drep] Removed stale work dir: {out_base}", flush=True)
        os.makedirs(out_base, exist_ok=True)
        os.makedirs(output.derep, exist_ok=True)

        genome_info_path = os.path.join(out_base, "genome_info.csv")
        checkm2_data = {}
        import pandas as _pd
        ckm = _pd.read_csv(input.checkm2, sep="\t")
        for _, row in ckm.iterrows():
            stem = os.path.splitext(os.path.basename(str(row.get("Name", "")).strip()))[0]
            comp_raw = row.get("Completeness")
            cont_raw = row.get("Contamination")
            checkm2_data[stem] = (
                float(comp_raw) if _pd.notna(comp_raw) else 50.0,
                float(cont_raw) if _pd.notna(cont_raw) else 5.0,
            )

        with open(genome_info_path, "w", newline="") as gh:
            writer = _csv.writer(gh)
            writer.writerow(["genome", "completeness", "contamination"])
            for fa in fa_files:
                stem = os.path.splitext(os.path.basename(fa))[0]
                comp, cont = checkm2_data.get(stem, (50.0, 5.0))
                writer.writerow([os.path.basename(fa), comp, cont])

        def _avail(binary):
            return subprocess.run(
                ["bash", "-c", f"command -v {binary}"],
                capture_output=True, env=drep_env
            ).returncode == 0

        if _avail("skani"):
            s_algo = "skani"
        elif _avail("fastANI"):
            s_algo = "fastANI"
        else:
            s_algo = "ANImf"

        cmd = [
            DREP_BIN, "dereplicate", out_base,
            "--genomeInfo", genome_info_path,
            "-pa", str(DREP_PRIMARY_ANI),
            "-sa", str(DREP_SECONDARY_ANI),
            "-nc", str(DREP_ALIGNED_FRACTION),
            "-comp", str(DREP_MIN_COMPLETENESS),
            "-con", str(DREP_MAX_CONTAMINATION),
            "--S_algorithm", s_algo,
            "--processors", str(threads),
        ] + ["-g"] + fa_files

        print(f"[drep] Running: {' '.join(cmd)}", flush=True)
        subprocess.run(cmd, check=True, env=drep_env)

