rule busco_filtered_all:
    """Gather all per-MAG BUSCO-on-filtered results and write a summary TSV."""
    input:
        lambda wildcards: expand(
            f"{BUSCO_FILTERED_DIR}/{{sample}}/{{mag}}/busco_filtered.done",
            sample=wildcards.sample,
            mag=get_filtered_mags(wildcards)
        )
    output:
        summary = f"{BUSCO_FILTERED_DIR}/{{sample}}/busco_filtered_summary.tsv",
        done    = f"{BUSCO_FILTERED_DIR}/{{sample}}/busco_filtered_all.done"
    run:
        import os, re, glob as _glob

        rows = ["MAG\tbusco_complete_pct\tbusco_single_pct\tbusco_duplicated_pct\tbusco_fragmented_pct\tbusco_missing_pct\tn_markers"]
        busco_dir = f"{BUSCO_FILTERED_DIR}/{wildcards.sample}"
        values_by_mag = {}

        for summary_file in sorted(_glob.glob(
            os.path.join(busco_dir, "**", "short_summary*.txt"), recursive=True
        )):
            relative = os.path.relpath(summary_file, busco_dir)
            mag = relative.split(os.sep, 1)[0]
            with open(summary_file) as fh:
                content = fh.read()

            vals = {"C": None, "S": None, "D": None, "F": None, "M": None, "n": None}
            compact = re.search(
                r"C:([\d.]+)%\[S:([\d.]+)%,D:([\d.]+)%\],F:([\d.]+)%,M:([\d.]+)%,n:(\d+)",
                content,
            )
            if compact:
                vals = dict(zip(("C", "S", "D", "F", "M", "n"), compact.groups()))
            values_by_mag[mag] = vals

        for mag, vals in sorted(values_by_mag.items()):
            rows.append(
                f"{mag}\t{vals['C']}\t{vals['S']}\t{vals['D']}\t{vals['F']}\t{vals['M']}\t{vals['n']}"
            )

        os.makedirs(os.path.dirname(output.summary), exist_ok=True)
        with open(output.summary, "w") as fh:
            fh.write("\n".join(rows) + "\n")
        print(f"[busco_filtered_all] Written {len(rows)-1} MAG entries → {output.summary}")
        open(output.done, "w").close()


