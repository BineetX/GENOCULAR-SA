rule semibin2:
    input:
        contigs = f"{ASSEMBLY_DIR}/{SAMPLE}_final.contigs.fa",
        bam     = f"{MAP_DIR}/{SAMPLE}.sorted.bam",
        bai     = f"{MAP_DIR}/{SAMPLE}.sorted.bam.bai"
    output:
        bins = directory(f"{BIN_DIR}/{SAMPLE}/semibin2"),
        done = f"{BIN_DIR}/{SAMPLE}/semibin2.done",
        tsv  = f"{BIN_DIR}/{SAMPLE}/semibin2_contig2bin.tsv"
    threads: THREADS
    shell:
        '''
        export PATH={BINNING_ENV}:$PATH
        mkdir -p {output.bins}
        {SEMIBIN2} single_easy_bin --input-fasta {input.contigs} --input-bam {input.bam} --output {BIN_DIR}/{SAMPLE}/semibin2_tmp --threads {threads} --min-len {SEMIBIN_MIN_LEN}
        # Normalize outputs to fasta pattern
        find {BIN_DIR}/{SAMPLE}/semibin2_tmp/output_bins -name "*.fa" -exec cp {{}} {output.bins}/ \\; || true
        # Generate contig2bin definition safely
        > {output.tsv}
        for f in {output.bins}/*.fa; do
          [ -f "$f" ] || continue
          bin=$(basename "$f" .fa)
          awk '/^>/{{split($1,a,">");print a[2]"\\t"bin}}' bin="$bin" "$f" >> {output.tsv}
        done
        touch {output.done}
        '''

rule virsorter2:
    input:
        contigs = f"{ASSEMBLY_DIR}/{SAMPLE}_final.contigs.fa"
    output:
        done = f"{VIRAL_DIR}/{SAMPLE}/virsorter2.done"
    threads: THREADS
    shell:
        r'''
        set -euo pipefail
        export PATH={VIRSORTER2_ENV}:$PATH
        workdir="{VIRAL_DIR}/{SAMPLE}/virsorter2"
        db_runtime="{VIRAL_DIR}/{SAMPLE}/virsorter_db_runtime"
        rm -rf "$workdir" "$db_runtime"
        mkdir -p "$workdir" "$db_runtime/conda_envs"

        # VirSorter writes internal environments below --db-dir. Keep the
        # reference database read-only and expose it through writable links.
        for item in {VIRSORTER2_DB}/*; do
          [ -e "$item" ] || continue
          [ "$(basename "$item")" = "conda_envs" ] && continue
          ln -sfn "$item" "$db_runtime/$(basename "$item")"
        done
        for item in {VIRSORTER2_DB}/conda_envs/*; do
          [ -e "$item" ] || continue
          ln -sfn "$item" "$db_runtime/conda_envs/$(basename "$item")"
        done

        {VIRSORTER2} run -i {input.contigs} -w "$workdir" -j {threads} --db-dir "$db_runtime" --min-length {VIRSORTER_MIN_LENGTH} --min-score {VIRSORTER_MIN_SCORE} all
        touch {output.done}
        '''

rule gunc:
    input:
        bins = f"{DAS_DIR}/{SAMPLE}_DASTool_bins_clean"
    output:
        report = f"{GUNC_DIR}/{SAMPLE}/gunc_maxcss.tsv"
    threads: THREADS
    shell:
        r'''
        set -euo pipefail
        export PATH={GUNC_ENV}:$PATH
        mkdir -p {GUNC_DIR}/{SAMPLE}/tmp {GUNC_DIR}/{SAMPLE}/output
        bin_count=$(find {input.bins} -maxdepth 1 -name "*.fa" | wc -l | tr -d '[:space:]')
        bin_count="${{bin_count:-0}}"
        if [ "$bin_count" -eq 0 ]; then
          printf "genome\tclade_separation_score\tpass.GUNC\n" > {output.report}
          echo "[gunc] No final bins — writing an empty report." >&2
          exit 0
        fi
        {GUNC_BIN} run --input_dir {input.bins} --file_suffix .fa --db_file {GUNC_DB} --threads {threads} --min_mapped_genes {GUNC_MIN_MAPPED_GENES} --temp_dir {GUNC_DIR}/{SAMPLE}/tmp --out_dir {GUNC_DIR}/{SAMPLE}/output
        shopt -s nullglob
        reports=({GUNC_DIR}/{SAMPLE}/output/GUNC.*.maxCSS_level.tsv)
        if [ "${{#reports[@]}}" -eq 0 ]; then
          echo "[gunc] ERROR: expected maxCSS report was not produced." >&2
          exit 1
        fi
        cp "${{reports[0]}}" {output.report}
        '''
