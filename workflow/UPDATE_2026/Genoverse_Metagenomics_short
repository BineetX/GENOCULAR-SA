rule hadeg_proteinortho:
    input:
        hadeg_db    = HADEG_DB,
        prokka_done = f"{PROKKA_DIR}/{{sample}}/prokka.done",
        mags        = lambda wc: expand(
            f"{PROKKA_DIR}/{{sample}}/{{mag}}/{{mag}}.faa",
            sample=wc.sample,
            mag=get_filtered_mags(wc)
        )
    output:
        tsv  = f"{HADEG_OUTDIR}/{{sample}}/Results_HADEG.proteinortho.tsv",
        done = f"{HADEG_OUTDIR}/{{sample}}/hadeg_proteinortho.done"
    threads: THREADS
    shell:
        r"""
        set -euo pipefail
        mkdir -p {HADEG_OUTDIR}/{wildcards.sample}

        HADEG_DB_ABS="{input.hadeg_db}"
        if [ ! -f "$HADEG_DB_ABS" ]; then
            echo "[HADEG] ERROR: database not found at $HADEG_DB_ABS" >&2
            exit 1
        fi

        # ── Sanitize all prokka FAA files ────────────────────────────────────
        # proteinortho >=6.3 rejects stop-codon '*' characters that prokka
        # writes by default.  Strip them (and any other non-amino-acid chars)
        # into a temporary clean_faa directory before calling proteinortho.
        CLEAN_DIR="{HADEG_OUTDIR}/{wildcards.sample}/clean_faa"
        mkdir -p "$CLEAN_DIR"
        clean_mags=""
        for f in {input.mags}; do
            case "$f" in
                /*) abs_f="$f" ;;
                *)  abs_f="$(pwd)/$f" ;;
            esac
            base=$(basename "$f")
            clean_f="$CLEAN_DIR/$base"
            sed -E '/^>/! s/[^XOUBZACDEFGHIKLMNPQRSTVWYxoubzacdefghiklmnpqrstvwy]//g; /^$/d' \
                "$abs_f" > "$clean_f"
            clean_mags="$clean_mags $clean_f"
        done
        echo "[HADEG] Sanitized $(echo $clean_mags | wc -w) MAG FAA files → $CLEAN_DIR" >&2

        # ── Also sanitize the HADEG database FAA ─────────────────────────────
        CLEAN_DB="$CLEAN_DIR/$(basename {input.hadeg_db})"
        sed -E '/^>/! s/[^XOUBZACDEFGHIKLMNPQRSTVWYxoubzacdefghiklmnpqrstvwy]//g; /^$/d' \
            "$HADEG_DB_ABS" > "$CLEAN_DB"

        mag_count=$(echo $clean_mags | wc -w)
        echo "[HADEG] Running proteinortho with $mag_count MAG FAA file(s)" >&2
        if [ "$mag_count" -eq 0 ]; then
            echo "[HADEG] WARNING: No filtered MAG FAA files found. Writing empty TSV and skipping proteinortho." >&2
            printf "# Species\tGenes\tAlg.-Conn.\t$(basename {input.hadeg_db})\n" \
                > "{output.tsv}"
            touch "{output.done}"
            exit 0
        fi

        # ── Run proteinortho from the output directory ────────────────────────
        cd {HADEG_OUTDIR}/{wildcards.sample}
        PROTEINORTHO_BIN="{PROTEINORTHO}"
        DIAMOND_BIN="{HADEG_DIAMOND}"
        if [ "$PROTEINORTHO_BIN" != "$(basename "$PROTEINORTHO_BIN")" ]; then
            export PATH="$(dirname "$PROTEINORTHO_BIN"):$PATH"
        fi
        if [ "$DIAMOND_BIN" != "$(basename "$DIAMOND_BIN")" ]; then
            export PATH="$(dirname "$DIAMOND_BIN"):$PATH"
        fi
        if ! command -v diamond >/dev/null 2>&1; then
            echo "[HADEG] ERROR: DIAMOND not found for Proteinortho HADEG run." >&2
            exit 1
        fi
        "{HADEG_PYTHON}" "{HADEG_RUNNER}" \
          --proteinortho "$PROTEINORTHO_BIN" \
          --diamond "$DIAMOND_BIN" \
          --workdir "$PWD" \
          --project Results_HADEG \
          --threads {threads} \
          --stall-seconds {HADEG_STALL_SECONDS} \
          --max-attempts {HADEG_MAX_ATTEMPTS} \
          "$CLEAN_DB" $clean_mags

        RESULT_TSV="{HADEG_OUTDIR}/{wildcards.sample}/Results_HADEG.proteinortho.tsv"
        if [ ! -s "$RESULT_TSV" ]; then
            echo "[HADEG] ERROR: $RESULT_TSV is empty or missing" >&2
            exit 1
        fi
        touch "{output.done}"
        """


