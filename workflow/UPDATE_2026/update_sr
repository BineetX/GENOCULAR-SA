rule prodigal_predict:
    input: drep_dir=DREP_OUTPUT, drep_done=DREP_DONE
    output:
        faa=f"{ANNOTATION_DIR}/{SAMPLE}/representative_proteins.faa",
        fna=f"{ANNOTATION_DIR}/{SAMPLE}/representative_genes.fna",
        gff=f"{ANNOTATION_DIR}/{SAMPLE}/representative_genes.gff",
        done=f"{ANNOTATION_DIR}/{SAMPLE}/prodigal.done"
    log: f"{LOG_DIR}/annotation/{SAMPLE}.prodigal.log"
    threads: 1
    resources: mem_mb=8000, runtime=RUNTIME_MIN
    run:
        output_dir = Path(f"{ANNOTATION_DIR}/{SAMPLE}")
        per_mag = output_dir / "per_mag"
        shutil.rmtree(per_mag, ignore_errors=True); per_mag.mkdir(parents=True, exist_ok=True)
        for path in (output.faa, output.fna):
            Path(path).parent.mkdir(parents=True, exist_ok=True); Path(path).write_text("")
        Path(output.gff).parent.mkdir(parents=True, exist_ok=True); Path(output.gff).write_text("##gff-version 3\n")
        
        genomes = sorted((Path(input.drep_dir) / "dereplicated_genomes").glob("*.fa"))
        Path(log[0]).parent.mkdir(parents=True, exist_ok=True); Path(log[0]).write_text("")
        
        env = os.environ.copy()
        env["PATH"] = str(Path(PRODIGAL).parent) + os.pathsep + env.get("PATH", "")
        
        for genome in genomes:
            mag = clean_mag_id(genome.name)
            prefixed, faa, fna, gff = per_mag/f"{mag}.prefixed.fa", per_mag/f"{mag}.faa", per_mag/f"{mag}.fna", per_mag/f"{mag}.gff"
            prefix_fasta(genome, prefixed, mag)
            total_length = fasta_metrics(genome)["total_length"]
            
            mode = PRODIGAL_MODE
            if mode == "auto":
                mode = "single" if total_length >= 100000 else "meta"
            
            command = [PRODIGAL, "-i", str(prefixed), "-a", str(faa), "-d", str(fna), "-o", str(gff), "-f", "gff", "-p", mode, "-q"]
            with open(log[0], "ab") as log_handle:
                subprocess.run(command, stdout=log_handle, stderr=subprocess.STDOUT, env=env, check=True)
            
            for src, dst in ((faa, output.faa), (fna, output.fna)):
                with open(src, "rb") as s, open(dst, "ab") as d: shutil.copyfileobj(s, d)
            with open(gff) as s, open(output.gff, "a") as d:
                for line in s:
                    if not line.startswith("##gff-version"): d.write(line)
        Path(output.done).write_text("completed\n")

rule prokka:
    input: fasta=f"{DREP_OUTPUT}/dereplicated_genomes/{{mag}}.fa", drep_done=DREP_DONE, gtdb_dir=GTDB_OUTPUT, gtdb_done=GTDB_DONE
    output: gff=f"{PROKKA_DIR}/{{sample}}/{{mag}}/{{mag}}.gff", faa=f"{PROKKA_DIR}/{{sample}}/{{mag}}/{{mag}}.faa"
    log: f"{LOG_DIR}/annotation/{{sample}}_{{mag}}_prokka.log"
    threads: MAG_THREADS
    run:
        outdir = Path(output.gff).parent; shutil.rmtree(outdir, ignore_errors=True); outdir.mkdir(parents=True, exist_ok=True)
        kingdom = "Bacteria"
        if PROKKA_KINGDOM == "auto":
            for summary in Path(input.gtdb_dir).rglob("*summary.tsv"):
                if "ar53" in summary.name: kingdom = "Archaea"
        env = os.environ.copy()
        env["PATH"] = PROKKA_ENV + os.pathsep + env.get("PATH", "")
        command = [PROKKA, "--outdir", str(outdir), "--prefix", wildcards.mag, "--kingdom", kingdom, "--cpus", str(threads), "--force", "--compliant", "--metagenome", input.fasta]
        with open(log[0], "wb") as log_handle:
            subprocess.run(command, stdout=log_handle, stderr=subprocess.STDOUT, env=env, check=True)

