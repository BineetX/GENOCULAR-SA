def as_bool(value):
    if isinstance(value, bool): return value
    if isinstance(value, str):
        value = value.strip().lower()
        if value in {"true", "yes", "1", "on"}: return True
        if value in {"false", "no", "0", "off", ""}: return False
    return bool(value)

def clean_mag_id(value):
    value = os.path.basename(str(value).strip())
    for suffix in (".fasta.gz", ".fna.gz", ".fa.gz", ".fasta", ".fna", ".fa"):
        if value.endswith(suffix): return value[:-len(suffix)]
    return value

def parse_float(value):
    try:
        if value is None or str(value).strip().lower() in {"", "na", "nan", "none"}: return None
        return float(value)
    except (TypeError, ValueError): return None

def parse_bool(value):
    if isinstance(value, bool): return value
    if value is None: return None
    value = str(value).strip().lower()
    if value in {"true", "1", "yes", "pass", "passed"}: return True
    if value in {"false", "0", "no", "fail", "failed"}: return False
    return None

def gzip_has_data(path):
    try:
        with gzip.open(path, "rb") as handle: return bool(handle.read(1))
    except OSError: return False

def fasta_records(path):
    name = None
    sequence = []
    with open(path, "rt") as handle:
        for line in handle:
            line = line.strip()
            if not line: continue
            if line.startswith(">"):
                if name is not None: yield name, "".join(sequence)
                name = line[1:].split()[0]
                sequence = []
            else: sequence.append(line)
        if name is not None: yield name, "".join(sequence)

def fasta_metrics(path):
    lengths, gc, total = [], 0, 0
    for _, sequence in fasta_records(path):
        length = len(sequence)
        lengths.append(length)
        total += length
        gc += sequence.upper().count("G") + sequence.upper().count("C")
    lengths.sort(reverse=True)
    threshold = total / 2.0
    cumulative, n50 = 0, 0
    for length in lengths:
        cumulative += length
        if cumulative >= threshold:
            n50 = length
            break
    return {
        "contig_count": len(lengths), "total_length": total, "n50": n50,
        "gc_percent": round((100.0 * gc / total), 6) if total else 0.0,
    }

def write_contig2bin(bin_dir, output_tsv):
    rows = []
    for fasta in sorted(Path(bin_dir).glob("*.fa")):
        bin_id = fasta.stem
        for contig, _ in fasta_records(fasta): rows.append((contig, bin_id))
    Path(output_tsv).parent.mkdir(parents=True, exist_ok=True)
    with open(output_tsv, "w", newline="") as handle:
        writer = csv.writer(handle, delimiter="\t", lineterminator="\n")
        writer.writerows(rows)

def normalize_bins(source_paths, destination):
    destination = Path(destination)
    shutil.rmtree(destination, ignore_errors=True)
    destination.mkdir(parents=True, exist_ok=True)
    copied = 0
    for source in sorted({Path(path) for path in source_paths if Path(path).is_file()}):
        if source.stat().st_size == 0: continue
        target = destination / f"{clean_mag_id(source.name)}.fa"
        shutil.copyfile(source, target)
        copied += 1
    return copied

def first_existing(paths):
    for path in paths:
        if os.path.isfile(path): return path
    raise FileNotFoundError("None of the expected files exists: " + ", ".join(map(str, paths)))

def run_command(command, log_path, cwd=None, append=False, env=None):
    Path(log_path).parent.mkdir(parents=True, exist_ok=True)
    mode = "ab" if append else "wb"
    run_env = env if env is not None else os.environ.copy()
    if isinstance(command, list) and len(command) > 0:
        binary_path = Path(command[0])
        if binary_path.is_absolute():
            run_env["PATH"] = str(binary_path.parent) + os.pathsep + run_env.get("PATH", "")
    elif isinstance(command, str):
        try:
            tokens = shlex.split(command)
            if tokens:
                binary_path = Path(tokens[0])
                if binary_path.is_absolute():
                    run_env["PATH"] = str(binary_path.parent) + os.pathsep + run_env.get("PATH", "")
        except Exception:
            pass
    with open(log_path, mode) as log_handle:
        subprocess.run(command, cwd=cwd, stdout=log_handle, stderr=subprocess.STDOUT, env=run_env, check=True)

def fastqc_stem(path):
    name = Path(path).name
    for suffix in (".gz", ".bz2", ".fastq", ".fq"):
        if name.endswith(suffix): name = name[:-len(suffix)]
    return name

def run_fastqc(inputs, outputs, log_path, threads):
    output_parent = Path(outputs[0]).parent
    output_parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="fastqc_", dir=str(output_parent)) as tmpdir:
        run_command([FASTQC, "--threads", str(threads), "--outdir", tmpdir, *map(str, inputs)], log_path)
        generated = []
        for input_path in inputs:
            stem = fastqc_stem(input_path)
            generated.extend([
                os.path.join(tmpdir, f"{stem}_fastqc.html"),
                os.path.join(tmpdir, f"{stem}_fastqc.zip"),
            ])
        for source, target in zip(generated, outputs):
            if not os.path.isfile(source): raise FileNotFoundError(source)
            Path(target).parent.mkdir(parents=True, exist_ok=True)
            shutil.move(source, target)

def prefix_fasta(input_path, output_path, prefix):
    with open(output_path, "w") as output_handle:
        for name, sequence in fasta_records(input_path):
            output_handle.write(f">{prefix}|{name}\n")
            for start in range(0, len(sequence), 80):
                output_handle.write(sequence[start:start + 80] + "\n")

