                SEMIBIN2, "single_easy_bin", "--input-fasta", input.contigs, "--input-bam", input.bam,
                "--output", workdir, "--threads", str(threads), "--min-len", str(SEMIBIN_MIN_CONTIG),
            ]
            if SEMIBIN_USE_PRETRAINED: command.extend(["--environment", SEMIBIN_ENVIRONMENT])
            with open(log[0], "wb") as log_handle:
                subprocess.run(command, stdout=log_handle, stderr=subprocess.STDOUT, env=env, check=True)
            
            # Debug traces for output directory structure diagnostics
            import sys
            print(f"DEBUG SEMIBIN2: workdir is {workdir}", file=sys.stderr)
            for root, dirs, files in os.walk(workdir):
                print(f"DEBUG SEMIBIN2: walk {root} -> dirs: {dirs}, files: {files}", file=sys.stderr)
                
            candidates = []
            for dirname in (".", "output_recluster_bins", "output_bins"):
                candidate_dir = Path(workdir) / dirname
                if candidate_dir.is_dir():
                    candidates.extend(candidate_dir.glob("*.fa"))
                    candidates.extend(candidate_dir.glob("*.fasta"))
            print(f"DEBUG SEMIBIN2: Candidates list: {candidates}", file=sys.stderr)
            normalize_bins(candidates, output.bins)
        write_contig2bin(output.bins, output.tsv)

