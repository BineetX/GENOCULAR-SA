            Path(output.summary).write_text("#FILE\tNUM_FOUND\n")
            Path(log[0]).write_text("No dereplicated MAGs were available\n")
        else:
            env = os.environ.copy()
            env["PATH"] = ABRICATE_ENV + os.pathsep + env.get("PATH", "")
            command = [ABRICATE, "--summary", *map(str, tables)]
            with open(output.summary, "wb") as out_handle, open(log[0], "wb") as log_handle:
