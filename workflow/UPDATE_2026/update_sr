rule dram_per_mag:
    input:
        fasta=f"{DREP_OUTPUT}/dereplicated_genomes/{{mag}}.fa",
        drep_done=DREP_DONE
    output:
        done=f"{DRAM_DIR}/{{sample}}/{{mag}}/dram.done"
    log:
        f"{LOG_DIR}/annotation/{{sample}}_{{mag}}_dram.log"
    threads: MAG_THREADS
    run:
        outdir = Path(DRAM_DIR) / wildcards.sample / wildcards.mag
        shutil.rmtree(outdir, ignore_errors=True)
        outdir.parent.mkdir(parents=True, exist_ok=True)
        Path(log[0]).parent.mkdir(parents=True, exist_ok=True)

        env = os.environ.copy()
        if DRAM_ENV:
            env["PATH"] = DRAM_ENV + os.pathsep + env.get("PATH", "")

        annotate_command = [
            DRAM_BIN,
            "annotate",
            "-i", input.fasta,
            "-o", str(outdir),
            "--threads", str(threads),
            "--min_contig_size", "1000",
        ]
        with open(log[0], "wb") as log_handle:
            subprocess.run(
                annotate_command,
                stdout=log_handle,
                stderr=subprocess.STDOUT,
                env=env,
                check=True,
            )

            annotations = outdir / "annotations.tsv"
            if not annotations.is_file() or annotations.stat().st_size == 0:
                raise FileNotFoundError(f"DRAM annotate did not create {annotations}")

            distill_command = [
                DRAM_BIN,
                "distill",
                "-i", str(annotations),
                "-o", str(outdir / "distillate"),
            ]
            trna_path = outdir / "trnas.tsv"
            rrna_path = outdir / "rrnas.tsv"
            if trna_path.is_file():
                distill_command.extend(["--trna_path", str(trna_path)])
            if rrna_path.is_file():
                distill_command.extend(["--rrna_path", str(rrna_path)])

            subprocess.run(
                distill_command,
                stdout=log_handle,
                stderr=subprocess.STDOUT,
                env=env,
                check=True,
            )

        Path(output.done).touch()

