rule hadeg_proteinortho:
    input: hadeg_db=lambda wc: HADEG_DB, prokka_done=f"{PROKKA_DIR}/{{sample}}/prokka.done", mags=hadeg_mag_inputs
    output: tsv=f"{HADEG_OUTDIR}/{{sample}}/Results_HADEG.proteinortho.tsv", done=f"{HADEG_OUTDIR}/{{sample}}/hadeg_proteinortho.done"
    log: f"{LOG_DIR}/annotation/{{sample}}_hadeg.log"
    threads: THREADS
    run:
        outdir = Path(output.tsv).parent.resolve(); clean_dir = outdir / "clean_faa"
        shutil.rmtree(clean_dir, ignore_errors=True); clean_dir.mkdir(parents=True, exist_ok=True)
        hadeg_db = Path(input.hadeg_db).resolve()
        
        def sanitize_fasta(src, dst):
            allowed = re.compile(r"[^XOUBZACDEFGHIKLMNPQRSTVWY]", re.IGNORECASE)
            with open(src) as s, open(dst, "w") as d:
                for line in s:
                    if line.startswith(">"): d.write(line)
                    elif (seq := allowed.sub("", line.strip())): d.write(seq + "\n")
        
        sanitize_fasta(hadeg_db, clean_dir / hadeg_db.name)
        clean_mags = []
        for src in input.mags:
            tgt = clean_dir / Path(src).name
            sanitize_fasta(src, tgt); clean_mags.append(str(tgt.resolve()))
            
        if not clean_mags:
            Path(output.tsv).write_text(f"# Species\tGenes\tAlg.-Conn.\t{hadeg_db.name}\n")
        else:
            env = os.environ.copy()
            env["PATH"] = str(Path(PROTEINORTHO).parent) + os.pathsep + env.get("PATH", "")
            with open(log[0], "wb") as log_handle:
                subprocess.run([PROTEINORTHO, str((clean_dir / hadeg_db.name).resolve()), *clean_mags, "-identity=50", "-conn=0.3", "-synteny=0", "-project=Results_HADEG", f"-binpath={HADEG_BLAST_BINPATH}", f"-cpus={threads}"], cwd=outdir, stdout=log_handle, stderr=subprocess.STDOUT, env=env, check=True)
        Path(output.done).touch()

