rule bowtie2_map:
    input: r1=CLEAN_R1, r2=CLEAN_R2, singletons=CLEAN_SINGLETONS, index_dir=f"{MAP_DIR}/{SAMPLE}_index"
    output: bam=MAPPING_BAM, bai=MAPPING_BAI
    log: f"{LOG_DIR}/mapping/{SAMPLE}.bowtie2.log"
    threads: THREADS
    run:
        Path(MAP_DIR).mkdir(parents=True, exist_ok=True)
        Path(log[0]).parent.mkdir(parents=True, exist_ok=True)
        align_threads = max(1, threads // 2)
        sort_threads = max(1, threads - align_threads)
        singleton = f" -U {shlex.quote(input.singletons)}" if gzip_has_data(input.singletons) else ""
        command = (
            f"export PATH={MAPPING_ENV}:$PATH; set -euo pipefail; "
            f"{shlex.quote(BOWTIE2)} --very-sensitive -x {shlex.quote(os.path.join(input.index_dir, 'index'))} "
            f"-1 {shlex.quote(input.r1)} -2 {shlex.quote(input.r2)}{singleton} "
            f"-p {align_threads} --no-unal 2> {shlex.quote(log[0])} | "
            f"{shlex.quote(SAMTOOLS)} sort -@ {sort_threads} -o {shlex.quote(output.bam)} - "
            f">> {shlex.quote(log[0])} 2>&1; "
            f"{shlex.quote(SAMTOOLS)} index -@ {sort_threads} {shlex.quote(output.bam)} {shlex.quote(output.bai)}"
        )
        subprocess.run(["bash", "-c", command], check=True)

