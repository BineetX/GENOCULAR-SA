rule host_decontaminate:
    input: r1=FASTP_R1, r2=FASTP_R2, singletons=FASTP_SINGLETONS
    output: r1=HOST_R1, r2=HOST_R2, singletons=HOST_SINGLETONS
    log: f"{LOG_DIR}/host_removal/{SAMPLE}.log"
    threads: THREADS
    resources: mem_mb=MEMORY_MB, runtime=RUNTIME_MIN
    run:
        if not HOST_ENABLED: raise ValueError("host_decontaminate requested but disabled")
        Path(HOST_DIR).mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(prefix=f"{SAMPLE}_host_", dir=HOST_DIR) as workdir:
            input_dir, paired_dir, single_dir = Path(workdir)/"input", Path(workdir)/"paired", Path(workdir)/"single"
            input_dir.mkdir(); paired_dir.mkdir(); single_dir.mkdir()
            paired_r1, paired_r2 = input_dir/f"{SAMPLE}_R1.trimmed.fastq", input_dir/f"{SAMPLE}_R2.trimmed.fastq"
            with gzip.open(input.r1, "rb") as source, open(paired_r1, "wb") as target: shutil.copyfileobj(source, target)
            with gzip.open(input.r2, "rb") as source, open(paired_r2, "wb") as target: shutil.copyfileobj(source, target)
            
            # Using env path resolving
            env = os.environ.copy()
            env["PATH"] = KNEADDATA_ENV + os.pathsep + env.get("PATH", "")
            
            paired_command = [
                KNEADDATA, "--input1", str(paired_r1), "--input2", str(paired_r2),
                "--output", str(paired_dir), "--output-prefix", SAMPLE,
                "--reference-db", str(HOST_DB), "--threads", str(threads),
                "--bypass-trim", "--bypass-trf", "--log", log[0],
            ]
            if HOST_BOWTIE2_OPTIONS: paired_command.append(f"--bowtie2-options={HOST_BOWTIE2_OPTIONS}")
            subprocess.run(paired_command, env=env, check=True)
            
            paired_1 = first_existing([paired_dir/f"{SAMPLE}_paired_1.fastq", paired_dir/f"{SAMPLE}_kneaddata_paired_1.fastq"])
            paired_2 = first_existing([paired_dir/f"{SAMPLE}_paired_2.fastq", paired_dir/f"{SAMPLE}_kneaddata_paired_2.fastq"])
            for source, target in ((paired_1, output.r1), (paired_2, output.r2)):
                with open(target, "wb") as compressed:
                    subprocess.run([PIGZ, "-p", str(threads), "-c", str(source)], stdout=compressed, check=True)

            singleton_sources = []
            if gzip_has_data(input.singletons):
                singleton_input = input_dir/f"{SAMPLE}_singletons.trimmed.fastq"
                with gzip.open(input.singletons, "rb") as source, open(singleton_input, "wb") as target: shutil.copyfileobj(source, target)
                single_command = [
                    KNEADDATA, "--unpaired", str(singleton_input), "--output", str(single_dir),
                    "--output-prefix", f"{SAMPLE}_singletons", "--reference-db", str(HOST_DB),
                    "--threads", str(threads), "--bypass-trim", "--bypass-trf", "--log", str(Path(workdir)/"singletons.log"),
                ]
                subprocess.run(single_command, env=env, check=True)
                singleton_final = next((candidate for candidate in (single_dir/f"{SAMPLE}_singletons.fastq", single_dir/f"{SAMPLE}_singletons_kneaddata.fastq") if candidate.is_file()), None)
                if singleton_final: singleton_sources.append(singleton_final)
            
            combined_singletons = Path(workdir)/"singletons.fastq"
            with open(combined_singletons, "wb") as target:
                for source in singleton_sources:
                    with open(source, "rb") as handle: shutil.copyfileobj(handle, target)
            with open(output.singletons, "wb") as compressed:
                subprocess.run([PIGZ, "-p", str(threads), "-c", str(combined_singletons)], stdout=compressed, check=True)

