rule das_tool:
    input:
        metabat=f"{BIN_DIR}/{SAMPLE}/metabat2.tsv", semibin=f"{BIN_DIR}/{SAMPLE}/semibin2.tsv",
        maxbin=f"{BIN_DIR}/{SAMPLE}/maxbin2.tsv", contigs=CONTIGS
    output: bins=directory(REFINED_BINS), summary=f"{BIN_DIR}/{SAMPLE}/dastool_summary.tsv"
    log: f"{LOG_DIR}/binning/{SAMPLE}.dastool.log"
    threads: THREADS
    run:
        available = []
        for label, path in (("metabat2", input.metabat), ("semibin2", input.semibin), ("maxbin2", input.maxbin)):
            if os.path.isfile(path) and os.path.getsize(path) > 0: available.append((label, path))
        shutil.rmtree(output.bins, ignore_errors=True)
        Path(output.bins).mkdir(parents=True, exist_ok=True)
        Path(output.summary).parent.mkdir(parents=True, exist_ok=True)
        if not available:
            with open(output.summary, "w") as handle: handle.write("bin\tunique_bacterial_single_copy_genes\tduplicate_bacterial_single_copy_genes\n")
        else:
            env = os.environ.copy()
            env["PATH"] = BINNING_ENV + os.pathsep + env.get("PATH", "")
            with tempfile.TemporaryDirectory(prefix="dastool_", dir=f"{BIN_DIR}/{SAMPLE}") as workdir:
                prefix = os.path.join(workdir, "refined")
                command = [
                    DASTOOL, "-i", ",".join(path for _, path in available), "-l", ",".join(label for label, _ in available),
                    "-c", input.contigs, "-o", prefix, "--write_bins", "--score_threshold", str(DASTOOL_SCORE), "-t", str(threads),
                ]
                with open(log[0], "wb") as log_handle:
                    subprocess.run(command, stdout=log_handle, stderr=subprocess.STDOUT, env=env, check=True)
                source_bins = f"{prefix}_DASTool_bins"
                candidates = []
                if os.path.isdir(source_bins):
                    for extension in ("*.fa", "*.fasta", "*.fna"): candidates.extend(Path(source_bins).glob(extension))
                normalize_bins(candidates, output.bins)
                source_summary = f"{prefix}_DASTool_summary.txt"
                if os.path.isfile(source_summary): shutil.copyfile(source_summary, output.summary)
                else:
                    with open(output.summary, "w") as handle: handle.write("bin\tunique_bacterial_single_copy_genes\tduplicate_bacterial_single_copy_genes\n")

