rule semibin2:
    """
    SemiBin2 binning.

    FIXES vs the broken shell rule that was executing:
      1. Binary name: find the actual executable (SemiBin2 or SemiBin) at
         runtime rather than hardcoding — avoids the 'No such file' exit 127.
      2. BAM input: this hybrid pipeline has a merged BAM (lr+sr). Use the
         merged BAM for binning depth, not the sr-only BAM.
      3. Sequencing type: changed to long_read because the assembly is
         long-read (ONT via OPERA-MS); using short_read model on a long-read
         assembly degrades bin quality.
      4. Self-supervised first, fall back to --environment global on failure.
      5. Non-fatal: touch done and create empty output_bins on total failure
         so the DAG can continue to DAS_Tool / MetaBAT2-only mode.
    """
    input:
        contigs = assembly_fasta,
        bam     = f"{MAP_DIR}/{{sample}}.sorted.bam"   # merged BAM, not sr-only
    output:
        bins = directory(f"{BIN_DIR}/{{sample}}/semibin2/output_bins"),
        done = f"{BIN_DIR}/{{sample}}/semibin2.done"
    threads: THREADS
    resources:
        gpu = 1
    run:
        import subprocess, os as _os, glob as _glob, shutil

        semibin_outdir = f"{BIN_DIR}/{wildcards.sample}/semibin2"
        _os.makedirs(semibin_outdir, exist_ok=True)

        # ── Resolve actual binary name (SemiBin2 >= 2.x renamed to SemiBin2) ─
        binning_bin = SEMIBIN_ENV or BINNING_ENV
        if _os.path.exists(f"{binning_bin}/SemiBin2"):
            semibin_exe = f"{binning_bin}/SemiBin2"
        elif _os.path.exists(f"{binning_bin}/SemiBin"):
            semibin_exe = f"{binning_bin}/SemiBin"
        else:
            # Last resort: rely on PATH
            semibin_exe = "SemiBin2"
        print(f"[semibin2] Using binary: {semibin_exe}", flush=True)

        # ── Pre-check: skip if no contigs ────────────────────────────────────
        contig_count = 0
        try:
            with open(input.contigs) as fh:
                contig_count = sum(1 for l in fh if l.startswith(">"))
        except Exception:
            pass

        if contig_count == 0:
            print("[semibin2] WARNING: FASTA is empty. Skipping SemiBin2.", flush=True)
            _os.makedirs(output.bins, exist_ok=True)
            open(output.done, "w").close()
            return

        def run_semibin(mode_flag):
            cmd = (
                f"set -euo pipefail\n"
                f"export PATH={binning_bin}:$PATH\n"
                f"{semibin_exe} single_easy_bin "
                f"  -i {input.contigs} "
                f"  -b {input.bam} "
                f"  -o {semibin_outdir} "
                f"  --threads {threads} "
                f"  --min-len {SEMIBIN_MIN_LEN} "
                f"  --engine {SEMIBIN_ENGINE} "
                f"  --sequencing-type long_read "   # FIX: long_read for ONT assembly
                f"  {mode_flag}"
            )
            result = subprocess.run(["bash", "-c", cmd])
            return result.returncode

        # ── Try self-supervised, fall back to global preset ──────────────────
        rc = run_semibin("--self-supervised")
        bins_found = (
            _glob.glob(f"{semibin_outdir}/output_bins/*.fa")    +
            _glob.glob(f"{semibin_outdir}/output_bins/*.fasta") +
            _glob.glob(f"{semibin_outdir}/output_bins/*.fa.gz")  # SemiBin2 2.x writes .fa.gz
        )

        if rc != 0 or len(bins_found) == 0:
            print(
                "[semibin2] --self-supervised failed or produced 0 bins. "
                f"Retrying with --environment {SEMIBIN_ENVIRONMENT}.",
                flush=True
            )
            if _os.path.exists(semibin_outdir):
                shutil.rmtree(semibin_outdir)
            _os.makedirs(semibin_outdir, exist_ok=True)
            rc2 = run_semibin(f"--environment {SEMIBIN_ENVIRONMENT}")
            bins_found = (
                _glob.glob(f"{semibin_outdir}/output_bins/*.fa")    +
                _glob.glob(f"{semibin_outdir}/output_bins/*.fasta") +
                _glob.glob(f"{semibin_outdir}/output_bins/*.fa.gz")  # SemiBin2 2.x writes .fa.gz
            )
            if rc2 != 0 and len(bins_found) == 0:
                print(
                    "[semibin2] WARNING: Both modes produced 0 bins. "
                    "Continuing with MetaBAT2-only binning.",
                    flush=True
                )

        _os.makedirs(output.bins, exist_ok=True)
        print(f"[semibin2] Produced {len(bins_found)} bin(s) in {output.bins}", flush=True)
        open(output.done, "w").close()
        

rule metabat2_to_contig2bin:
    """
    Convert MetaBAT2 bins → DAS_Tool contig2bin TSV.
    Header row written for human readability; dastool rule strips it with tail -n +2.
    """
    input:
        done = f"{BIN_DIR}/{{sample}}/metabat2.done",
        bins = f"{BIN_DIR}/{{sample}}/metabat2"
    output:
        tsv = f"{BIN_DIR}/{{sample}}/metabat2_contig2bin.tsv"
    run:
        import glob as _glob
        rows = []
        for fa in _glob.glob(f"{input.bins}/*.fa"):
            bin_id = os.path.splitext(os.path.basename(fa))[0]
            with open(fa) as fh:
                for line in fh:
                    if line.startswith(">"):
                        ctg = line[1:].strip().split()[0]
                        rows.append(f"{ctg}\t{bin_id}")
        with open(output.tsv, "w") as out:
            out.write("contig\tbin_id\n")
            if rows:
                out.write("\n".join(rows) + "\n")
        print(f"[metabat2_to_contig2bin] Wrote {len(rows)} contig mappings → {output.tsv}")

rule semibin2_to_contig2bin:
    """
    Convert SemiBin2 bins → DAS_Tool contig2bin TSV.

    FIX: SemiBin2 >= 2.0 writes bins as .fa.gz (not .fa/.fasta).
    Glob all three extensions. Decompress .gz on the fly with gzip.open().
    Header row written for human readability; dastool rule strips it.
    """
    input:
        bins = f"{BIN_DIR}/{{sample}}/semibin2/output_bins",
        done = f"{BIN_DIR}/{{sample}}/semibin2.done"
    output:
        tsv  = f"{BIN_DIR}/{{sample}}/semibin2_contig2bin.tsv"
    run:
        import glob as _glob, gzip, os

        rows = []
        patterns = (
            _glob.glob(f"{input.bins}/*.fa")    +
            _glob.glob(f"{input.bins}/*.fasta") +
            _glob.glob(f"{input.bins}/*.fa.gz")        # FIX: SemiBin2 2.x writes .fa.gz
        )

        for fa in patterns:
            bin_id = os.path.splitext(os.path.basename(fa))[0]
            if fa.endswith(".gz"):
                bin_id = os.path.splitext(bin_id)[0]   # strip .fa from .fa.gz stem
                fh = gzip.open(fa, "rt")
            else:
                fh = open(fa)
            with fh:
                for line in fh:
                    if line.startswith(">"):
                        ctg = line[1:].strip().split()[0]
                        rows.append(f"{ctg}\t{bin_id}")

        with open(output.tsv, "w") as out:
            out.write("contig\tbin_id\n")
            if rows:
                out.write("\n".join(rows) + "\n")

        print(f"[semibin2_to_contig2bin] Wrote {len(rows)} contig mappings → {output.tsv}")


rule dastool:
    """
    Bin refinement with DAS_Tool.

    FIXES vs the broken shell rule:
      1. Strip header rows from both TSVs before passing to DAS_Tool
         (DAS_Tool R fread crashes on files with a header — empty or not).
      2. Check row counts AFTER stripping; skip any binner with 0 data rows
         so DAS_Tool never receives an empty input file.
      3. If BOTH binners produced 0 rows: skip DAS_Tool entirely,
         create empty output dirs, touch done — pipeline continues.
      4. Output dir `output.bins` is the actual DAS_Tool _DASTool_bins dir;
         created with mkdir -p as safety after DAS_Tool runs.
    """
    input:
        metabat = f"{BIN_DIR}/{{sample}}/metabat2_contig2bin.tsv",
        semibin = f"{BIN_DIR}/{{sample}}/semibin2_contig2bin.tsv",
        contigs = assembly_fasta
    output:
        bins = directory(f"{DAS_DIR}/{{sample}}_DASTool_bins"),
        done = f"{DAS_DIR}/{{sample}}.dastool.done"
    threads: THREADS
    shell:
        r"""
        set -euo pipefail
        export PATH={BINNING_ENV}:$PATH
        mkdir -p {DAS_DIR}

        BINDIR="{BIN_DIR}/{wildcards.sample}"
        PREFIX="{DAS_DIR}/{wildcards.sample}"

        # ── Strip header row (line 1) from each TSV ──────────────────────────
        MB_CLEAN="$BINDIR/metabat2_contig2bin.clean.tsv"
        SB_CLEAN="$BINDIR/semibin2_contig2bin.clean.tsv"

        tail -n +2 "{input.metabat}" > "$MB_CLEAN" || true
        tail -n +2 "{input.semibin}" > "$SB_CLEAN" || true

        mb_rows=$(wc -l < "$MB_CLEAN" | tr -d '[:space:]')
        sb_rows=$(wc -l < "$SB_CLEAN" | tr -d '[:space:]')
        mb_rows="${{mb_rows:-0}}"
        sb_rows="${{sb_rows:-0}}"

        echo "[dastool] MetaBAT2 data rows: $mb_rows  |  SemiBin2 data rows: $sb_rows"

        # ── Build -i / -l from whichever binners have data ───────────────────
        INPUT_TSVS=""
        LABELS=""

        if [ "$mb_rows" -gt 0 ] && [ "$sb_rows" -gt 0 ]; then
            INPUT_TSVS="$MB_CLEAN,$SB_CLEAN"
            LABELS="metabat2,semibin2"
        elif [ "$mb_rows" -gt 0 ]; then
            INPUT_TSVS="$MB_CLEAN"
            LABELS="metabat2"
        elif [ "$sb_rows" -gt 0 ]; then
            INPUT_TSVS="$SB_CLEAN"
            LABELS="semibin2"
        else
            echo "[dastool] WARNING: both binners produced 0 bins — skipping DAS_Tool." >&2
            mkdir -p "{output.bins}"
            touch "{output.done}"
            exit 0
        fi

        echo "[dastool] Running DAS_Tool: -i $INPUT_TSVS -l $LABELS"

        {DASTOOL} \
          -i "$INPUT_TSVS" \
          -l "$LABELS" \
          -c {input.contigs} \
          -o "$PREFIX" \
          -t {threads} \
          --score_threshold 0.2 \
          --write_bins

        # Safety: ensure output dir exists even if DAS_Tool produced 0 refined bins
        mkdir -p "{output.bins}"

        bc=$(find "{output.bins}" -maxdepth 1 -name "*.fa" | wc -l | tr -d '[:space:]')
        echo "[dastool] Produced ${{bc:-0}} refined bin(s) in {output.bins}"

        touch "{output.done}"
        """

# =============================================================================
# CHECKPOINT: select_dastool_bins
# Copies DAS_Tool refined bins to a clean directory, normalising .fa.fa double
# extensions produced when SemiBin2 bins pass through DAS_Tool --write_bins.
# Declared as a checkpoint so get_mags() can resolve the MAG list at DAG time.
# =============================================================================

checkpoint select_dastool_bins:
    """
    Copy DAS_Tool refined bins to a clean directory.
    Handles .fa.fa double-extension produced when SemiBin2 bins (SemiBin_N.fa)
    pass through DAS_Tool --write_bins, which appends another .fa extension.
    All files are normalised to a single .fa name in the output directory.
    Skips *_sub.fa files (DAS_Tool internal subscaffold artefacts).
    Must be a checkpoint (not a plain rule) so that get_mags() — which calls
    checkpoints.select_dastool_bins.get() — is resolved correctly by Snakemake.
    """
    input:
        bins_dir = f"{DAS_DIR}/{{sample}}_DASTool_bins",
        done     = f"{DAS_DIR}/{{sample}}.dastool.done"
    output:
        bins = directory(f"{DAS_DIR}/{{sample}}_DASTool_bins_clean"),
        done = f"{DAS_DIR}/{{sample}}_DASTool_bins_clean.done"
    shell:
        r"""
        set -euo pipefail
        mkdir -p {output.bins}
        shopt -s nullglob

        copied=0

        # Collect .fa and .fa.fa — DAS_Tool writes SemiBin_N.fa.fa
        # when SemiBin2 bins named SemiBin_N.fa pass through --write_bins
        for f in {input.bins_dir}/*.fa {input.bins_dir}/*.fa.fa; do
            [ -f "$f" ] || continue

            filename=$(basename "$f")

            # Normalise to single .fa extension
            case "$filename" in
                *.fa.fa) clean_name="${{filename%.fa.fa}}.fa" ;;
                *.fa)    clean_name="$filename" ;;
                *)       continue ;;
            esac

            # Skip DAS_Tool subscaffold artefacts (*_sub.fa)
            case "${{clean_name%.fa}}" in
                *_sub) continue ;;
            esac

            cp "$f" "{output.bins}/$clean_name"
            copied=$(( copied + 1 ))
        done

        echo "[select_dastool_bins] Copied $copied bin(s) to {output.bins}"

        bin_count=$(find {output.bins} -maxdepth 1 -name "*.fa" \
            | wc -l | tr -d "[:space:]")
        bin_count="${{bin_count:-0}}"
        echo "[select_dastool_bins] Retained $bin_count final MAG bin(s)"

        touch {output.done}
        """


