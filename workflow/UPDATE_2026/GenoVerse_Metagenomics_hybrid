rule fastp:
    """Short-read QC: adapter trimming, quality filtering, QC report."""
    input:
        r1 = config["reads"]["short_r1"],
        r2 = config["reads"]["short_r2"]
    output:
        r1   = f"{FASTP_DIR}/{{sample}}/R1_trimmed.fastq",
        r2   = f"{FASTP_DIR}/{{sample}}/R2_trimmed.fastq",
        json = f"{FASTP_DIR}/{{sample}}/fastp.json",
        html = f"{FASTP_DIR}/{{sample}}/fastp.html"
    threads: THREADS
    shell:
        """
        set -euo pipefail
        mkdir -p {FASTP_DIR}/{wildcards.sample}
        {FASTP} \
          --in1 {input.r1} --in2 {input.r2} \
          --out1 {output.r1} --out2 {output.r2} \
          --json {output.json} --html {output.html} \
          --detect_adapter_for_pe \
          --qualified_quality_phred {FASTP_QUALIFIED_Q} \
          --length_required {FASTP_MIN_LENGTH} \
          {FASTP_LOW_COMPLEXITY_FLAG} \
          {FASTP_CUT_FRONT_FLAG} {FASTP_CUT_TAIL_FLAG} \
          --thread {threads}
        """

rule kneaddata:
    """Short-read host removal using kneaddata + bowtie2 database."""
    input:
        r1 = f"{FASTP_DIR}/{{sample}}/R1_trimmed.fastq",
        r2 = f"{FASTP_DIR}/{{sample}}/R2_trimmed.fastq"
    output:
        r1  = f"{SR_HOST_DIR}/{{sample}}/R1_decontam.fastq",
        r2  = f"{SR_HOST_DIR}/{{sample}}/R2_decontam.fastq",
        log = f"{SR_HOST_DIR}/{{sample}}/kneaddata.log"
    threads: THREADS
    run:
        import os
        os.makedirs(f"{SR_HOST_DIR}/{wildcards.sample}", exist_ok=True)
        if HOST_DB and (os.path.exists(HOST_DB + ".1.bt2") or
                        os.path.exists(HOST_DB + ".1.bt2l")):
            shell(
                f"set -euo pipefail\n"
                f"export PATH={KNEADDATA_ENV}:$PATH\n"
                f"{KNEADDATA} "
                f"--input1 {input.r1} --input2 {input.r2} "
                f"--reference-db {HOST_DB} "
                f"--output {SR_HOST_DIR}/{wildcards.sample}/kneaddata_out "
                f"--threads {threads} "
                f"--bypass-trim "
                f"--bypass-trf "
                f"--output-prefix {wildcards.sample} "
                f"--log {output.log}\n"
                f"cp {SR_HOST_DIR}/{wildcards.sample}/kneaddata_out/"
                f"{wildcards.sample}_paired_1.fastq {output.r1}\n"
                f"cp {SR_HOST_DIR}/{wildcards.sample}/kneaddata_out/"
                f"{wildcards.sample}_paired_2.fastq {output.r2}\n"
            )
        else:
            shell(f"cp {input.r1} {output.r1}")
            shell(f"cp {input.r2} {output.r2}")
            shell(f"echo 'No HOST_DB configured; kneaddata skipped.' > {output.log}")

rule kraken2:
    input:
        r1 = f"{SR_HOST_DIR}/{{sample}}/R1_decontam.fastq",
        r2 = f"{SR_HOST_DIR}/{{sample}}/R2_decontam.fastq"
