        bam        = f"{MAP_DIR}/{SAMPLE}.sorted.bam",
        checkm2    = f"{CHECKM_DIR}/{SAMPLE}/quality_report.tsv",
        busco      = f"{BUSCO_DIR}/{SAMPLE}/busco.done",
        merged_qc  = f"{MERGED_QC}/{SAMPLE}/combined_quality_summary.tsv",
        late       = lambda wildcards: [
            f"{GTDB_DIR}/{SAMPLE}/gtdbtk.bac120.summary.tsv",
            f"{GTDB_DIR}/{SAMPLE}/gtdbtk.ar53.summary.tsv",
            f"{DREP_DIR}/{SAMPLE}/dereplicated_genomes",
            f"{COVERM_DIR}/{SAMPLE}/coverage.tsv",
            f"{BARRNAP_DIR}/{SAMPLE}/barrnap.done",
            f"{QUANT_DIR}/{SAMPLE}/gene_counts.txt",
        ] + ([f"{PROKKA_DIR}/{SAMPLE}/prokka.done"] if RUN_PROKKA_CHAIN else []) \
          + ([f"{CCTYPER_DIR}/{SAMPLE}/cctyper.done"] if RUN_CCTYPER else []) \
          + ([f"{DBCAN_DIR}/{SAMPLE}/dbcan.done"] if RUN_DBCAN else []) \
          + ([f"{ABRICATE_DIR}/{SAMPLE}/abricate.done"] if RUN_ABRICATE else []) \
          + ([f"{VIRAL_DIR}/{SAMPLE}/virsorter2.done"] if RUN_VIRSORTER2 else []) \
          + ([f"{KRAKEN_DIR}/{SAMPLE}_bracken_species.tsv"] if RUN_KRAKEN else []) \
          + ([f"{HADEG_OUTDIR}/{SAMPLE}/hadeg_proteinortho.done"] if RUN_HADEG else []) \
          + ([f"{BUSCO_FILTERED_DIR}/{SAMPLE}/busco_filtered_all.done"] if RUN_BUSCO_FILTERED else []),
    output:
        sentinel = f"{MULTIQC_DIR}/{SAMPLE}_collect.done"
    run:
        import os
        os.makedirs(MULTIQC_DIR, exist_ok=True)
        optional = [
            f"{GTDB_DIR}/{SAMPLE}/gtdbtk.bac120.summary.tsv",
            f"{GTDB_DIR}/{SAMPLE}/gtdbtk.ar53.summary.tsv",
            f"{DREP_DIR}/{SAMPLE}/dereplicated_genomes",
            f"{COVERM_DIR}/{SAMPLE}/coverage.tsv",
            f"{BARRNAP_DIR}/{SAMPLE}/16S_detection_summary.tsv",
            f"{BARRNAP_DIR}/{SAMPLE}/barrnap.done",
            f"{PROKKA_DIR}/{SAMPLE}/prokka.done",
            f"{CCTYPER_DIR}/{SAMPLE}/cctyper.done",
            f"{DBCAN_DIR}/{SAMPLE}/dbcan.done",
            f"{ABRICATE_DIR}/{SAMPLE}/abricate.done",
            f"{VIRAL_DIR}/{SAMPLE}/virsorter2.done",
            f"{KRAKEN_DIR}/{SAMPLE}_bracken_species.tsv",
            f"{HADEG_OUTDIR}/{SAMPLE}/hadeg_proteinortho.done",
            f"{BUSCO_FILTERED_DIR}/{SAMPLE}/busco_filtered_all.done",
            f"{QUANT_DIR}/{SAMPLE}/gene_counts.txt",
        ]
        missing = [path for path in optional if not os.path.exists(path)]
        present = [path for path in optional if os.path.exists(path)]
        with open(output.sentinel, "w") as fh:
            fh.write(f"[multiqc_collect] Sample: {SAMPLE}\n")
            fh.write("Core inputs:     OK\n")
            fh.write(f"Optional present ({len(present)}/{len(optional)}):\n")
            for path in present:
                fh.write(f"  OK  {path}\n")
            if missing:
                fh.write(f"Optional missing/failed ({len(missing)}):\n")
                for path in missing:
                    fh.write(f"  --  {path}\n")
                print(
                    f"[multiqc_collect] WARNING: {len(missing)} optional output(s) not found.",
                    flush=True,
                )

rule multiqc:
    input:
        sentinel = f"{MULTIQC_DIR}/{SAMPLE}_collect.done"
    output:
        report = f"{MULTIQC_DIR}/multiqc_report.html"
    shell:
        """
        mkdir -p {MULTIQC_DIR}
        {MULTIQC} {OUTPUT_ROOT} -o {MULTIQC_DIR} --force
        """
