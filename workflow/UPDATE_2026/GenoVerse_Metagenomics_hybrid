# ── dRep — quality-weighted dereplication ────────────────────────────────────
rule drep:
    """
    Dereplication with dRep.

    FIXES:
      1. --processors (not -p) is dRep's correct thread flag.
      2. --S_algorithm: auto-detect skani → fastANI → ANImf at runtime.
         fastANI was hardcoded but is not installed in drep_env.
         skani ships with dRep >= 3.4 and is the preferred default.
      3. genome_info CSV uses bare basename (not full path) in the genome
         column — dRep resolves paths via -g; full paths caused key mismatches.
      4. Runtime failures propagate so non-dereplicated MAGs are never silently
         presented as a successful dRep result.
      5. Stale work directory (log/ subdir present) removed before re-run.
      6. No-MAG and single-MAG edge cases handled without crashing.
    """
    input:
        bins    = f"{FILTERED_DIR}/{{sample}}",
        done    = f"{FILTERED_DIR}/{{sample}}.filter.done",
        checkm2 = f"{CHECKM_DIR}/{{sample}}/quality_report.tsv"
    output:
        derep = directory(f"{DREP_DIR}/{{sample}}/dereplicated_genomes")
    threads: THREADS
    run:
        import os, shutil, subprocess, csv as _csv

        drep_env = {**os.environ,
                    "PATH": f"{DREP_ENV}:{os.environ.get('PATH', '')}"}

        out_base = f"{DREP_DIR}/{wildcards.sample}"
        os.makedirs(out_base, exist_ok=True)

        fa_files = sorted(
            os.path.join(input.bins, f)
            for f in os.listdir(input.bins)
            if f.endswith(".fa")
        )

        # ── Edge: no filtered MAGs ────────────────────────────────────────────
        if len(fa_files) == 0:
            os.makedirs(output.derep, exist_ok=True)
            print("[drep] No filtered MAGs — skipping dereplication.", flush=True)
            return

        # ── Edge: only 1 MAG — dRep needs >=2 for clustering ─────────────────
        if len(fa_files) == 1:
            print("[drep] Only 1 MAG — skipping dRep, copying directly.", flush=True)
            os.makedirs(output.derep, exist_ok=True)
            shutil.copy(fa_files[0], os.path.join(output.derep, os.path.basename(fa_files[0])))
            return

        # ── Remove stale dRep work dir BEFORE writing genome_info.csv ─────────
        # CRITICAL: must happen before genome_info.csv is written — previously
        # the CSV was written first then rmtree deleted it, causing FileNotFoundError
        if os.path.isdir(os.path.join(out_base, "log")):
            shutil.rmtree(out_base)
            print(f"[drep] Removed stale work dir: {out_base}", flush=True)
        os.makedirs(out_base, exist_ok=True)
        os.makedirs(output.derep, exist_ok=True)

        # ── Build genomeInfo CSV from CheckM2 output ──────────────────────────
        genome_info_path = os.path.join(out_base, "genome_info.csv")
        checkm2_data = {}
        try:
            import pandas as _pd
            ckm = _pd.read_csv(input.checkm2, sep="\t")
            for _, row in ckm.iterrows():
                stem = os.path.splitext(os.path.basename(str(row.get("Name", "")).strip()))[0]
                comp_raw = row.get("Completeness")
                cont_raw = row.get("Contamination")
                checkm2_data[stem] = (
                    float(comp_raw) if _pd.notna(comp_raw) else 50.0,
                    float(cont_raw) if _pd.notna(cont_raw) else 5.0,
                )
            print(f"[drep] Parsed CheckM2 data for {len(checkm2_data)} genome(s).", flush=True)
        except Exception as e:
            print(f"[drep] WARNING: could not parse CheckM2 ({e}), using defaults.", flush=True)

        with open(genome_info_path, "w", newline="") as gh:
            writer = _csv.writer(gh)
            writer.writerow(["genome", "completeness", "contamination"])
            for fa in fa_files:
                stem = os.path.splitext(os.path.basename(fa))[0]
                comp, cont = checkm2_data.get(stem, (50.0, 5.0))
                writer.writerow([os.path.basename(fa), comp, cont])  # basename only
        print(f"[drep] genome_info → {genome_info_path}", flush=True)

        # ── Detect best available ANI algorithm in drep_env ───────────────────
        def _avail(binary):
            return subprocess.run(
                ["bash", "-c", f"command -v {binary}"],
                capture_output=True, env=drep_env
            ).returncode == 0

        if _avail("skani"):
            s_algo = "skani"
        elif _avail("fastANI"):
            s_algo = "fastANI"
        else:
            s_algo = "ANImf"
        print(f"[drep] Using S_algorithm: {s_algo}", flush=True)

        # ── Run dRep ──────────────────────────────────────────────────────────
        cmd = [
            DREP_BIN, "dereplicate", out_base,
            "--genomeInfo", genome_info_path,
            "-pa", str(DREP_PRIMARY_ANI),
            "-sa", str(DREP_SECONDARY_ANI),
            "-nc", str(DREP_ALIGNED_FRACTION),
            "-comp", str(DREP_MIN_COMPLETENESS),
            "-con", str(DREP_MAX_CONTAMINATION),
            "--S_algorithm", s_algo,
            "--processors", str(threads),   # FIX: was -p, dRep flag is --processors
        ] + ["-g"] + fa_files

        print(f"[drep] Running: {' '.join(cmd)}", flush=True)
        subprocess.run(cmd, check=True, env=drep_env)
        print(f"[drep] Finished. Output: {output.derep}", flush=True)

# ── CoverM — MAG coverage ─────────────────────────────────────────────────────
rule coverm:
    input:
        bins = f"{FILTERED_DIR}/{{sample}}",
        done = f"{FILTERED_DIR}/{{sample}}.filter.done",
        bam  = f"{MAP_DIR}/{{sample}}.sorted.bam"
    output:
        tsv = f"{COVERM_DIR}/{{sample}}/coverage.tsv"
    threads: THREADS
    run:
        import os
        out_dir = f"{COVERM_DIR}/{wildcards.sample}"
        os.makedirs(out_dir, exist_ok=True)
        bin_files = [
            os.path.join(input.bins, f)
            for f in os.listdir(input.bins)
            if f.endswith(".fa")
        ]
        if not bin_files:
            with open(output.tsv, "w") as fh:
                fh.write("Genome\tMean\tRelative Abundance (%)\tCovered Fraction\n")
            print("[coverm] No filtered MAGs — writing empty coverage table.")
        else:
            bin_str = " ".join(bin_files)
            shell(
                f"export PATH={COVERM_ENV}:$PATH && "
                f"{COVERM} genome "
                f"--bam-files {input.bam} "
                f"--genome-fasta-files {bin_str} "
                f"-t {threads} "
                f"-m mean relative_abundance covered_fraction "
                f"--min-covered-fraction 0 "
