        mkdir -p {CHECKM_DIR}/{wildcards.sample}
        bin_count=$(find {input.bins} -maxdepth 1 -name "*.fa" | wc -l | tr -d '[:space:]')
        bin_count="${{bin_count:-0}}"
        if [ "$bin_count" -eq 0 ]; then
          printf "Name\tCompleteness\tContamination\n" > {output.report}
          echo "[checkm2] No final bins — writing an empty quality report." >&2
          exit 0
        fi
        export PATH={CHECKM2_ENV}:{PROKKA_ENV}:$PATH
        {CHECKM2} predict \
          --input {input.bins} \
          --output-directory {CHECKM_DIR}/{wildcards.sample} \
          --threads {threads} \
          -x fa \
          --force \
          --database_path {params.diamond_db}
        """

rule busco:
    """
    BUSCO on DAS_Tool bins (pre-filter QC).
    Parallel bash-jobs loop; --offline + explicit lineage.
    """
    input:
        bins = f"{DAS_DIR}/{{sample}}_DASTool_bins_clean"
    output:
        done = f"{BUSCO_DIR}/{{sample}}/busco.done"
    threads: THREADS
    params:
        parallel_jobs = max(1, THREADS // 4),
        lineage = BUSCO_LINEAGE
    shell:
        r"""
        set -euo pipefail
        mkdir -p {BUSCO_DIR}/{wildcards.sample}
        export PATH={BUSCO_ENV}:$PATH

        OUTDIR="{BUSCO_DIR}/{wildcards.sample}"
        LINEAGE="{params.lineage}"
        MAX_JOBS={params.parallel_jobs}
        FAIL_FILE="$OUTDIR/.busco_failed"
        rm -f "$FAIL_FILE"
        active=0

        for fa in {input.bins}/*.fa; do
            [ -f "$fa" ] || continue
            mag=$(basename "$fa" .fa)
            echo "[BUSCO] Launching $mag"
            (
                {BUSCO_BIN} \
                  -i "$fa" \
                  -o "$mag" \
                  --out_path "$OUTDIR" \
                  -m genome \
                  -l "$LINEAGE" \
                  --offline \
                  -c 4 \
                  --force 2>&1 || {{ echo "[BUSCO] ERROR: $mag failed" >&2; touch "$FAIL_FILE"; }}
            ) &
            active=$(( active + 1 ))
            if [ "$active" -ge "$MAX_JOBS" ]; then
                wait
                active=0
            fi
        done
        wait

        if [ -f "$FAIL_FILE" ]; then
            rm -f "$FAIL_FILE"
            echo "[BUSCO] One or more MAG analyses failed." >&2
            exit 1
        fi

        touch {output.done}
        """

