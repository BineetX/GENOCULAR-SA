rule operams_assembly:
    """
    Hybrid assembly with OPERA-MS: MEGAHIT contigs + decontaminated long reads.

    Fixes verified working on this cluster (SRR14300308):
      1. LD_PRELOAD libnsl.so.1: compute nodes lack this library. It is symlinked
         from libnsl.so.3 inside the marine conda env:
           ln -s $CONDA_PREFIX/lib/libnsl.so.3 $CONDA_PREFIX/lib/libnsl.so.1
         The preload is set before perl is called so all child processes inherit it.
      2. --genome-db: points to OPERA-MS-DB for reference-guided clustering.
         Replaces the old --no-ref-clustering flag which caused downstream failures.
      3. --no-strain-clustering: strain assembly (cluster_strain.pl) crashes on
         this dataset — known OPERA-MS v0.9.0 bug ("Error in during strain
         clustering assembly"). Disabling it lets the run complete successfully.
      4. --no-gap-filling: disabled to reduce runtime and avoid secondary failures.
      5. Output dir suffix _nostrain distinguishes this run from old broken runs.
      6. OPERA-MS must create its own --out-dir from scratch; prior runs removed.
      7. Contig headers sanitised (spaces -> underscores) before passing to
         OPERA-MS, which rejects headers containing spaces.
      8. Full stderr+stdout tee-d to log for post-mortem diagnostics.
      9. Scaffolds file located with version-independent search across all known
         OPERA-MS output layouts.
    """
    input:
        contigs  = f"{MEGAHIT_DIR}/{{sample}}/final.contigs.fa",
        long_r   = f"{LR_HOST_DIR}/{{sample}}/decontam.fastq",
        short_r1 = f"{SR_HOST_DIR}/{{sample}}/R1_decontam.fastq",
        short_r2 = f"{SR_HOST_DIR}/{{sample}}/R2_decontam.fastq"
    output:
        contigs   = f"{OPRAMS_DIR}/{{sample}}_nostrain/contigs.fasta"
    log:
        f"{OPRAMS_DIR}/{{sample}}_nostrain/operams.log"
    threads: THREADS
    params:
        genome_db = OPERAMS_DB,
        libnsl    = os.environ.get("LIBNSL_SO", str(Path(OPERAMS_ENV).parent / "lib" / "libnsl.so.1"))
    shell:
        r"""
        set -euo pipefail

        OUTDIR="{OPRAMS_DIR}/{wildcards.sample}_nostrain"
        LOG="{log}"

        # OPERA-MS contains older helper binaries that may require libnsl.so.1.
        # Only preload it when the environment actually provides it; exporting
        # a nonexistent path causes the Perl process to fail before it starts.
        if [ -f "{params.libnsl}" ]; then
            export LD_PRELOAD="{params.libnsl}"
        else
            unset LD_PRELOAD || true
        fi

        # 2. Create output dir before tee writes the log (fix: "No such file or directory")
        #    OPERA-MS is fine with the dir pre-existing as long as internals are absent.
        rm -rf "$OUTDIR"
        mkdir -p "$OUTDIR"

        # 3. Sanitise contig headers (spaces break OPERA-MS parser)
        CLEAN_CONTIGS="$(dirname "$OUTDIR")/contigs_clean_{wildcards.sample}.fa"
        sed 's/ /_/g' {input.contigs} > "$CLEAN_CONTIGS"

        # 4. Add the server-resolved marine environment to PATH.
        export PATH={OPERAMS_ENV}:{MARINE_ENV}:$PATH

        # Repair stale absolute links left by older OPERA-MS installations.
        # OPERA-MS invokes these through its tools directory even when the
        # top-level command uses the dedicated environment.
        ln -sfn "{OPERAMS_PERL}" "$(dirname {OPERAMS_PL})/tools_opera_ms/perl"
        ln -sfn "{OPERAMS_SAMTOOLS}" "$(dirname {OPERAMS_PL})/tools_opera_ms/samtools"

        # 5. Run OPERA-MS with verified-working flags
        echo "[operams] Starting OPERA-MS run at $(date)" | tee "$LOG"
        echo "[operams] LD_PRELOAD=${{LD_PRELOAD:-<not set>}}" | tee -a "$LOG"
        echo "[operams] genome-db: {params.genome_db}" | tee -a "$LOG"

        {OPERAMS_PERL} {OPERAMS_PL} \
          --contig-file         "$CLEAN_CONTIGS" \
          --short-read1         {input.short_r1} \
          --short-read2         {input.short_r2} \
          --long-read           {input.long_r} \
          --genome-db           {params.genome_db} \
          --no-strain-clustering \
          --no-gap-filling \
          --no-polishing \
          --num-processors      {threads} \
          --out-dir             "$OUTDIR" \
          2>&1 | tee -a "$LOG"

        echo "[operams] OPERA-MS finished at $(date)" | tee -a "$LOG"

        # 6. Verify contigs.fasta was produced (--no-polishing outputs contigs.fasta directly)
        if [ ! -s "$OUTDIR/contigs.fasta" ]; then
            echo "ERROR: OPERA-MS did not produce contigs.fasta" | tee -a "$LOG"
            echo "Directory listing:" | tee -a "$LOG"
            find "$OUTDIR" -maxdepth 2 -type f 2>/dev/null | tee -a "$LOG" || true
            exit 1
        fi
        echo "[operams] Found contigs.fasta at: $OUTDIR/contigs.fasta" | tee -a "$LOG"

        rm -f "$CLEAN_CONTIGS"
        echo "[operams] Done. Output: {output.contigs}" | tee -a "$LOG"
        """

