        """

rule nanoq_adaptive:
    """
    Adaptive long-read quality filter using NanoStat output.
    TIER 0 (PASS):     mean_Q>=10 AND median_len>=5000 → no filtering
    TIER 1 (LIGHT):    mean_Q>=8  AND median_len>=2000 → --min-qual 8 --min-len 2000
    TIER 2 (MODERATE): otherwise                       → --min-qual 7 --min-len 1000
    """
    input:
        reads  = config["reads"]["long"],
        report = f"{NANOSTAT_DIR}/{{sample}}/raw_nanostat.txt"
    output:
        reads   = f"{NANOQ_DIR}/{{sample}}/filtered.fastq",
        summary = f"{NANOQ_DIR}/{{sample}}/nanoq_summary.txt"
    threads: THREADS
    run:
        import gzip, re, shutil, os

        mean_q = median_len = None
        with open(input.report) as fh:
            for line in fh:
                m = re.search(r"Mean read quality[^:]*:\s+([\d.]+)", line)
                if m: mean_q = float(m.group(1))
                m = re.search(r"Median read length[^:]*:\s+([\d,.]+)", line)
                if m: median_len = float(m.group(1).replace(",", ""))

        if mean_q is None or median_len is None:
            with open(input.report) as _dbg:
                content = _dbg.read()
            raise RuntimeError(
                f"[nanoq_adaptive] Could not parse NanoStat output: {input.report}\n"
                f"--- File contents ---\n{content}\n--- End ---"
            )

        if mean_q >= 10 and median_len >= 5000:
            tier, min_qual, min_len = 0, None, None
            tier_name = "PASS (no filtering applied)"
        elif mean_q >= 8 and median_len >= 2000:
            tier, min_qual, min_len = 1, 8, 2000
            tier_name = "LIGHT (--min-qual 8 --min-len 2000)"
        else:
            tier, min_qual, min_len = 2, 7, 1000
            tier_name = "MODERATE (--min-qual 7 --min-len 1000)"

        os.makedirs(f"{NANOQ_DIR}/{wildcards.sample}", exist_ok=True)
        with open(output.summary, "w") as sw:
            sw.write(f"Sample:           {wildcards.sample}\n")
            sw.write(f"Raw mean Q:       {mean_q:.2f}\n")
            sw.write(f"Raw median len:   {median_len:.0f}\n")
            sw.write(f"Filter tier:      {tier} — {tier_name}\n")

        if tier == 0:
            # The declared output is plain FASTQ. Transparently decompress a
            # gzipped upload instead of copying compressed bytes to .fastq.
            with open(input.reads, "rb") as src:
                is_gzip = src.read(2) == b"\x1f\x8b"
            opener = gzip.open if is_gzip else open
            with opener(input.reads, "rb") as src, open(output.reads, "wb") as dst:
                shutil.copyfileobj(src, dst)
        else:
            shell(
                f"{NANOQ} "
                f"--input {input.reads} "
                f"--output {output.reads} "
                f"--min-qual {min_qual} "
                f"--min-len {min_len} "
                f"--report {NANOQ_DIR}/{wildcards.sample}/nanoq_report.json "
                f"--stats"
            )
        print(f"[nanoq_adaptive] Tier {tier}: {tier_name}")

rule nanostat_filtered:
