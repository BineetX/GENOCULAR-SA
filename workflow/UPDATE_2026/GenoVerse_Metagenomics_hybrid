def _resolve_kraken2_db(path):
    if os.path.exists(os.path.join(path, "taxo.k2d")):
        return path
    matches = sorted(glob.glob(os.path.join(path, "*", "taxo.k2d")))
    if matches:
        return os.path.dirname(matches[0])
    return path

