    output:
        gff   = f"{BARRNAP_DIR}/{{sample}}/{{mag}}/{{mag}}_rrna.gff",
        fa16s = f"{BARRNAP_DIR}/{{sample}}/{{mag}}/{{mag}}_16S.fa"
    threads: MAG_THREADS
    shell:
        r"""
        set -euo pipefail
        export PATH={BARRNAP_ENV}:$PATH

        OUTDIR="{BARRNAP_DIR}/{wildcards.sample}/{wildcards.mag}"
        mkdir -p "$OUTDIR"

        _outseq_bac="$OUTDIR/{wildcards.mag}_rrna_bac.fa"
        _outseq_arc="$OUTDIR/{wildcards.mag}_rrna_arc.fa"
        _gff_bac="$OUTDIR/{wildcards.mag}_rrna_bac.gff"
        _gff_arc="$OUTDIR/{wildcards.mag}_rrna_arc.gff"

        {BARRNAP_BIN} \
          --kingdom bac \
          --threads {threads} \
          --lencutoff 0.5 \
          --reject 0.1 \
          --outseq "$_outseq_bac" \
          {input.fasta} \
          > "$_gff_bac" 2>> /dev/stderr || true

        {BARRNAP_BIN} \
          --kingdom arc \
          --threads {threads} \
          --lencutoff 0.5 \
          --reject 0.1 \
          --outseq "$_outseq_arc" \
          {input.fasta} \
          > "$_gff_arc" 2>> /dev/stderr || true

        [ -f "$_outseq_bac" ] || touch "$_outseq_bac"
        [ -f "$_outseq_arc" ] || touch "$_outseq_arc"
        [ -f "$_gff_bac"    ] || touch "$_gff_bac"
        [ -f "$_gff_arc"    ] || touch "$_gff_arc"

        {{
          cat "$_gff_bac"
          grep -v '^#' "$_gff_arc" || true
        }} > {output.gff}

        _outseq_all="$OUTDIR/{wildcards.mag}_rrna_all.fa"
        cat "$_outseq_bac" "$_outseq_arc" > "$_outseq_all"

        _out16s="{output.fa16s}"
        _mag="{wildcards.mag}"
        python3 - "$_outseq_all" "$_out16s" "$_mag" <<'PYEOF'
import sys, re

rrna_fa, out16s, mag = sys.argv[1], sys.argv[2], sys.argv[3]

IS_16S_RE = re.compile(r'16[Ss][_\s]?[rR]RNA|16[Ss]\s+ribosomal', re.IGNORECASE)

seqs = []
in_16s = False
seq_id = ""
seq_buf = []

try:
    with open(rrna_fa) as fh:
        for line in fh:
            line = line.rstrip()
            if line.startswith(">"):
                if in_16s and seq_buf:
                    seqs.append((seq_id, "".join(seq_buf)))
                seq_id = line
                in_16s = bool(IS_16S_RE.search(line))
                seq_buf = []
            else:
                if in_16s:
                    seq_buf.append(line)
        if in_16s and seq_buf:
            seqs.append((seq_id, "".join(seq_buf)))
except FileNotFoundError:
    pass

with open(out16s, "w") as out:
    if seqs:
        for i, (sid, seq) in enumerate(seqs, 1):
            contig = sid.lstrip(">").split()[0]
            length = len(seq)
            flag = "_partial" if length < 1200 else ""
            new_header = ">" + mag + "_" + contig + "_16S_" + str(i) + flag + " len=" + str(length)
            out.write(new_header + "\n" + seq + "\n")
        print("[barrnap] " + mag + ": " + str(len(seqs)) + " 16S sequence(s) written to " + out16s)
    else:
        out.write("# No 16S rRNA gene detected in " + mag + "\n")
        print("[barrnap] " + mag + ": No 16S rRNA detected")
PYEOF
        """

rule barrnap_all:
    input:
        lambda wildcards: expand(
            f"{BARRNAP_DIR}/{{sample}}/{{mag}}/{{mag}}_16S.fa",
            sample=wildcards.sample,
            mag=get_filtered_mags(wildcards)
        )
    output:
        combined = f"{BARRNAP_DIR}/{{sample}}/all_MAGs_16S_rRNA.fa",
        summary  = f"{BARRNAP_DIR}/{{sample}}/16S_detection_summary.tsv",
        done     = f"{BARRNAP_DIR}/{{sample}}/barrnap.done"
    run:
        import os, re, glob as _glob

        total = with_full = with_partial = no_16s = 0
        summary_rows = ["MAG\tStatus\tNum_16S\tNotes"]

        with open(output.combined, "w") as out_fh:
            for fa_path in sorted(input):
                mag_name = os.path.basename(os.path.dirname(fa_path))
                total += 1
                seq_count = partial_count = 0
                no_detect = False

                with open(fa_path) as in_fh:
                    for line in in_fh:
                        if line.startswith("#"):
                            no_detect = True
                        elif line.startswith(">"):
                            seq_count += 1
                            if "_partial" in line:
                                partial_count += 1
                            out_fh.write(line)
                        else:
                            if not no_detect:
                                out_fh.write(line)

                if no_detect or seq_count == 0:
                    no_16s += 1
                    summary_rows.append(f"{mag_name}\tNone\t0\tNo 16S detected")
                elif partial_count == seq_count:
                    with_partial += 1
                    summary_rows.append(f"{mag_name}\tPartial\t{seq_count}\t{partial_count} partial <1200 bp")
                else:
                    with_full += 1
                    summary_rows.append(f"{mag_name}\tFull\t{seq_count}\t{partial_count} partial, {seq_count-partial_count} full")

        with open(output.summary, "w") as sfh:
            sfh.write("\n".join(summary_rows) + "\n")
            sfh.write(f"\n# TOTAL MAGs: {total}\n# Full: {with_full}\n# Partial: {with_partial}\n# None: {no_16s}\n")
        open(output.done, "w").close()

