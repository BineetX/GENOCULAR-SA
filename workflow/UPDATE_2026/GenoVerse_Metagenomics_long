rule barrnap_per_mag:
    input:
        fasta = f"{FILTERED_DIR}/{{sample}}/{{mag}}.fa"
    output:
        gff   = f"{BARRNAP_DIR}/{{sample}}/{{mag}}/{{mag}}_rrna.gff",
        fa16s = f"{BARRNAP_DIR}/{{sample}}/{{mag}}/{{mag}}_16S.fa"
    threads: 4
    shell:
        r"""
        set -euo pipefail
        export PATH={BARRNAP_ENV}:$PATH

        OUTDIR="{BARRNAP_DIR}/{wildcards.sample}/{wildcards.mag}"
        mkdir -p "$OUTDIR"

        _outseq_bac="$OUTDIR/{wildcards.mag}_rrna_bac.fa"
        _outseq_arc="$OUTDIR/{wildcards.mag}_rrna_arc.fa"
        _gff_bac="$OUTDIR/{wildcards.mag}_bac.gff"
        _gff_arc="$OUTDIR/{wildcards.mag}_arc.gff"

        {BARRNAP_BIN} \
          --kingdom bac \
          --threads {threads} \
          --lencutoff 0.5 \
          --reject 0.1 \
          --outseq "$_outseq_bac" \
          {input.fasta} \
          > "$_gff_bac" 2>>/dev/stderr || true

        {BARRNAP_BIN} \
          --kingdom arc \
          --threads {threads} \
          --lencutoff 0.5 \
          --reject 0.1 \
          --outseq "$_outseq_arc" \
          {input.fasta} \
          > "$_gff_arc" 2>>/dev/stderr || true

        [ -f "$_outseq_bac" ] || touch "$_outseq_bac"
        [ -f "$_outseq_arc" ] || touch "$_outseq_arc"
        [ -f "$_gff_bac"    ] || touch "$_gff_bac"
        [ -f "$_gff_arc"    ] || touch "$_gff_arc"

        {{
          cat "$_gff_bac"
          grep -v "^#" "$_gff_arc" || true
        }} > {output.gff}

        _outseq_all="$OUTDIR/{wildcards.mag}_rrna_all.fa"
        cat "$_outseq_bac" "$_outseq_arc" > "$_outseq_all"

        _out16s="{output.fa16s}"
        _mag="{wildcards.mag}"
        python3 - "$_outseq_all" "$_out16s" "$_mag" <<"PYEOF"
import sys, re as _re

rrna_fa, out16s, mag = sys.argv[1], sys.argv[2], sys.argv[3]
IS_16S_RE = _re.compile(r"16[Ss][_\s]?[rR]RNA|16[Ss]\s+ribosomal", _re.IGNORECASE)
seqs = []
in_16s = False
seq_id = ""
seq_buf = []
try:
    with open(rrna_fa) as fh:
        for line in fh:
            line = line.rstrip()
            if line.startswith(">"):
                if in_16s and seq_buf:
                    seqs.append((seq_id, "".join(seq_buf)))
                seq_id = line
                in_16s = bool(IS_16S_RE.search(line))
                seq_buf = []
            else:
                if in_16s:
                    seq_buf.append(line)
        if in_16s and seq_buf:
            seqs.append((seq_id, "".join(seq_buf)))
except FileNotFoundError:
    pass
with open(out16s, "w") as out:
    if seqs:
        for i, (sid, seq) in enumerate(seqs, 1):
            contig = sid.lstrip(">").split()[0]
            length = len(seq)
            flag = "_partial" if length < 1200 else ""
            out.write(">" + mag + "_" + contig + "_16S_" + str(i) + flag + " len=" + str(length) + "\n" + seq + "\n")
        print("[barrnap] " + mag + ": " + str(len(seqs)) + " 16S sequence(s) written")
    else:
        out.write("# No 16S rRNA gene detected in " + mag + "\n")
        print("[barrnap] " + mag + ": No 16S rRNA detected")
PYEOF
        """

rule barrnap_all:
    input:
        filter_done = f"{FILTERED_DIR}/{{sample}}.filter.done",
        per_mag     = lambda wildcards: expand(
            f"{BARRNAP_DIR}/{{sample}}/{{mag}}/{{mag}}_16S.fa",
            sample=wildcards.sample,
            mag=get_filtered_mags(wildcards)
        )
    output:
        combined = f"{BARRNAP_DIR}/{{sample}}/all_MAGs_16S_rRNA.fa",
        done     = f"{BARRNAP_DIR}/{{sample}}/barrnap.done"
    run:
        import os, glob as _glob

        out_dir = f"{BARRNAP_DIR}/{SAMPLE}"
        os.makedirs(out_dir, exist_ok=True)

        total = with_seqs = no_16s = 0
        with open(output.combined, "w") as out_fh:
            # Only read the *_16S.fa files — never the intermediate rRNA fastas
            for fa_path in sorted(input.per_mag):
                total += 1
                has_seq = False
                with open(fa_path) as in_fh:
                    for line in in_fh:
                        if line.startswith("#"):
                            continue          # skip "# No 16S rRNA gene detected" lines
                        out_fh.write(line)
                        if line.startswith(">"):
                            has_seq = True
                if has_seq:
                    with_seqs += 1
                else:
                    no_16s += 1

        print(f"[barrnap_all] {with_seqs}/{total} MAGs had 16S sequences; "
              f"{no_16s} had none. Combined → {output.combined}")
        open(output.done, "w").close()

