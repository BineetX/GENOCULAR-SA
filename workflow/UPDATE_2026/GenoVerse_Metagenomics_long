def _find_env(env_var, env_names, probe):
    candidates = [os.environ.get(env_var, "")]
    candidates.extend(f"/opt/conda/envs/{name}" for name in env_names)
    shared = Path(os.environ.get(
        "SHARED_CONDA_PREFIX",
        "/data/genoverse/smk_envs_profiles/metagenomics/long/tool_envs",
    ))
    candidates.extend(str(shared / name) for name in env_names)
    if shared.exists():
        candidates.extend(str(path) for path in sorted(shared.iterdir()) if path.is_dir())
    for candidate in candidates:
        if candidate and (Path(candidate) / "bin" / probe).exists():
            return Path(candidate)
    return None

def _tool(env_var, env_names, binary):
    env_dir = _find_env(env_var, env_names, binary)
    return str(env_dir / "bin" / binary) if env_dir else binary

def _binpath(env_var, env_names, binary):
    env_dir = _find_env(env_var, env_names, binary)
    return str(env_dir / "bin") if env_dir else ""

