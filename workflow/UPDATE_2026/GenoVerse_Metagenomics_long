rule minimap2_map:
    """Map decontaminated reads to polished assembly for initial depth info."""
    input:
        reads   = f"{HOST_DIR}/{{sample}}/decontam.fastq.gz",
        contigs = assembly_fasta
    output:
        bam = f"{MAP_DIR}/{{sample}}.sorted.bam",
        bai = f"{MAP_DIR}/{{sample}}.sorted.bam.bai"
    threads: THREADS
    shell:
        """
        set -euo pipefail
        mkdir -p {MAP_DIR}
        {MINIMAP2} \
          -ax {MM2_PRESET} \
          -t {threads} \
          --secondary=no \
          {input.contigs} {input.reads} \
        | {SAMTOOLS} sort -@ {threads} -o {output.bam}
        {SAMTOOLS} index {output.bam}
        """

rule depth:
    """
    Compute long-read per-contig coverage using CoverM.
    Output goes to MAP_DIR/{sample}_depth.txt so filter_contigs_by_depth
    can consume it directly (metabat-specific jgi depths are produced separately
    by the metabat_depth rule after contig filtering).
    """
    input:
        bam = f"{MAP_DIR}/{{sample}}.sorted.bam",
        bai = f"{MAP_DIR}/{{sample}}.sorted.bam.bai"
    output:
        depth = f"{MAP_DIR}/{{sample}}_depth.txt"
    threads: THREADS
    shell:
        r"""
        set -euo pipefail

        export PATH={COVERM_ENV}:$PATH

        coverm contig \
          -b {input.bam} \
          --methods mean covered_fraction length \
          --min-read-percent-identity 90 \
          --threads {threads} \
          > {output.depth}
        """


# =============================================================================
# STEP 5.5 — COVERAGE-BASED CONTIG FILTER
# =============================================================================

rule filter_contigs_by_depth:
    """
    Retain contigs with sufficient mean coverage and length for reliable binning.

    FIX: If zero contigs pass all thresholds, writes an empty FASTA stub and
    continues rather than crashing. Downstream binning rules detect the empty
    FASTA and skip gracefully.

    ADAPTIVE FALLBACK: if fewer than min_contigs_for_binning pass the strict
    threshold, automatically retries at 2× then 1×.
    """
    input:
        fasta = assembly_fasta,
        depth = f"{MAP_DIR}/{{sample}}_depth.txt"
    output:
        fasta   = f"{MAP_DIR}/{{sample}}_contigs_filtered.fasta",
        kept    = f"{MAP_DIR}/{{sample}}_depth_filtered.txt",
        summary = f"{MAP_DIR}/{{sample}}_filter_summary.txt"
    run:
        # ── 1. Parse depth file ──────────────────────────────────────────────
        all_contigs = {}
        header_line = ""
        depth_lines = {}
        with open(input.depth) as fh:
            header_line = fh.readline()
            # CoverM contig output: Contig  Mean  Covered Fraction  Length
            # Detect column indices from header so we're robust to order changes
            hdrs = [h.strip().lower() for h in header_line.split("\t")]
            try:
                idx_name = 0   # always first
                idx_cov  = next(i for i, h in enumerate(hdrs) if "mean" in h)
                idx_len  = next(i for i, h in enumerate(hdrs) if "length" in h)
            except StopIteration:
                raise RuntimeError(
                    f"[filter_contigs_by_depth] Unrecognised depth file header: {header_line.strip()}"
                )
            for line in fh:
                parts = line.strip().split("\t")
                if len(parts) <= max(idx_name, idx_cov, idx_len):
                    continue
                name   = parts[idx_name]
                cov    = float(parts[idx_cov])
                length = int(float(parts[idx_len]))   # CoverM reports length as float
                all_contigs[name] = (length, cov)
                depth_lines[name] = line

        lengths = [l for l, _ in all_contigs.values()]
        print(f"[filter] Total contigs: {len(lengths)}")
        print(f"[filter] >=1000 bp: {sum(1 for x in lengths if x >= 1000)}")
        print(f"[filter] >=1500 bp: {sum(1 for x in lengths if x >= 1500)}")
        print(f"[filter] >=2500 bp: {sum(1 for x in lengths if x >= 2500)}")

        total = len(all_contigs)
        if total == 0:
            raise RuntimeError(
                f"[filter_contigs_by_depth] Depth file {input.depth} has no data rows. "
                "Check that the BAM was generated correctly."
            )

        # ── 2. Adaptive threshold selection ─────────────────────────────────
        # Try relaxing coverage first, then length as a last resort.
        # Coverage thresholds: user-set → 2× → 1× → 0× (no filter)
        # Length fallback: if even cov=0 + user_len is too strict, drop length to 500
        coverage_thresholds = [MIN_BINNING_COV, 2, 1, 0]
        length_thresholds   = [1500, 1200, 1000]

        kept_names    = set()
        fallback_used = False
        chosen_cov    = MIN_BINNING_COV
        chosen_len    = MIN_BINNING_LEN

        for len_thresh in length_thresholds:
            for cov_thresh in coverage_thresholds:
                candidates = {
                    n for n, (l, c) in all_contigs.items()
                    if l >= len_thresh and c >= cov_thresh
                }
                if len(candidates) >= MIN_CONTIGS_FOR_BINNING:
                    kept_names = candidates
                    chosen_cov = cov_thresh
                    chosen_len = len_thresh
                    if len_thresh != MIN_BINNING_LEN or cov_thresh != MIN_BINNING_COV:
                        fallback_used = True
                        msg = (
                            f"[filter_contigs_by_depth] ADAPTIVE FALLBACK: strict thresholds "
                            f"cov>={MIN_BINNING_COV}x, len>={MIN_BINNING_LEN}bp yielded <{MIN_CONTIGS_FOR_BINNING} contigs. "
                            f"Relaxed to cov>={cov_thresh}x, len>={len_thresh}bp -> {len(candidates)} contigs retained."
                        )
                        if cov_thresh < 2:
                            msg += (" WARNING: coverage below recommended minimum "
                                    "for reliable binning (>=2x). Bins may be low quality.")
                        print(msg, flush=True)
                    break
            if len(kept_names) >= MIN_CONTIGS_FOR_BINNING:
                break

        # emergency fallback — keep anything >=1000 bp regardless of coverage
        if len(kept_names) == 0:
            kept_names = {
                n for n, (l, c) in all_contigs.items()
                if l >= 1000
            }
            chosen_cov    = 0
            chosen_len    = 1000
            fallback_used = True

        n_kept = len(kept_names)
        n_disc = total - n_kept

        # ── 3. Write filtered depth file ─────────────────────────────────────
        with open(output.kept, "w") as fh:
            fh.write(header_line)
            for name in kept_names:
                fh.write(depth_lines[name])

        # ── 4. Write filtered FASTA (empty stub if nothing passes) ───────────
        with open(input.fasta) as fin, open(output.fasta, "w") as fout:
            write = False
            for line in fin:
                if line.startswith(">"):
                    name = line[1:].strip().split()[0]
                    write = name in kept_names
                if write:
                    fout.write(line)
        # Guarantee file exists even if empty (prevents Snakemake missing-output errors)
        if not os.path.exists(output.fasta):
            open(output.fasta, "w").close()

        # ── 5. Coverage statistics ───────────────────────────────────────────
        covs = [c for _, (_, c) in all_contigs.items()]
        covs_sorted = sorted(covs)
        mean_cov   = sum(covs) / len(covs) if covs else 0
        median_cov = covs_sorted[len(covs_sorted) // 2] if covs_sorted else 0
        max_cov    = max(covs) if covs else 0

        covs_kept = [all_contigs[n][1] for n in kept_names]
        mean_cov_kept = sum(covs_kept) / len(covs_kept) if covs_kept else 0

        # ── 6. Write summary ─────────────────────────────────────────────────
        with open(output.summary, "w") as fh:
            fh.write("=" * 60 + "\n")
            fh.write(f"Coverage filter summary — {wildcards.sample}\n")
            fh.write("=" * 60 + "\n")
            fh.write(f"Total contigs in assembly:        {total}\n")
            fh.write(f"Coverage threshold used:          {chosen_cov}×"
                     + (" [ADAPTIVE FALLBACK]" if fallback_used else " [config default]") + "\n")
            fh.write(f"Length threshold used:            {chosen_len} bp\n")
            fh.write(f"Contigs retained:                 {n_kept}\n")
            fh.write(f"Contigs discarded (low-cov/short):{n_disc}\n")
            fh.write("-" * 60 + "\n")
            fh.write(f"Depth stats (all contigs):\n")
            fh.write(f"  Min:    {covs_sorted[0]:.3f}×\n")
            fh.write(f"  Median: {median_cov:.3f}×\n")
            fh.write(f"  Mean:   {mean_cov:.3f}×\n")
            fh.write(f"  Max:    {max_cov:.3f}×\n")
            fh.write(f"  Contigs with depth >1×: "
                     f"{sum(1 for c in covs if c > 1)} / {total}\n")
            fh.write(f"  Contigs with depth >3×: "
                     f"{sum(1 for c in covs if c > 3)} / {total}\n")
            fh.write(f"  Contigs with depth >5×: "
                     f"{sum(1 for c in covs if c > 5)} / {total}\n")
            fh.write("-" * 60 + "\n")
            fh.write(f"Mean depth of retained contigs:   {mean_cov_kept:.3f}×\n")
            if n_kept == 0:
                fh.write("\nWARNING: Zero contigs passed the coverage filter.\n")
                fh.write("  This sample may be too low-biomass for MAG recovery.\n")
                fh.write("  Binning steps will run but are expected to produce zero bins.\n")
                fh.write("  To override, lower min_binning_coverage in config_longread.yaml.\n")
            fh.write("=" * 60 + "\n")

        print(
            f"[filter_contigs_by_depth] {n_kept}/{total} contigs retained "
            f"(cov>={chosen_cov}×, len>={chosen_len}bp). "
            f"Mean depth of retained set: {mean_cov_kept:.2f}×"
        )


# =============================================================================
# STEP 5.6 — RE-MAP READS TO FILTERED ASSEMBLY
# =============================================================================

rule minimap2_map_filtered:
    """
    Re-map reads to coverage-filtered assembly for consistent bin-level depth.

    FIX: If the filtered FASTA is empty (zero contigs passed filter), creates
    empty BAM/BAI stubs so downstream rules can proceed without crashing.
    """
    input:
        reads   = f"{HOST_DIR}/{{sample}}/decontam.fastq.gz",
        contigs = f"{MAP_DIR}/{{sample}}_contigs_filtered.fasta"
    output:
        bam = f"{MAP_DIR}/{{sample}}_filtered.sorted.bam",
        bai = f"{MAP_DIR}/{{sample}}_filtered.sorted.bam.bai"
    threads: THREADS
    shell:
        """
        set -euo pipefail

        # If filtered FASTA is empty, create empty BAM stub and exit gracefully
        contig_count=$(grep -c "^>" {input.contigs} 2>/dev/null || echo 0)
        if [ "$contig_count" -eq 0 ]; then
            echo "[minimap2_map_filtered] WARNING: No contigs in filtered FASTA. Creating empty BAM stub." >&2
            {SAMTOOLS} view -b -h /dev/null -o {output.bam}
            {SAMTOOLS} index {output.bam}
            exit 0
        fi

        {MINIMAP2} \
          -ax {MM2_PRESET} \
          -t {threads} \
          --secondary=no \
          {input.contigs} {input.reads} \
        | {SAMTOOLS} sort -@ {threads} -o {output.bam}
        {SAMTOOLS} index {output.bam}
        """

rule depth_filtered:
    """
    Compute per-contig depth on filtered assembly using CoverM
    """
    input:
        bam = f"{MAP_DIR}/{{sample}}_filtered.sorted.bam",
        bai = f"{MAP_DIR}/{{sample}}_filtered.sorted.bam.bai"
    output:
        depth = f"{MAP_DIR}/{{sample}}_filtered_depth.txt"
    threads: THREADS
    shell:
        r"""
        set -euo pipefail

        export PATH={COVERM_ENV}:$PATH

        read_count=$({SAMTOOLS} view -c {input.bam} 2>/dev/null || echo 0)

        if [ "$read_count" -eq 0 ]; then
            echo -e "contig\tmean\tcovered_fraction\tlength" > {output.depth}
            exit 0
        fi

        coverm contig \
          -b {input.bam} \
          --methods mean covered_fraction length \
          --min-read-percent-identity 90 \
          --threads {threads} \
          > {output.depth}
        """


