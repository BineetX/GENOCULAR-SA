def medaka_model():
    raw = config.get("medaka_model") or {
        "ont":         "r1041_e82_400bps_sup_v5.0.0",
        "pacbio-raw":  None,
        "pacbio-hifi": None,
    }.get(READ_TYPE, "r1041_e82_400bps_sup_v5.0.0")

    if raw is None:
        return None

    if raw in _MEDAKA_DEPRECATED:
        replacement = _MEDAKA_DEPRECATED[raw]
        print(
            f"[medaka_model] WARNING: model '{raw}' is deprecated in medaka v2.0 "
            f"and has been automatically replaced with '{replacement}'.\n"
            f"  Update 'medaka_model' in config_longread.yaml to silence this warning.",
            flush=True,
        )
        return replacement

    return raw


