rule nanostat_raw:
    """Run NanoStat on raw reads to gather QC metrics before any filtering."""
    input:
        reads = config["reads"]["raw"]
    output:
        report = f"{NANOSTAT_DIR}/{{sample}}/raw_nanostat.txt"
    threads: THREADS
    shell:
        """
        set -euo pipefail
        mkdir -p {NANOSTAT_DIR}/{wildcards.sample}
        {NANOSTAT} \
          --fastq {input.reads} \
          --threads {threads} \
          > {output.report}
        """

rule nanoq_adaptive:
    """
    Adaptive quality filter.
    TIER 0 (PASS)     mean_Q>=10 AND median_len>=5000 → no filtering
    TIER 1 (LIGHT)    mean_Q>=8  AND median_len>=2000 → --min-qual 8 --min-len 2000
    TIER 2 (MODERATE) otherwise                       → --min-qual 7 --min-len 1000
    """
    input:
        reads  = config["reads"]["raw"],
        report = f"{NANOSTAT_DIR}/{{sample}}/raw_nanostat.txt"
    output:
        reads   = f"{NANOQ_DIR}/{{sample}}/filtered.fastq.gz",
        summary = f"{NANOQ_DIR}/{{sample}}/nanoq_summary.txt"
    threads: THREADS
    run:
        import gzip, re, shutil

        mean_q     = None
        median_len = None
        with open(input.report) as fh:
            for line in fh:
                m = re.search(r"Mean[\s_]read[\s_]quality[:\s]+([\d.]+)", line, re.IGNORECASE)
                if m:
                    mean_q = float(m.group(1))
                m = re.search(r"Median[\s_]read[\s_]length[:\s]+([\d,]+)", line, re.IGNORECASE)
                if m:
                    median_len = float(m.group(1).replace(",", ""))

        if mean_q is None or median_len is None:
            raise RuntimeError(
                f"[nanoq_adaptive] Could not parse NanoStat output: {input.report}\n"
                f"  Parsed mean_q={mean_q}, median_len={median_len}"
            )

        if mean_q >= 10 and median_len >= 5000:
            tier, min_qual, min_len = 0, None, None
            tier_name = "PASS (no filtering applied)"
        elif mean_q >= 8 and median_len >= 2000:
            tier, min_qual, min_len = 1, 8, 2000
            tier_name = "LIGHT (--min-qual 8 --min-len 2000)"
        else:
            tier, min_qual, min_len = 2, 7, 1000
            tier_name = "MODERATE (--min-qual 7 --min-len 1000)"

        os.makedirs(f"{NANOQ_DIR}/{wildcards.sample}", exist_ok=True)
        with open(output.summary, "w") as sw:
            sw.write(f"Sample:           {wildcards.sample}\n")
            sw.write(f"Raw mean Q:       {mean_q:.2f}\n")
            sw.write(f"Raw median len:   {median_len:.0f}\n")
            sw.write(f"Filter tier:      {tier} — {tier_name}\n")

        if tier == 0:
            # The declared output is always gzip-compressed. Copying an
            # uncompressed input to a .gz path breaks downstream readers.
            with open(input.reads, "rb") as src:
                is_gzip = src.read(2) == b"\x1f\x8b"
            if is_gzip:
                shutil.copy2(input.reads, output.reads)
            else:
                with open(input.reads, "rb") as src, gzip.open(output.reads, "wb") as dst:
                    shutil.copyfileobj(src, dst)
        else:
            shell(
                f"{NANOQ} "
                f"--input {input.reads} "
                f"--output {output.reads} "
                f"--min-qual {min_qual} "
                f"--min-len {min_len} "
                f"--report {NANOQ_DIR}/{wildcards.sample}/nanoq_report.json "
                f"--stats "
            )
        print(f"[nanoq_adaptive] Tier {tier}: {tier_name}")


rule nanostat_filtered:
    """Run NanoStat on nanoq-filtered reads to record post-filter QC metrics."""
    input:
        reads = f"{NANOQ_DIR}/{{sample}}/filtered.fastq.gz"
    output:
        report = f"{NANOSTAT_DIR}/{{sample}}/filtered_nanostat.txt"
    threads: THREADS
    shell:
        """
        set -euo pipefail
        mkdir -p {NANOSTAT_DIR}/{wildcards.sample}
        {NANOSTAT} \
          --fastq {input.reads} \
          --threads {threads} \
          > {output.report}
        test -s {output.report}
        """


rule host_removal:
    """Remove host reads with Minimap2. Pass-through if no HOST_REF is set."""
    input:
        reads = f"{NANOQ_DIR}/{{sample}}/filtered.fastq.gz",
        postfilter_qc = f"{NANOSTAT_DIR}/{{sample}}/filtered_nanostat.txt"
    output:
        decontam = f"{HOST_DIR}/{{sample}}/decontam.fastq.gz",
        stats    = f"{HOST_DIR}/{{sample}}/seqkit_stats.txt"
    threads: THREADS
    run:
        import os
        os.makedirs(f"{HOST_DIR}/{wildcards.sample}", exist_ok=True)

        if HOST_REF and os.path.exists(HOST_REF):
            shell(
                f"set -euo pipefail\n"
                f"{MINIMAP2} -ax {MM2_PRESET} -t {threads} {HOST_REF} {input.reads} "
                f"| {SAMTOOLS} view -b -f 4 "
                f"| {SAMTOOLS} fastq - "
                f"| gzip > {output.decontam}"
            )
        else:
            shell(f"cp {input.reads} {output.decontam}")

        shell(
            f"set -euo pipefail\n"
            f"{SEQKIT} stats -a {output.decontam} > {output.stats}"
        )


