# STEP 8 — MAG QUALITY CHECK
# =============================================================================

rule checkm2:
    input:
        bins = f"{DAS_DIR}/{{sample}}_DASTool_bins_clean"

    output:
        report = f"{CHECKM_DIR}/{{sample}}/quality_report.tsv"

    threads: THREADS

    shell:
        r"""
        set -euo pipefail

        mkdir -p {CHECKM_DIR}/{wildcards.sample}

        export PATH={CHECKM2_ENV}:{PROKKA_ENV}:$PATH

        # ── Safe MAG counting ─────────────────────────────────────────────
        bin_count=$(find {input.bins} -maxdepth 1 -name "*.fa" | wc -l | tr -d '[:space:]')
        bin_count="${{bin_count:-0}}"

        echo "[checkm2] Found $bin_count MAG bin(s)"

        # ── If no bins exist, create empty report and exit cleanly ───────
        if [ "$bin_count" -eq 0 ]; then
            echo -e "Name\tCompleteness\tContamination" > {output.report}
            echo "[checkm2] No bins found — writing empty report."
            exit 0
        fi

        # ── Run CheckM2 ───────────────────────────────────────────────────
        {CHECKM2} predict \
          --input {input.bins} \
          --output-directory {CHECKM_DIR}/{wildcards.sample} \
          --threads {threads} \
          -x fa \
          --force \
          --database_path {CHECKM2_DB}
        """

rule busco:
    input:
        bins = f"{DAS_DIR}/{{sample}}_DASTool_bins_clean"
    output:
        done = f"{BUSCO_DIR}/{{sample}}/busco.done"
    threads: THREADS
    shell:
        r"""
        set -euo pipefail
        mkdir -p {BUSCO_DIR}/{wildcards.sample}
        export PATH={BUSCO_ENV}:$PATH
        for fa in {input.bins}/*.fa; do
          [ -f "$fa" ] || continue
          mag=$(basename "$fa" .fa)
          echo "[BUSCO] Processing $mag"
          {BUSCO_BIN} \
            -i "$fa" \
            -o "$mag" \
            --out_path {BUSCO_DIR}/{wildcards.sample} \
            -m genome \
            -l {BUSCO_LINEAGE} \
            --offline \
            -c {threads} \
            --force
        done
        touch {output.done}
        """

rule quast_per_mag:
    # DESIGN NOTE: QUAST runs on ALL DAS_Tool bins (pre-filter), because
    # quast_per_mag_all -> merge_mag_qc -> mag_filter forms an upstream chain.
    # Pointing this rule at FILTERED_DIR would create a DAG cycle.
    # The QUAST stats are used as QC INPUT to decide which MAGs to keep.
    input:
        fasta = f"{DAS_DIR}/{{sample}}_DASTool_bins_clean/{{mag}}.fa"
    output:
        tsv   = f"{MAGQC_DIR}/{{sample}}/{{mag}}/report.tsv"
    shell:
        """
        set -euo pipefail
        mkdir -p {MAGQC_DIR}/{wildcards.sample}/{wildcards.mag}
        export PATH={QUAST_ENV}:$PATH
        {QUAST_BIN} {input.fasta} \
          -o {MAGQC_DIR}/{wildcards.sample}/{wildcards.mag} \
          --no-html --no-plots \
          --min-contig 0
        if [ ! -f {output.tsv} ]; then
            printf "Assembly\t{wildcards.mag}\n" > {output.tsv}
        fi
        """

rule quast_per_mag_all:
    # Uses get_mags (DAS_Tool bins, resolved at DAG time) — NOT get_filtered_mags.
    # This rule feeds merge_mag_qc which feeds mag_filter; it must NOT depend
    # on the mag_filter checkpoint or a cycle results.
    input:
        bins_done = f"{DAS_DIR}/{{sample}}_DASTool_bins_clean.done",
        per_mag   = lambda wildcards: expand(
            f"{MAGQC_DIR}/{{sample}}/{{mag}}/report.tsv",
            sample=wildcards.sample,
            mag=get_mags(wildcards)
        )
    output:
        done = f"{MAGQC_DIR}/{{sample}}/mag_quast.done"
    shell:
        "touch {output.done}"

rule merge_mag_qc:
    input:
        checkm2 = f"{CHECKM_DIR}/{{sample}}/quality_report.tsv",
        busco   = f"{BUSCO_DIR}/{{sample}}/busco.done",
        mag_qc  = f"{MAGQC_DIR}/{{sample}}/mag_quast.done"
    output:
        summary = f"{MERGED_QC}/{{sample}}/combined_quality_summary.tsv"
    params:
        busco_dir = f"{BUSCO_DIR}/{{sample}}",
        magqc_dir = f"{MAGQC_DIR}/{{sample}}"
    run:
        import pandas as pd
        import os, re, glob as _glob

        ckm = pd.read_csv(input.checkm2, sep="\t")
        if ckm.empty:
            os.makedirs(os.path.dirname(output.summary), exist_ok=True)
            pd.DataFrame(columns=[
                "MAG", "checkm2_completeness", "checkm2_contamination",
                "busco_complete", "busco_single", "busco_duplicated",
                "quast_N50", "quast_total_length", "quast_num_contigs",
                "quast_GC_pct", "MIMAG_tier"
            ]).to_csv(output.summary, sep="\t", index=False)
            print("[merge_mag_qc] No MAGs to summarise — wrote empty report.")
        else:
            ckm = ckm.rename(columns={
                "Name": "MAG",
                "Completeness": "checkm2_completeness",
                "Contamination": "checkm2_contamination"
            })[["MAG", "checkm2_completeness", "checkm2_contamination"]]

            busco_rows = []
            for summary_file in _glob.glob(
                os.path.join(params.busco_dir, "**", "short_summary*.txt"),
                recursive=True
            ):
                mag = os.path.basename(os.path.dirname(summary_file))
                with open(summary_file) as fh:
                    content = fh.read()
                c_pct = s_pct = d_pct = None
                compact = re.search(
                    r"C:([\d.]+)%\[S:([\d.]+)%,D:([\d.]+)%\]",
                    content,
                )
                if compact:
                    c_pct, s_pct, d_pct = map(float, compact.groups())
                busco_rows.append({
                    "MAG": mag,
                    "busco_complete":   c_pct,
                    "busco_single":     s_pct,
                    "busco_duplicated": d_pct
                })
            bus = pd.DataFrame(busco_rows) if busco_rows else pd.DataFrame(
                columns=["MAG", "busco_complete", "busco_single", "busco_duplicated"])

            qst_rows = []
            for tsv in _glob.glob(os.path.join(params.magqc_dir, "*/report.tsv")):
                mag = os.path.basename(os.path.dirname(tsv))
                df  = pd.read_csv(tsv, sep="\t", header=None, names=["metric", "value"])
                row = {"MAG": mag}
                for _, r in df.iterrows():
                    if "N50" in r["metric"]:
                        row["quast_N50"] = r["value"]
                    elif "Total length" in r["metric"] and ">" not in r["metric"]:
                        row["quast_total_length"] = r["value"]
                    elif "# contigs" in r["metric"] and ">" not in r["metric"]:
                        row["quast_num_contigs"] = r["value"]
                    elif "GC (%)" in r["metric"]:
                        row["quast_GC_pct"] = r["value"]
                qst_rows.append(row)
            qst = pd.DataFrame(qst_rows) if qst_rows else pd.DataFrame(
                columns=["MAG", "quast_N50", "quast_total_length",
                         "quast_num_contigs", "quast_GC_pct"])

            merged = ckm.merge(bus, on="MAG", how="left") \
                        .merge(qst, on="MAG", how="left")

            def mimag_tier(row):
                c_raw = row.get("checkm2_completeness")
                ct_raw = row.get("checkm2_contamination")
                c = float(c_raw) if pd.notna(c_raw) else 0.0
                ct = float(ct_raw) if pd.notna(ct_raw) else 100.0
                if c >= HIGH_COMPLETENESS and ct < HIGH_CONTAMINATION:
                    return "High Quality"
                elif c >= MEDIUM_COMPLETENESS and ct < MEDIUM_CONTAMINATION:
                    return "Medium Quality"
                else:
                    return "Low Quality"

            merged["MIMAG_tier"] = merged.apply(mimag_tier, axis=1)
            os.makedirs(os.path.dirname(output.summary), exist_ok=True)
            merged.to_csv(output.summary, sep="\t", index=False)
            print(f"[merge_mag_qc] Written {len(merged)} MAGs → {output.summary}")

checkpoint mag_filter:
    input:
        summary  = f"{MERGED_QC}/{{sample}}/combined_quality_summary.tsv",
        bins_dir = f"{DAS_DIR}/{{sample}}_DASTool_bins_clean"
    output:
        filtered = directory(f"{FILTERED_DIR}/{{sample}}"),
        rejected = directory(f"{REJECTED_DIR}/{{sample}}"),
        done     = f"{FILTERED_DIR}/{{sample}}.filter.done"
    run:
        import pandas as pd, shutil, os

        os.makedirs(output.filtered, exist_ok=True)
        os.makedirs(output.rejected, exist_ok=True)

        df = pd.read_csv(input.summary, sep="\t")
        log_lines = ["MAG\tAction\tReason"]

        for _, row in df.iterrows():
            mag = row["MAG"]
            src = os.path.join(input.bins_dir, f"{mag}.fa")
            if not os.path.exists(src):
                continue
            reasons = []
            comp_raw = row.get("checkm2_completeness")
            cont_raw = row.get("checkm2_contamination")
            comp = float(comp_raw) if pd.notna(comp_raw) else 0.0
            cont = float(cont_raw) if pd.notna(cont_raw) else 100.0
            if comp < MIN_COMPLETENESS:
                reasons.append(f"completeness={comp:.1f}%<{MIN_COMPLETENESS}%")
            if cont >= MAX_CONTAMINATION:
                reasons.append(f"contamination={cont:.1f}%>={MAX_CONTAMINATION}%")
            if reasons:
                shutil.copy(src, os.path.join(output.rejected, f"{mag}.fa"))
                log_lines.append(f"{mag}\tREJECTED\t{'; '.join(reasons)}")
            else:
                shutil.copy(src, os.path.join(output.filtered, f"{mag}.fa"))
                log_lines.append(f"{mag}\tPASSED\t{row['MIMAG_tier']}")

        with open(os.path.join(output.filtered, "filter_log.tsv"), "w") as fh:
            fh.write("\n".join(log_lines))
        open(output.done, "w").close()
        print(f"[mag_filter] Filter complete. Log: {output.filtered}/filter_log.tsv")


# =============================================================================
# STEP 9 — DEREPLICATION
# =============================================================================

rule drep:
    """
    Dereplication with dRep.

    KEY FIX: dRep by default runs CheckM1 internally to assess genome quality.
    CheckM1 is not installed here (only CheckM2 is). Passing --genomeInfo
    with the CheckM2 results bypasses dRep's internal quality assessment
    entirely — dRep uses the provided completeness/contamination values
    directly without calling checkm at all.

    The --genomeInfo CSV must have columns: genome, completeness, contamination
    (dRep's expected format). We build it from the CheckM2 quality_report.tsv.

    FIXES applied vs previous version:
      - Robust CheckM2 name matching: strips path prefix and .fa suffix so the
        lookup works regardless of how CheckM2 writes the Name column.
      - Correct thread flag: dRep uses --processors, not -p.
      - makedirs for output.derep called BEFORE subprocess so the output
        directory always exists when dRep writes into it.
      - Runtime failures are propagated so a failed dereplication cannot be
        reported as a successful, dereplicated result.
      - Stale partial output directory is removed before re-running dRep to
        prevent dRep from complaining about an existing work directory.
    """
    input:
        bins    = f"{FILTERED_DIR}/{{sample}}",
        done    = f"{FILTERED_DIR}/{{sample}}.filter.done",
        checkm2 = f"{CHECKM_DIR}/{{sample}}/quality_report.tsv"
    output:
        derep = directory(f"{DREP_DIR}/{{sample}}/dereplicated_genomes")
    threads: THREADS
    run:
        import subprocess, os as _os, glob as _glob, csv, shutil

        drep_env = {**_os.environ,
                    "PATH": f"{DREP_ENV}:{_os.environ.get('PATH', '')}"}

        bin_fastas = sorted(_glob.glob(f"{input.bins}/*.fa"))

        # ── Edge case: no filtered MAGs ───────────────────────────────────────
        if len(bin_fastas) == 0:
            _os.makedirs(output.derep, exist_ok=True)
            print("[drep] No filtered MAGs — skipping dereplication.", flush=True)
            return

        # ── Edge case: mash unavailable ───────────────────────────────────────
        mash_check = subprocess.run(
            ["bash", "-c", "mash --version"],
            capture_output=True, env=drep_env
        )
        if mash_check.returncode != 0:
            raise RuntimeError("[drep] Required executable 'mash' is missing from drep_env")

        # ── Edge case: only 1 MAG (dRep needs >=2 for clustering) ────────────
        if len(bin_fastas) == 1:
            print("[drep] Only 1 filtered MAG — skipping dRep, copying directly.", flush=True)
            _os.makedirs(output.derep, exist_ok=True)
            shutil.copy(bin_fastas[0], _os.path.join(output.derep, _os.path.basename(bin_fastas[0])))
            return

        # ── Build --genomeInfo CSV from CheckM2 output ────────────────────────
        # CheckM2's Name column may be a full path, a stem, or stem+extension.
        # Normalise to bare stem so we can match against FASTA basenames.
        drep_work = f"{DREP_DIR}/{wildcards.sample}"
        if _os.path.isdir(_os.path.join(drep_work, "log")):
            shutil.rmtree(drep_work)
            print(f"[drep] Removed stale work directory: {drep_work}", flush=True)
        _os.makedirs(drep_work, exist_ok=True)
        _os.makedirs(output.derep, exist_ok=True)
        genome_info_path = _os.path.join(drep_work, "genome_info.csv")

        checkm2_data = {}   # stem (no .fa) → (completeness, contamination)
        try:
            import pandas as _pd
            ckm = _pd.read_csv(input.checkm2, sep="\t")
            for _, row in ckm.iterrows():
                raw_name = str(row.get("Name", "")).strip()
                if not raw_name:
                    continue
                # Strip any leading path components, then strip .fa / .fasta suffix
                stem = _os.path.splitext(_os.path.basename(raw_name))[0]
                comp_raw = row.get("Completeness")
                cont_raw = row.get("Contamination")
                comp = float(comp_raw) if _pd.notna(comp_raw) else 0.0
                cont = float(cont_raw) if _pd.notna(cont_raw) else 0.0
                checkm2_data[stem] = (comp, cont)
            print(f"[drep] Parsed CheckM2 data for {len(checkm2_data)} genome(s).", flush=True)
        except Exception as e:
            print(f"[drep] WARNING: Could not parse CheckM2 report ({e}) — "
                  f"using default quality values (comp=50, cont=5) for all MAGs.", flush=True)

        unmatched = []
        with open(genome_info_path, "w", newline="") as gh:
            writer = csv.writer(gh)
            writer.writerow(["genome", "completeness", "contamination"])
            for fa in bin_fastas:
                basename = _os.path.basename(fa)           # e.g. bin.1.fa
                stem     = _os.path.splitext(basename)[0]  # e.g. bin.1
                if stem in checkm2_data:
                    comp, cont = checkm2_data[stem]
                else:
                    comp, cont = 50.0, 5.0
                    unmatched.append(basename)
                writer.writerow([basename, comp, cont])

        if unmatched:
            print(f"[drep] WARNING: {len(unmatched)} MAG(s) not found in CheckM2 report "
                  f"— using defaults (comp=50, cont=5): {unmatched}", flush=True)
        print(f"[drep] genome_info written → {genome_info_path}", flush=True)

        # ── Run dRep ──────────────────────────────────────────────────────────
        # NOTE: dRep uses --processors (not -p) for thread count.
        def _avail(binary):
            return subprocess.run(
                ["bash", "-c", f"command -v {binary}"],
                capture_output=True, env=drep_env,
            ).returncode == 0

        if _avail("skani"):
            s_algo = "skani"
        elif _avail("fastANI"):
            s_algo = "fastANI"
        else:
            s_algo = "ANImf"
        print(f"[drep] Using S_algorithm: {s_algo}", flush=True)

        cmd = [
            DREP_BIN, "dereplicate",
            drep_work,
            "--genomeInfo", genome_info_path,
            "-pa", str(DREP_PRIMARY_ANI),
            "-sa", str(DREP_SECONDARY_ANI),
            "-nc", str(DREP_ALIGNED_FRACTION),
            "-comp", str(DREP_MIN_COMPLETENESS),
            "-con", str(DREP_MAX_CONTAMINATION),
            "--S_algorithm", s_algo,
            "--processors", str(threads),
        ] + ["-g"] + bin_fastas

        print(f"[drep] Running: {' '.join(cmd)}", flush=True)
        subprocess.run(cmd, check=True, env=drep_env)
        print(f"[drep] Finished. Dereplicated genomes in: {output.derep}", flush=True)


# =============================================================================
# STEP 10 — TAXONOMIC CLASSIFICATION
# =============================================================================

rule gtdbtk:
    input:
        bins = f"{FILTERED_DIR}/{{sample}}",
        done = f"{FILTERED_DIR}/{{sample}}.filter.done"
    output:
        bac  = f"{GTDB_DIR}/{{sample}}/gtdbtk.bac120.summary.tsv",
        ar   = f"{GTDB_DIR}/{{sample}}/gtdbtk.ar53.summary.tsv"
    threads: THREADS
    shell:
        """
        set -euo pipefail
        mkdir -p {GTDB_DIR}/{wildcards.sample}
        export PATH={GTDBTK_ENV}:$PATH
        export GTDBTK_DATA_PATH={GTDBTK_DB}

        bin_count=$(find {input.bins} -maxdepth 1 -name "*.fa" | wc -l | tr -d '[:space:]')
        bin_count="${{bin_count:-0}}"
