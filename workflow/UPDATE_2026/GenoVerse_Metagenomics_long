rule flye_assembly:
    """De-novo long-read metagenome assembly with Flye --meta."""
    input:
        reads = f"{HOST_DIR}/{{sample}}/decontam.fastq.gz"
    output:
        fasta = f"{ASSEMBLY_DIR}/{{sample}}_flye/assembly.fasta",
        info  = f"{ASSEMBLY_DIR}/{{sample}}_flye/assembly_info.txt"
    threads: THREADS
    shell:
        r"""
        set -euo pipefail
        export PATH={METAFLYE_ENV}:$PATH
        mkdir -p {ASSEMBLY_DIR}
        WORKDIR={ASSEMBLY_DIR}/{wildcards.sample}_flye

        case "{READ_TYPE}" in
          ont)         READ_FLAG="--nano-hq"    ;;
          pacbio-raw)  READ_FLAG="--pacbio-raw"  ;;
          pacbio-hifi) READ_FLAG="--pacbio-hifi" ;;
          *)           READ_FLAG="--nano-hq"    ;;
        esac

        env PATH={METAFLYE_ENV}:$PATH \
        {FLYE} \
          $READ_FLAG {input.reads} \
          --out-dir $WORKDIR \
          --threads {threads} \
          --meta
        """

rule medaka_polish:
    """
    Polish Flye contigs with Medaka (ONT only).
    For PacBio read types this rule is skipped: the output FASTA is created
    as a symlink to the raw Flye assembly so downstream rules resolve correctly.
    Defining the rule unconditionally avoids Snakemake indentation-parse errors
    that arise when rules are nested inside Python if-blocks.
    """
    input:
        draft = f"{ASSEMBLY_DIR}/{{sample}}_flye/assembly.fasta",
        reads = f"{HOST_DIR}/{{sample}}/decontam.fastq.gz"
    output:
        fasta = f"{MEDAKA_DIR}/{{sample}}/consensus.fasta"
    threads: MEDAKA_THREADS
    params:
        model    = medaka_model() if READ_TYPE == "ont" else "skip",
        read_type = READ_TYPE
    shell:
        r"""
        set -euo pipefail
        export PATH={MEDAKA_ENV}:{METAFLYE_ENV}:$PATH
        MEDAKA_OUTDIR={MEDAKA_DIR}/{wildcards.sample}
        mkdir -p $MEDAKA_OUTDIR

        if [ "{params.read_type}" != "ont" ]; then
            echo "[medaka_polish] Non-ONT read type '{params.read_type}' — symlinking Flye assembly." >&2
            ln -sf "$(realpath {input.draft})" {output.fasta}
            exit 0
        fi

        LOCAL_DRAFT=$(mktemp /tmp/medaka_draft_XXXXXX.fasta)
        trap "rm -f $LOCAL_DRAFT ${{LOCAL_DRAFT}}.fai" EXIT
        cp {input.draft} $LOCAL_DRAFT
        samtools faidx $LOCAL_DRAFT
        echo "[medaka_polish] Draft copied to local scratch: $LOCAL_DRAFT"

        {MEDAKA} \
          -i {input.reads} \
          -d $LOCAL_DRAFT \
          -o $MEDAKA_OUTDIR \
          -m {params.model} \
          -t {threads}

        if [ ! -f {output.fasta} ]; then
            echo "[medaka_polish] ERROR: {output.fasta} not found." >&2
            ls -lh $MEDAKA_OUTDIR >&2
            exit 1
        fi
        echo "[medaka_polish] SUCCESS: consensus.fasta written."
        """

rule quast:
    input:
        contigs = assembly_fasta
    output:
        html = f"{QUAST_DIR}/{{sample}}/report.html"
    threads: THREADS
    shell:
        """
        set -euo pipefail
        mkdir -p {QUAST_DIR}/{wildcards.sample}
        {QUAST} {input.contigs} \
          -o {QUAST_DIR}/{wildcards.sample} \
          -t {threads} \
          --min-contig 500
        """


