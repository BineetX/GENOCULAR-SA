rule metabat_depth:
    input:
        bam = f"{MAP_DIR}/{{sample}}_filtered.sorted.bam"
    output:
        depth = f"{MAP_DIR}/metabat/{{sample}}_filtered_depth.txt"
    threads: THREADS
    shell:
        """
        set -euo pipefail
        mkdir -p {MAP_DIR}/metabat
        {JGI} \
          --outputDepth {output.depth} \
          {input.bam}
        """
        
rule metabat2:
    """
    MetaBAT2 binning on coverage-filtered contigs.

    Fixes applied:
      1. Safe integer extraction from grep -c (strips whitespace/multi-line).
      2. Python heredoc uses PYEOF (unquoted) so $TMPFA expands correctly,
         OR replaced with a python3 -c one-liner to avoid heredoc quoting entirely.
      3. Depth file column-count validated before calling MetaBAT2.
      4. || true on MetaBAT2 so exit 1 (no bins found) is non-fatal.
    """
    input:
        contigs = assembly_fasta_filtered,
        depth = f"{MAP_DIR}/metabat/{{sample}}_filtered_depth.txt"
    output:
        bins = directory(f"{BIN_DIR}/{{sample}}/metabat2"),
        done = f"{BIN_DIR}/{{sample}}/metabat2.done"
    threads: THREADS
    shell:
        r"""
        set -euo pipefail
        mkdir -p {output.bins}
        export PATH={BINNING_ENV}:$PATH

        # ── Pre-check: count contigs (safe — strips whitespace from grep -c) ──
        eligible=$(grep -c "^>" {input.contigs} 2>/dev/null | tr -d '[:space:]' || echo 0)
        eligible="${{eligible:-0}}"
        if [ "$eligible" -eq 0 ]; then
            echo "[metabat2] WARNING: Filtered FASTA is empty. Skipping MetaBAT2." >&2
            echo "[metabat2] Produced 0 bin(s) — no eligible contigs."
            touch {output.done}
            exit 0
        fi

        # ── Validate depth file has even number of data columns ───────────────
        depth_cols=$(awk 'NR==2{{print NF-1}}' {input.depth} 2>/dev/null || echo 0)
        depth_cols="${{depth_cols:-0}}"
        if [ "$depth_cols" -eq 0 ] || [ $(( depth_cols % 2 )) -ne 0 ]; then
            echo "[metabat2] WARNING: Depth file has $depth_cols data column(s) — must be even. Skipping MetaBAT2." >&2
            touch {output.done}
            exit 0
        fi

        # ── Filter to >=1500 bp in a temp file (MetaBAT2 hard requirement) ───
        TMPFA=$(mktemp /tmp/metabat2_input_XXXXXX.fasta)
        trap "rm -f $TMPFA" EXIT

        # BUG FIX: use python3 -c with shell variable passed as argument
        # (heredoc with 'PYEOF' prevents $TMPFA from expanding inside Python)
        cat > /tmp/metabat2_filter_$$.py << 'SCRIPTEOF'
import sys
in_fa, out_fa = sys.argv[1], sys.argv[2]
out = []
hdr = None
seq_buf = []
with open(in_fa) as fh:
    for line in fh:
        line = line.rstrip()
        if line.startswith(">"):
            if hdr and len("".join(seq_buf)) >= 1500:
                out.append(hdr)
                out.extend(seq_buf)
            hdr = line
            seq_buf = []
        else:
            seq_buf.append(line)
    if hdr and len("".join(seq_buf)) >= 1500:
        out.append(hdr)
        out.extend(seq_buf)
print("[metabat2_prefilter] filtering complete", flush=True)
with open(out_fa, "w") as fout:
    fout.write("\n".join(out) + "\n")
SCRIPTEOF
        python3 /tmp/metabat2_filter_$$.py "{input.contigs}" "$TMPFA"
        rm -f /tmp/metabat2_filter_$$.py

        # ── Check if any contigs survived the 1500 bp filter ─────────────────
        kept_count=$(grep -c "^>" "$TMPFA" 2>/dev/null | tr -d '[:space:]' || echo 0)
        kept_count="${{kept_count:-0}}"
        if [ "$kept_count" -eq 0 ]; then
            echo "[metabat2] WARNING: No contigs >=1500 bp found after pre-filtering." >&2
            echo "[metabat2] Produced 0 bin(s) — skipping MetaBAT2."
            touch {output.done}
            exit 0
        fi

        echo "[metabat2] $kept_count contig(s) >=1500 bp passed pre-filter."

        # ── Run MetaBAT2 ──────────────────────────────────────────────────────
        {METABAT2} \
          -i "$TMPFA" \
          -a {input.depth} \
          -o {output.bins}/{wildcards.sample}_bin \
          -t {threads} \
          -m 1500 || true

        bin_count=$(ls {output.bins}/*.fa 2>/dev/null | wc -l | tr -d '[:space:]' || echo 0)
        echo "[metabat2] Produced ${{bin_count:-0}} bin(s) in {output.bins}"
        touch {output.done}
        """

# ── STEP 6B: SemiBin2 ────────────────────────────────────────────────────────
rule semibin2:
    """
    SemiBin2 binning on coverage-filtered contigs.
    Tries --self-supervised first; falls back to --environment global if
    self-supervised produces zero bins (common on sparse data).
    """
    input:
        contigs = assembly_fasta_filtered,
        bam     = f"{MAP_DIR}/{{sample}}_filtered.sorted.bam"
    output:
        bins = directory(f"{BIN_DIR}/{{sample}}/semibin2/output_bins"),
        done = f"{BIN_DIR}/{{sample}}/semibin2.done"
    threads: THREADS
    run:
        import subprocess, os as _os, glob as _glob

        semibin_outdir = f"{BIN_DIR}/{wildcards.sample}/semibin2"
        _os.makedirs(semibin_outdir, exist_ok=True)

        # ── Pre-check: skip SemiBin2 entirely if no contigs ──────────────────
        contig_count = 0
        try:
            with open(input.contigs) as fh:
                contig_count = sum(1 for l in fh if l.startswith(">"))
        except Exception:
            pass

        if contig_count == 0:
            print(
                "[semibin2] WARNING: Filtered FASTA is empty. Skipping SemiBin2.",
                flush=True
            )
            _os.makedirs(output.bins, exist_ok=True)
            open(output.done, "w").close()
        else:
            def run_semibin(mode_flag):
                cmd = (
                    f"set -euo pipefail\n"
                    f"export PATH={BINNING_ENV}:$PATH\n"
                    f"{SEMIBIN2} single_easy_bin "
                    f"  -i {input.contigs} "
                    f"  -b {input.bam} "
                    f"  -o {semibin_outdir} "
                    f"  --threads {threads} "
                    f"  --min-len {SEMIBIN_MIN_LEN} "
                    f"  --sequencing-type long_read "
                    f"  {mode_flag}"
                )
                result = subprocess.run(["bash", "-c", cmd])
                return result.returncode

            rc = run_semibin("--self-supervised")
            bins_found = _glob.glob(f"{semibin_outdir}/output_bins/*.fa") + \
                         _glob.glob(f"{semibin_outdir}/output_bins/*.fasta")

            if rc != 0 or len(bins_found) == 0:
                print(
                    "[semibin2] --self-supervised produced zero bins or failed. "
                    f"Retrying with --environment {SEMIBIN_ENVIRONMENT} (SemiBin2 >= 2.0 preset).",
                    flush=True
                )
                import shutil
                if _os.path.exists(semibin_outdir):
                    shutil.rmtree(semibin_outdir)
                _os.makedirs(semibin_outdir, exist_ok=True)
                rc2 = run_semibin(f"--environment {SEMIBIN_ENVIRONMENT}")
                bins_found = _glob.glob(f"{semibin_outdir}/output_bins/*.fa") + \
                             _glob.glob(f"{semibin_outdir}/output_bins/*.fasta")
                if rc2 != 0 and len(bins_found) == 0:
                    print(
                        "[semibin2] WARNING: Both --self-supervised and --environment global "
                        "produced zero bins. SemiBin2 output will be empty for this sample.",
                        flush=True
                    )

            _os.makedirs(output.bins, exist_ok=True)
            print(f"[semibin2] Produced {len(bins_found)} bin(s) in {output.bins}", flush=True)
            open(output.done, "w").close()


# ── Convert MetaBAT2 bins → DAS_Tool contig2bin TSV ─────────────────────────
rule metabat2_to_contig2bin:
    input:
        done = f"{BIN_DIR}/{{sample}}/metabat2.done",
        bins = f"{BIN_DIR}/{{sample}}/metabat2"
    output:
        tsv  = f"{BIN_DIR}/{{sample}}/metabat2_contig2bin.tsv"
    run:
        import glob as _glob
        rows = []
        for fa in _glob.glob(f"{input.bins}/*.fa"):
            bin_id = os.path.splitext(os.path.basename(fa))[0]
            with open(fa) as fh:
                for line in fh:
                    if line.startswith(">"):
                        ctg = line[1:].strip().split()[0]
                        rows.append(f"{ctg}\t{bin_id}")
        with open(output.tsv, "w") as out:
            out.write("contig\tbin_id\n")
            if rows:
                out.write("\n".join(rows) + "\n")
        print(f"[metabat2_to_contig2bin] Wrote {len(rows)} contig mappings → {output.tsv}")

# ── Convert SemiBin2 bins → DAS_Tool contig2bin TSV ─────────────────────────
rule semibin2_to_contig2bin:
    input:
        bins = f"{BIN_DIR}/{{sample}}/semibin2/output_bins",
        done = f"{BIN_DIR}/{{sample}}/semibin2.done"
    output:
        tsv  = f"{BIN_DIR}/{{sample}}/semibin2_contig2bin.tsv"
    run:
        import glob as _glob
        import gzip
        import os

        rows = []

        for fa in _glob.glob(f"{input.bins}/*.fa") + \
                  _glob.glob(f"{input.bins}/*.fasta") + \
                  _glob.glob(f"{input.bins}/*.fa.gz"):

            bin_id = os.path.splitext(os.path.basename(fa))[0]

            if fa.endswith(".gz"):
                fh = gzip.open(fa, "rt")
            else:
                fh = open(fa)

            with fh:
                for line in fh:
                    if line.startswith(">"):
                        ctg = line[1:].strip().split()[0]
                        rows.append(f"{ctg}\t{bin_id}")

        with open(output.tsv, "w") as out:
            out.write("contig\tbin_id\n")
            if rows:
                out.write("\n".join(rows) + "\n")

        print(f"[semibin2_to_contig2bin] Wrote {len(rows)} contig mappings → {output.tsv}")

# =============================================================================
# STEP 7 — BIN REFINEMENT (DAS_Tool)
# =============================================================================

rule dastool:
    """
    Bin refinement with DAS_Tool.
    Shell rule mirrors the working SLURM script exactly:
      - tail -n +2 to strip headers (same as manual script)
      - DAS_Tool called with PATH set so all R libs are found
      - output.bins declared as the actual directory DAS_Tool creates
    """
    input:
        metabat = f"{BIN_DIR}/{{sample}}/metabat2_contig2bin.tsv",
        semibin = f"{BIN_DIR}/{{sample}}/semibin2_contig2bin.tsv",
        contigs = assembly_fasta
    output:
        bins = directory(f"{DAS_DIR}/{{sample}}_DASTool_DASTool_bins"),
        done = f"{DAS_DIR}/{{sample}}.dastool.done"
    threads: THREADS
    shell:
        r"""
        set -euo pipefail
        export PATH={BINNING_ENV}:$PATH

        BINDIR="{BIN_DIR}/{wildcards.sample}"
        OUTDIR="{DAS_DIR}"
        PREFIX="{DAS_DIR}/{wildcards.sample}_DASTool"

        mkdir -p "$OUTDIR"

        # ── Strip header rows (tail -n +2) — exactly as in working SLURM script ──
        MB_TSV="$BINDIR/metabat2_contig2bin.tsv"
        SB_TSV="$BINDIR/semibin2_contig2bin.tsv"
        MB_CLEAN="$BINDIR/metabat2_contig2bin.clean.tsv"
        SB_CLEAN="$BINDIR/semibin2_contig2bin.clean.tsv"

        mb_rows=0
        sb_rows=0

        if [ -s "$MB_TSV" ]; then
            tail -n +2 "$MB_TSV" > "$MB_CLEAN"
            mb_rows=$(wc -l < "$MB_CLEAN" | tr -d '[:space:]')
        fi
        if [ -s "$SB_TSV" ]; then
            tail -n +2 "$SB_TSV" > "$SB_CLEAN"
            sb_rows=$(wc -l < "$SB_CLEAN" | tr -d '[:space:]')
        fi

        echo "[dastool] MetaBAT2 rows: ${{mb_rows:-0}}, SemiBin2 rows: ${{sb_rows:-0}}"

        # ── Build -i and -l arguments from whichever binners have data ───────
        INPUT_TSVS=""
        LABELS=""

        if [ "${{mb_rows:-0}}" -gt 0 ] && [ "${{sb_rows:-0}}" -gt 0 ]; then
            INPUT_TSVS="$MB_CLEAN,$SB_CLEAN"
            LABELS="metabat2,semibin2"
        elif [ "${{mb_rows:-0}}" -gt 0 ]; then
            INPUT_TSVS="$MB_CLEAN"
            LABELS="metabat2"
        elif [ "${{sb_rows:-0}}" -gt 0 ]; then
            INPUT_TSVS="$SB_CLEAN"
            LABELS="semibin2"
        else
            echo "[dastool] WARNING: Both binners produced zero bins — skipping DAS_Tool." >&2
            mkdir -p "{output.bins}"
            touch "{output.done}"
            exit 0
        fi

        echo "[dastool] Running DAS_Tool with prefix: $PREFIX"

        # ── Run DAS_Tool — identical to working SLURM script ─────────────────
        DAS_Tool             -i "$INPUT_TSVS"             -l "$LABELS"             -c "{input.contigs}"             -o "$PREFIX"             --write_bins             --threads {threads}

        echo "[dastool] DAS_Tool finished at $(date)"

        # ── Safety: create output.bins if DAS_Tool produced 0 refined bins ───
        mkdir -p "{output.bins}"

        bc=$(find "{output.bins}" -maxdepth 1 -name "*.fa" | wc -l | tr -d '[:space:]')
        echo "[dastool] Produced ${{bc:-0}} refined bin(s) in {output.bins}"

        touch "{output.done}"
        """

# =============================================================================
# CLEAN DAS TOOL OUTPUT
# =============================================================================

checkpoint select_dastool_bins:
    """
    Copy DAS_Tool refined bins to a clean directory.
    Handles .fa.fa double-extension produced when SemiBin2 bins (SemiBin_N.fa)
    pass through DAS_Tool --write_bins, which appends another .fa extension.
    All files are normalised to a single .fa name in the output directory.
    Skips *_sub.fa files (DAS_Tool internal subscaffold artefacts).
    """
    input:
        bins_dir = f"{DAS_DIR}/{{sample}}_DASTool_DASTool_bins",
        done     = f"{DAS_DIR}/{{sample}}.dastool.done"
    output:
        bins = directory(f"{DAS_DIR}/{{sample}}_DASTool_bins_clean"),
        done = f"{DAS_DIR}/{{sample}}_DASTool_bins_clean.done"
    shell:
        r"""
        set -euo pipefail
        mkdir -p {output.bins}
        shopt -s nullglob

        copied=0

        # Collect .fa and .fa.fa — DAS_Tool writes SemiBin_N.fa.fa
        # when SemiBin2 bins named SemiBin_N.fa pass through --write_bins
        for f in {input.bins_dir}/*.fa {input.bins_dir}/*.fa.fa; do
            [ -f "$f" ] || continue

            filename=$(basename "$f")

            # Normalise to single .fa extension
            case "$filename" in
                *.fa.fa) clean_name="${{filename%.fa.fa}}.fa" ;;
                *.fa)    clean_name="$filename" ;;
                *)       continue ;;
            esac

            # Skip DAS_Tool subscaffold artefacts
            case "${{clean_name%.fa}}" in
                *_sub) continue ;;
            esac

            cp "$f" "{output.bins}/$clean_name"
            copied=$(( copied + 1 ))
        done

        echo "[select_dastool_bins] Copied $copied bin(s) to {output.bins}"

        bin_count=$(find {output.bins} -maxdepth 1 -name "*.fa" \
            | wc -l | tr -d "[:space:]")
        bin_count="${{bin_count:-0}}"
        echo "[select_dastool_bins] Retained $bin_count final MAG bin(s)"

        touch {output.done}
        """

