# Copy to databases.env, then choose one source.
# Recommended for the full database tree: share a Google Drive folder with a
# service-account email and provide the JSON key outside Git.
DB_SOURCE=google-drive-folder
GDRIVE_FOLDER_ID=CHANGE_ME
GDRIVE_SERVICE_ACCOUNT_JSON=./secrets/google-drive-service-account.json
RCLONE_IMAGE=rclone/rclone:1.71.2
RCLONE_TRANSFERS=4
RCLONE_CHECKERS=8

# Alternative for a publicly shared Drive folder (best for smaller trees).
# DB_SOURCE=google-drive-public-folder
# GDRIVE_PUBLIC_FOLDER_URL=https://drive.google.com/drive/folders/CHANGE_ME
# GDOWN_IMAGE=python:3.12-slim

# Alternative: use an already populated directory and set GENOCULAR_DB_ROOT in
# .env to that absolute path. No files are copied in this mode.
# DB_SOURCE=existing
