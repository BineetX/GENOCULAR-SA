# Setup.sh copies this file to .env and replaces SETUP_* values.
COMPOSE_PROJECT_NAME=genocular
TZ=Asia/Kolkata
TENANT_ID=cbb

# Local-network address advertised to browsers. Do not use 0.0.0.0 here.
GENOCULAR_BIND_ADDRESS=0.0.0.0
GENOCULAR_HOST=SETUP_LAN_HOST
GENOCULAR_HTTP_PORT=8080
GENOCULAR_MINIO_CONSOLE_PORT=9001
FRONTEND_URL=http://SETUP_LAN_HOST:8080
MINIO_PUBLIC_ENDPOINT=http://SETUP_LAN_HOST:8080
MINIO_CONSOLE_URL=http://SETUP_LAN_HOST:9001
CORS_ALLOWED_ORIGINS=http://SETUP_LAN_HOST:8080

# Host paths may be absolute or relative to this repository.
GENOCULAR_DATA_ROOT=./data/genocular
GENOCULAR_DB_ROOT=./data/databases
GENOCULAR_TMP_ROOT=./data/tmp
GENOCULAR_SCRATCH_ROOT=./data/scratch
GENOCULAR_JOBQ_ROOT=./data/genocular/jobq
JOB_UID=SETUP_UID
JOB_GID=SETUP_GID

POSTGRES_USER=genocular
POSTGRES_PASSWORD=SETUP_RANDOM_SECRET
POSTGRES_DB=genocular
MINIO_ROOT_USER=genocular
MINIO_ROOT_PASSWORD=SETUP_RANDOM_SECRET
API_SECRET=SETUP_RANDOM_SECRET
JOB_TOKEN_PEPPER=SETUP_RANDOM_SECRET

RAW_BUCKET=raw
RESULTS_BUCKET=results
LOGS_BUCKET=logs
REFS_BUCKET=refs
DEMO_RESULTS_BUCKET=demo-results
RQ_QUEUE=genocular

# Required: public Firebase Web configuration. Enable Email/Password (and
# optionally Google) in Firebase Authentication and authorize GENOCULAR_HOST.
VITE_FIREBASE_API_KEY=CHANGE_ME
VITE_FIREBASE_AUTH_DOMAIN=CHANGE_ME
VITE_FIREBASE_PROJECT_ID=CHANGE_ME
VITE_FIREBASE_APP_ID=CHANGE_ME
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_ADMIN_EMAIL=

# Optional legacy OIDC values.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional email notifications. Leave SMTP_HOST empty to disable delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=true
SMTP_FROM="GENOCULAR <noreply@localhost>"

# Runtime sizing and AI models.
GENOCULAR_ACCELERATOR=cpu
SNAKEMAKE_CORES=8
SNAKEMAKE_GPUS=1
SEMIBIN_ENGINE=cpu
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_MODEL=llama3.2
ANALYSIS_ASSISTANT_MODEL=gemma4:12b
FAILURE_EMAIL_MODEL=gemma4:12b
FAILURE_EMAIL_AI_ENABLED=0
ASSISTANT_RAG_ONLY=0

# Source tag used to build the AGPL MinIO Community server locally.
MINIO_VERSION=RELEASE.2025-10-15T17-29-55Z
# Source tag used to build the MinIO command-line client locally.
MC_VERSION=RELEASE.2025-04-16T18-13-26Z
